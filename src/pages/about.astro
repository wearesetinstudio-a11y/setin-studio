---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AboutHero from '../components/about/AboutHero.astro';
import AboutStudioIntro from '../components/about/AboutStudioIntro.astro';
import AboutTeamMember from '../components/about/AboutTeamMember.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import { getCollection } from 'astro:content';
import { getSiteCounts } from '../utils/getSiteCounts.ts';
import { withPublicAssetVersion } from '../utils/withPublicAssetVersion.ts';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const { projectCount } = await getSiteCounts();

const teamMembers = [
	{
		name: 'Krzysztof Bartosik',
		role: 'Creative & Strategy Director',
		roleKey: 'aboutPage.chrisRole',
		bioKey: 'aboutPage.chrisBio',
		bio: 'Directing strategy and creative vision at Setin Studio. I bridge deep market research with core business objectives to build high-impact brands and digital products. I establish design workflows that eliminate guesswork, delivering scalable, battle-tested solutions that drive measurable growth.',
		imageSrc: '/images/chris.webp',
		imageAlt:
			'Krzysztof Bartosik, Creative & Strategy Director at Setin Studio — branding and UI/UX design leadership',
		links: [
			{ label: 'LinkedIn', href: 'https://www.linkedin.com/in/krzysztof-bartosik-a98855226' },
			{ label: 'Instagram', href: 'https://www.instagram.com/bartosik_k?igsh=emRqd2VqZGNzZWFp' },
		],
	},
	{
		name: 'Jakub Bartosik',
		role: 'Tech Director',
		roleKey: 'aboutPage.kubaRole',
		bioKey: 'aboutPage.kubaBio',
		bio: "Head of technical architecture and engineering at Setin Studio. I ensure the digital infrastructure behind our clients' products operates with absolute precision. I prioritize clean code, raw performance, and modern web standards—keeping platforms fast and resilient as businesses scale.",
		imageSrc: '/images/jacob.webp',
		imageAlt:
			'Jakub Bartosik, Tech Director at Setin Studio — engineering for B2B platforms and digital products',
		links: [
			{ label: 'Instagram', href: 'https://www.instagram.com/tosini13?igsh=MXVxMjhtY3BwaGpkMQ%3D%3D' },
			{ label: 'LinkedIn', href: 'https://www.linkedin.com/in/jakub-bartosik-developer' },
		],
	},
	{
		name: 'Tymoteusz Gunzer',
		role: 'Brand & Graphic Designer',
		roleKey: 'aboutPage.tymonRole',
		bioKey: 'aboutPage.tymonBio',
		bio: 'Crafting and expanding visual identities for brands built to stand out. My work is anchored in sharp strategy and purposeful execution, enabling Setin Studio to build comprehensive visual systems that forge market position rather than just decoration.',
		imageSrc: '/images/tibo.webp',
		imageAlt:
			'Tymoteusz Gunzer, Brand & Graphic Designer at Setin Studio — visual identity and branding systems',
		links: [{ label: 'Instagram', href: 'https://www.instagram.com/gnzr_art/' }],
	},
];
---

<Layout
	title="About Us"
	description="Meet the brothers behind Setin Studio — a digital product studio built on vision and execution."
	preloadImage={withPublicAssetVersion('/images/brothers-intro.webp')}
>
	<Header projectCount={projectCount} />

	<main class="relative z-20 flex-1">
		<AboutHero />
		<AboutStudioIntro />

		<section class="about-team relative z-10 bg-[#0A0A0B] px-[var(--page-gutter)] pt-[60px] pb-[120px] md:pb-[160px]">
			<div class="flex flex-col gap-[120px] md:gap-[160px]">
				{
					teamMembers.map((member, index) => (
						<AboutTeamMember
							name={member.name}
							role={member.role}
							bio={member.bio}
							roleKey={member.roleKey}
							bioKey={member.bioKey}
							imageSrc={member.imageSrc}
							imageAlt={member.imageAlt}
							links={member.links}
							align={index % 2 === 0 ? 'start' : 'end'}
						/>
					))
				}
			</div>
		</section>

		<TestimonialsSection />
	</main>

	<Footer />
</Layout>
