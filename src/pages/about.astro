---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AboutHero from '../components/about/AboutHero.astro';
import AboutStudioIntro from '../components/about/AboutStudioIntro.astro';
import AboutTeamMember from '../components/about/AboutTeamMember.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import { getCollection } from 'astro:content';
import { getSiteCounts } from '../utils/getSiteCounts.ts';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const { projectCount, articleCount } = await getSiteCounts();

const teamMembers = [
	{
		name: 'Chris',
		role: 'Designer & Strategist',
		roleKey: 'aboutPage.chrisRole',
		bioKey: 'aboutPage.chrisBio',
		bio: "I have spent the last 5 years working with brands from different corners of the world, like Panama, Spain, and Poland. My experience ranges from designing visual identities for banks to building modern apps for tech startups. I believe that design is not just about colors; it's about making your business trustworthy and easy for your customers to understand.",
		imageSrc: '/chris.webp',
		imageAlt: 'Chris, Designer and Strategist at Setin Studio',
		links: [
			{ label: 'LinkedIn', href: 'https://www.linkedin.com/in/krzysztof-bartosik-a98855226' },
			{ label: 'Instagram', href: 'https://www.instagram.com/bartosik_k?igsh=emRqd2VqZGNzZWFp' },
		],
	},
	{
		name: 'Kuba',
		role: 'Lead Developer',
		roleKey: 'aboutPage.kubaRole',
		bioKey: 'aboutPage.kubaBio',
		bio: 'With over 10 years in software development, I have seen the web change many times. I\'ve worked with international companies and individual clients from the US and Europe. My job is to make sure that the "engine" of your website is perfect. I focus on clean code and performance, so your site stays fast and reliable, no matter how much your business grows.',
		imageSrc: '/jacob.webp',
		imageAlt: 'Kuba, Lead Developer at Setin Studio',
		links: [
			{ label: 'Instagram', href: 'https://www.instagram.com/tosini13?igsh=MXVxMjhtY3BwaGpkMQ%3D%3D' },
			{ label: 'LinkedIn', href: 'https://www.linkedin.com/in/jakub-bartosik-developer' },
		],
	},
];
---

<Layout
	title="About Us"
	description="Meet the brothers behind Setin Studio — a digital product studio built on vision and execution."
>
	<Header projectCount={projectCount} articleCount={articleCount} />

	<main class="relative z-20 flex-1">
		<AboutHero />
		<AboutStudioIntro />

		<section class="about-team relative z-10 bg-[#131415] px-[var(--page-gutter)] pt-[60px] pb-[120px] md:pb-[160px]">
			<div class="flex flex-col gap-[120px] md:gap-[160px]">
				{
					teamMembers.map((member, index) => (
						<AboutTeamMember
							name={member.name}
							role={member.role}
							bio={member.bio}
							roleKey={member.roleKey}
							bioKey={member.bioKey}
							imageSrc={member.imageSrc}
							imageAlt={member.imageAlt}
							links={member.links}
							align={index === 0 ? 'start' : 'end'}
						/>
					))
				}
			</div>
		</section>

		<TestimonialsSection />
	</main>

	<Footer />
</Layout>
