---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ArticleHero from '../../components/articles/ArticleHero.astro';
import ArticleBodySection from '../../components/articles/ArticleBodySection.astro';
import ArticleProse from '../../components/articles/ArticleProse.astro';
import { getCollection, render } from 'astro:content';
import { formatArticleDate, resolveArticleProjectHref } from '../../utils/getArticles.ts';
import { getSiteCounts } from '../../utils/getSiteCounts.ts';

export async function getStaticPaths() {
	const [articles, projects] = await Promise.all([
		getCollection('articles'),
		getCollection('projects'),
	]);
	const { projectCount, articleCount } = await getSiteCounts();
	const projectSlugs = new Set(projects.map((project) => project.id));

	return articles.map((article) => ({
		params: { slug: article.id },
		props: {
			article,
			projectCount,
			articleCount,
			categoryProjectHref: resolveArticleProjectHref(
				article.data.relatedProject,
				projectSlugs,
				article.data.categoryHref,
			),
		},
	}));
}

const { article, projectCount, articleCount, categoryProjectHref } = Astro.props;
const { Content } = await render(article);
const data = article.data;
const pageDescription = data.description || data.deck || data.title;
---

<Layout title={data.title} description={pageDescription}>
	<Header theme="light-bg" projectCount={projectCount} articleCount={articleCount} />

	<main id="article-page" class="article-page relative z-20 flex-1 bg-white">
		<div class="article-layout [--article-gutter:16px] md:[--article-gutter:220px]">
			<ArticleHero
				category={data.category}
				projectHref={categoryProjectHref}
				title={data.title}
				author={data.author}
				publishedLabel={formatArticleDate(data.publishedAt)}
			/>

			{
				data.sideMedia ? (
					<ArticleBodySection sideMedia={data.sideMedia} sideMediaAlt={data.title}>
						<Content />
					</ArticleBodySection>
				) : (
					<ArticleProse>
						<Content />
					</ArticleProse>
				)
			}
		</div>

	</main>

	<Footer />
</Layout>
