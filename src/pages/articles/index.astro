---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ArticlesSection from '../../components/ArticlesSection.astro';
import { getSiteCounts } from '../../utils/getSiteCounts.ts';

const { projectCount, articleCount } = await getSiteCounts();
---

<Layout title="Articles" description="Inside the process — articles and insights from Setin Studio.">
	<Header theme="light-bg" projectCount={projectCount} articleCount={articleCount} />

	<main class="flex-1">
		<ArticlesSection standalone />
	</main>

	<Footer />
</Layout>
