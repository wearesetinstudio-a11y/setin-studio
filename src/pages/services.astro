---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getSiteCounts } from '../utils/getSiteCounts.ts';
import { dictionaries, t } from '../i18n/dictionaries.ts';

const { projectCount, articleCount } = await getSiteCounts();

const serviceIds = ['branding', 'product', 'development', 'cloud', 'data', 'automation'];

const services = serviceIds.map((id, index) => {
	const base = `services.item.${id}`;
	const points = [];
	for (let n = 1; `${base}.point${n}.title` in dictionaries.en; n++) {
		const titleKey = `${base}.point${n}.title`;
		const textKey = `${base}.point${n}.text`;
		points.push({ titleKey, title: t('en', titleKey), textKey, text: t('en', textKey) });
	}
	return {
		number: String(index + 1).padStart(2, '0'),
		labelKey: `${base}.label`,
		label: t('en', `${base}.label`),
		titleKey: `${base}.title`,
		title: t('en', `${base}.title`),
		bodyKey: `${base}.body`,
		body: t('en', `${base}.body`),
		points,
	};
});
---

<Layout
	title="Services"
	description="Brand identity, digital product design, and high-performance builds from Setin Studio."
>
	<Header projectCount={projectCount} articleCount={articleCount} />

	<main class="relative z-20 flex-1">
		<section class="services-page bg-[#131415] px-[var(--page-gutter)] pb-[var(--section-padding-y)] pt-[calc(var(--section-padding-y)+5.5rem)]">
			<div class="services-page__layout">
				<aside class="services-page__aside" aria-label="Service categories" data-i18n-aria="services.aria">
					<nav class="services-page__nav">
						{
							services.map((service) => (
								<a
									class="services-page__nav-link"
									href={`#service-${service.number}`}
									data-service-nav-link={service.number}
								>
									<span class="services-page__nav-number">{service.number} /</span>
									<span class="services-page__nav-label" data-i18n={service.labelKey}>{service.label}</span>
								</a>
							))
						}
					</nav>
				</aside>

				<div class="services-page__content">
					{services.map((service) => (
						<article
							id={`service-${service.number}`}
							class="services-page__item"
							data-service-section={service.number}
						>
							<div class="services-page__meta">
								<span class="services-page__meta-number">{service.number} /</span>
								<span class="services-page__meta-label" data-i18n={service.labelKey}>{service.label}</span>
							</div>
							<div class="services-page__copy">
								<h2 data-i18n={service.titleKey}>{service.title}</h2>
								<p data-i18n={service.bodyKey}>{service.body}</p>
								<ul class="services-page__points">
									{service.points.map((point) => (
										<li class="services-page__point">
											<strong data-i18n={point.titleKey}>{point.title}</strong>
											<span data-i18n={point.textKey}>{point.text}</span>
										</li>
									))}
								</ul>
							</div>
						</article>
					))}
				</div>
			</div>
		</section>

		<div class="services-mobile-nav" data-services-mobile-nav>
			<div id="services-mobile-dropdown" class="services-mobile-nav__dropdown">
				<div class="services-mobile-nav__dropdown-inner">
					<nav class="services-mobile-nav__list" aria-label="Service categories" data-i18n-aria="services.aria">
						{
							services.map((service) => (
								<a
									class="services-mobile-nav__link"
									href={`#service-${service.number}`}
									data-service-nav-link={service.number}
								>
									<span class="services-mobile-nav__num">{service.number}&nbsp;/&nbsp;</span>
									<span class="services-mobile-nav__label">[<span data-i18n={service.labelKey}>{service.label}</span>]</span>
								</a>
							))
						}
					</nav>
				</div>
			</div>
			<button
				type="button"
				class="services-mobile-nav__trigger"
				aria-expanded="false"
				aria-controls="services-mobile-dropdown"
				data-services-mobile-trigger
			>
				<span>
					<span class="services-mobile-nav__num" data-services-mobile-num>{services[0].number}&nbsp;/&nbsp;</span>
					<span class="services-mobile-nav__current">[<span data-services-mobile-label data-i18n={services[0].labelKey}>{services[0].label}</span>]</span>
				</span>
				<svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="services-mobile-nav__chevron" aria-hidden="true">
					<path d="M1 3.5L7 9.5L13 3.5" stroke="currentColor" stroke-width="2"></path>
				</svg>
			</button>
		</div>
	</main>

	<Footer />
</Layout>

<style>
	.services-page {
		padding-top: calc(5.5rem + 5rem);
	}

	.services-page__layout {
		display: grid;
		grid-template-columns: minmax(max-content, 0.7fr) minmax(0, 1.8fr);
		gap: clamp(3rem, 10vw, 12rem);
		max-width: 1180px;
		margin: 0 auto;
	}

	.services-page__aside {
		position: sticky;
		top: 7rem;
		align-self: start;
	}

	.services-page__nav {
		display: grid;
		gap: 0;
	}

	.services-page__nav-link,
	.services-page__meta {
		font-family: "Fustat", ui-sans-serif, system-ui, sans-serif;
		font-size: 1.125rem;
		font-weight: 500;
		line-height: 1.3;
		text-transform: uppercase;
		letter-spacing: 0;
	}

	.services-page__nav-link {
		position: relative;
		display: flex;
		padding-block: clamp(1.4rem, 2.4vw, 2rem);
		gap: 0.35rem;
		white-space: nowrap;
		color: rgb(245 245 245 / 0.5);
		transition: color 250ms ease;
	}

	.services-page__nav-link::after {
		position: absolute;
		right: 0;
		bottom: 0;
		left: 0;
		height: 1px;
		content: '';
		background: rgb(245 245 245 / 0.16);
		transition: background-color 250ms ease;
	}

	.services-page__nav-link.is-active {
		color: rgb(255 255 255 / 0.6);
	}

	.services-page__nav-link.is-active .services-page__nav-label {
		color: #fff;
	}

	.services-page__nav-link.is-active::after {
		background: rgb(245 245 245 / 0.55);
	}

	.services-page__nav-link:hover,
	.services-page__nav-link:focus-visible {
		color: #f5f5f5;
	}

	.services-page__content {
		min-width: 0;
	}

	.services-page__item {
		width: min(100%, 900px);
		display: block;
		scroll-margin-top: 7rem;
		padding: 0 0 clamp(4.5rem, 8vw, 8rem);
		margin-bottom: clamp(4.5rem, 8vw, 8rem);
		border-bottom: 1px solid rgb(245 245 245 / 0.12);
	}

	.services-page__meta {
		display: flex;
		width: 100%;
		align-items: baseline;
		justify-content: space-between;
		gap: 2rem;
		color: rgb(245 245 245 / 0.45);
	}

	.services-page__meta-number {
		flex: 0 0 auto;
	}

	.services-page__meta-label {
		text-align: right;
	}

	.services-page__item.is-active .services-page__meta-number {
		color: rgb(255 255 255 / 0.6);
	}

	.services-page__item.is-active .services-page__meta-label {
		color: #fff;
	}

	.services-page__copy h2 {
		width: 100%;
		max-width: none;
		font-size: clamp(1.8rem, 3vw, 3.2rem);
		font-weight: 600;
		line-height: 1.12;
		text-transform: uppercase;
	}

	.services-page__copy {
		width: 100%;
		margin-top: clamp(4rem, 7vw, 6rem);
		grid-row: 2;
	}

	.services-page__copy p {
		width: 100%;
		max-width: none;
		margin-top: 2rem;
		color: rgb(245 245 245 / 0.6);
		line-height: 1.65;
		white-space: pre-line;
	}

	.services-page__points {
		margin-top: clamp(2.5rem, 4vw, 3.5rem);
		border-bottom: 1px solid rgb(245 245 245 / 0.12);
	}

	.services-page__point {
		display: grid;
		grid-template-columns: minmax(0, 12rem) minmax(0, 1fr);
		gap: 0.5rem 2rem;
		padding-block: 1.25rem;
		border-top: 1px solid rgb(245 245 245 / 0.12);
		line-height: 1.55;
	}

	.services-page__point strong {
		font-weight: 500;
		color: #f5f5f5;
	}

	.services-page__point span {
		color: rgb(245 245 245 / 0.6);
	}

	.services-page__item:last-child {
		margin-bottom: 0;
	}

	.services-mobile-nav {
		display: none;
	}

	@media (max-width: 767px) {
		.services-mobile-nav {
			position: fixed;
			inset-inline: 0;
			bottom: 0;
			z-index: 40;
			display: block;
			padding-inline: var(--page-gutter);
			background: rgb(19 20 21 / 0.95);
			backdrop-filter: blur(12px);
		}
	}

	.services-mobile-nav__dropdown {
		display: grid;
		grid-template-rows: 0fr;
		transition: grid-template-rows 250ms cubic-bezier(0.4, 0, 1, 1);
	}

	.services-mobile-nav.is-open .services-mobile-nav__dropdown {
		grid-template-rows: 1fr;
		transition-duration: 350ms;
		transition-timing-function: cubic-bezier(0, 0, 0.2, 1);
	}

	.services-mobile-nav__dropdown-inner {
		overflow: hidden;
	}

	.services-mobile-nav__list {
		display: flex;
		max-height: 60vh;
		flex-direction: column;
		gap: 18px;
		overflow-y: auto;
		padding: 1rem 0 1.25rem;
	}

	.services-mobile-nav__link,
	.services-mobile-nav__trigger {
		font-size: 1rem;
		font-weight: 600;
		line-height: 1.2;
		text-transform: uppercase;
	}

	.services-mobile-nav__num {
		font-variant-numeric: tabular-nums;
	}

	.services-mobile-nav__link {
		display: block;
		white-space: nowrap;
		color: rgb(255 255 255 / 0.4);
		transition: color 180ms ease;
	}

	.services-mobile-nav__link.is-active {
		color: #fff;
	}

	.services-mobile-nav__link.is-active .services-mobile-nav__num {
		color: rgb(255 255 255 / 0.55);
	}

	.services-mobile-nav__trigger {
		display: flex;
		width: 100%;
		align-items: center;
		justify-content: space-between;
		padding: 0.875rem 0 max(0.875rem, env(safe-area-inset-bottom));
		line-height: 1.5;
		color: #fff;
		text-align: left;
	}

	.services-mobile-nav__trigger .services-mobile-nav__num {
		color: rgb(255 255 255 / 0.45);
	}

	.services-mobile-nav__chevron {
		flex-shrink: 0;
		transform: rotate(180deg);
		transition: transform 300ms ease-in-out;
	}

	.services-mobile-nav.is-open .services-mobile-nav__chevron {
		transform: rotate(0deg);
	}

	@media (max-width: 767px) {
		.services-page__layout {
			display: block;
		}

		.services-page {
			padding-top: calc(5.5rem + 2rem);
		}

		.services-page__aside {
			display: none;
		}

		.services-page__nav {
			gap: 0;
		}

		.services-page__item {
			display: block;
			padding-bottom: 4rem;
			margin-bottom: 4rem;
		}

		.services-page__meta {
			margin-bottom: 2rem;
		}

		.services-page__copy {
			margin-top: 0;
		}

		.services-page__point {
			grid-template-columns: 1fr;
		}
	}
</style>

<script>
	import { scrollToId } from '../scripts/initSmoothScroll';

	const initializeServicesPage = () => {
		const page = document.querySelector<HTMLElement>('.services-page');
		const navLinks = Array.from(document.querySelectorAll<HTMLElement>('[data-service-nav-link]'));
		const serviceSections = Array.from(document.querySelectorAll<HTMLElement>('[data-service-section]'));

		if (!page || page.dataset.servicesInitialized === 'true' || !navLinks.length || !serviceSections.length) return;
		page.dataset.servicesInitialized = 'true';

		const mobileNav = document.querySelector<HTMLElement>('[data-services-mobile-nav]');
		const mobileTrigger = document.querySelector<HTMLButtonElement>('[data-services-mobile-trigger]');
		const mobileNum = document.querySelector<HTMLElement>('[data-services-mobile-num]');
		const mobileLabel = document.querySelector<HTMLElement>('[data-services-mobile-label]');

		const setMobileOpen = (open: boolean) => {
			mobileNav?.classList.toggle('is-open', open);
			mobileTrigger?.setAttribute('aria-expanded', String(open));
		};

		mobileTrigger?.addEventListener('click', (event) => {
			event.stopPropagation();
			setMobileOpen(!mobileNav?.classList.contains('is-open'));
		});

		// Window capture: the global smooth-scroll handler stops hash-link clicks at the document.
		const onWindowClick = (event: MouseEvent) => {
			if (!mobileNav || mobileTrigger?.contains(event.target as Node)) return;
			const link = (event.target as Element | null)?.closest<HTMLElement>('[data-service-nav-link]');
			if (link && mobileNav.contains(link)) setActiveService(link.dataset.serviceNavLink ?? '');
			setMobileOpen(false);
		};
		window.addEventListener('click', onWindowClick, true);
		document.addEventListener('astro:before-swap', () => window.removeEventListener('click', onWindowClick, true), {
			once: true,
		});

		const setActiveService = (number: string) => {
			navLinks.forEach((link) => {
				link.classList.toggle('is-active', link.dataset.serviceNavLink === number);
			});
			serviceSections.forEach((section) => {
				section.classList.toggle('is-active', section.dataset.serviceSection === number);
			});

			const activeLabel = serviceSections
				.find((section) => section.dataset.serviceSection === number)
				?.querySelector<HTMLElement>('.services-page__meta-label');
			if (mobileNum) mobileNum.textContent = `${number}\u00A0/\u00A0`;
			if (mobileLabel && activeLabel) {
				mobileLabel.textContent = activeLabel.textContent;
				mobileLabel.dataset.i18n = activeLabel.dataset.i18n;
			}
		};

		const observer = new IntersectionObserver(
			() => {
				const activeBandTop = window.innerHeight * 0.18;
				const activeBandBottom = window.innerHeight * 0.38;
				const visibleSections = serviceSections
					.filter((section) => {
						const bounds = section.getBoundingClientRect();
						return bounds.top < activeBandBottom && bounds.bottom > activeBandTop;
					})
					.sort(
						(a, b) =>
							Math.abs(a.getBoundingClientRect().top - activeBandTop) -
							Math.abs(b.getBoundingClientRect().top - activeBandTop),
					);

				if (visibleSections[0]) {
					setActiveService(visibleSections[0].dataset.serviceSection ?? '');
				}
			},
			{ rootMargin: '-18% 0px -62% 0px', threshold: 0 },
		);

		serviceSections.forEach((section) => observer.observe(section));
		navLinks.forEach((link) => {
			link.addEventListener('click', (event) => {
				const targetId = link.getAttribute('href')?.slice(1);
				const target = targetId ? document.getElementById(targetId) : null;

				if (!target) return;

				event.preventDefault();
				setMobileOpen(false);
				setActiveService(link.dataset.serviceNavLink ?? '');
				scrollToId(targetId ?? '');
				history.replaceState(null, '', `#${targetId}`);
			});
		});
		const hashTarget = window.location.hash
			? document.getElementById(window.location.hash.slice(1))
			: null;
		setActiveService(
			hashTarget?.dataset.serviceSection ?? serviceSections[0].dataset.serviceSection ?? '',
		);
		if (hashTarget) {
			requestAnimationFrame(() => scrollToId(hashTarget.id, { immediate: true }));
		}
	};

	document.addEventListener('astro:page-load', initializeServicesPage);
	initializeServicesPage();
</script>
