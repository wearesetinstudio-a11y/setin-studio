---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import ClientsSection from '../components/ClientsSection.astro';
import AboutSection from '../components/AboutSection.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import RollingLink from '../components/RollingLink.astro';
import { getCollection } from 'astro:content';
import { getSiteCounts } from '../utils/getSiteCounts.ts';
import { sortProjects } from '../utils/sortProjects.ts';

const allProjects = await getCollection('projects');
const projects = sortProjects(allProjects);
const { projectCount } = await getSiteCounts();

const heroSocials = [
	{
		label: 'WhatsApp',
		href: 'https://api.whatsapp.com/message/IDQVMTROBPOXM1?autoload=1&app_absent=0',
	},
	{ label: 'Instagram', href: 'https://www.instagram.com/weare_setin_studio/' },
	{ label: 'Facebook', href: 'https://www.facebook.com/wearesetinstudio?locale=pl_PL' },
	{ label: 'LinkedIn', href: 'https://www.linkedin.com/company/wearesetin' },
];

const heroLocations = [
	{ label: 'Panama City, PA', timezone: 'America/Panama' },
	{ label: 'Szczecin, PL', timezone: 'Europe/Warsaw' },
	{ label: 'Valencia, ES', timezone: 'Europe/Madrid' },
];

function formatHeroLocationTime(timeZone: string, date = new Date()) {
	return new Intl.DateTimeFormat('en-US', {
		hour: 'numeric',
		minute: '2-digit',
		second: '2-digit',
		hour12: true,
		timeZone,
	})
		.format(date)
		.toUpperCase();
}
---

<Layout>
	<div id="hero-background-stack" class="hero-background-stack pointer-events-none" aria-hidden="true">
		<picture class="hero-background-picture absolute inset-0 block h-full w-full">
			<source srcset="/hero-background.webp" type="image/webp" />
			<img
				src="/hero-background.jpg"
				alt=""
				width="4800"
				height="3584"
				decoding="async"
				fetchpriority="high"
				class="hero-background-media absolute inset-0 h-full w-full object-cover"
			/>
		</picture>

		<div class="hero-background-stack__tint absolute inset-0 z-[1] bg-[#0A0A0B]"></div>

		<canvas
			id="hero-dust-layer"
			class="hero-dust-layer pointer-events-none absolute inset-0 z-[2] block h-full w-full"
			aria-hidden="true"
		></canvas>

		<canvas
			id="cinema-pure-noise-filter"
			class="hero-background-stack__noise pointer-events-none absolute inset-0 z-[3] block h-full w-full bg-transparent"
		></canvas>

		<div class="hero-background-stack__vignette pointer-events-none absolute inset-0 z-[4]" aria-hidden="true"></div>
	</div>

	<Header projectCount={projectCount} waitForIntro={true} />

	<main class="relative z-20 flex-1">
		<section id="hero-section" class="hero-section relative pb-6 md:pb-10">
			<div class="hero-section__primary relative z-10 w-full">
				<div class="hero-section__pin" data-hero-pin>
					<div class="hero-headline-wrap min-w-0" data-hero-headline-wrap>
						<h1
							id="hero-headline"
							class="hero-monument hero-headline text-h1 w-full uppercase text-setin-fg"
							data-hero-headline
							data-i18n-aria="hero.headline"
							aria-label="We shape the digital monoliths"
						>
							<span class="hero-monument__row hero-monument__row--left" style="--i: 0">
								<span class="hero-reveal-mask">
									<span class="hero-reveal-line" style="--i: 0" data-i18n="hero.monument.1">
										We shape
									</span>
								</span>
							</span>
							<span class="hero-monument__row hero-monument__row--center" style="--i: 1">
								<span class="hero-reveal-mask">
									<span class="hero-reveal-line" style="--i: 1" data-i18n="hero.monument.2">
										The digital
									</span>
								</span>
							</span>
							<span class="hero-monument__row hero-monument__row--right" style="--i: 2">
								<span class="hero-reveal-mask">
									<span class="hero-reveal-line" style="--i: 2" data-i18n="hero.monument.3">
										Monoliths
									</span>
								</span>
							</span>
						</h1>
					</div>

					<div class="hero-aside min-w-0 w-full" data-hero-aside>
						<p
							class="body-txt-1 hero-description leading-relaxed"
							data-hero-description
							data-i18n="hero.description"
						>
							Setin Studio is an independent creative studio rooted in Slavic culture. We help
							ambitious brands and founders turn ideas into sharp design, clean code, and clear
							stories.
						</p>

						<nav
							class="hero-services mt-[40px] w-full"
							aria-label="Services"
							data-i18n-aria="hero.servicesAria"
							data-hero-services
						>
							{
								[
									{ key: 'services.item.branding.label', label: 'Brand Design', href: '/services#service-01' },
									{ key: 'services.item.product.label', label: 'Product UX/UI Design', href: '/services#service-02' },
									{ key: 'services.item.development.label', label: 'Web Engineering', href: '/services#service-03' },
									{ key: 'services.item.cloud.label', label: 'Cloud Services', href: '/services#service-04' },
									{ key: 'services.item.data.label', label: 'Product Optimization', href: '/services#service-05' },
									{ key: 'services.item.automation.label', label: 'AI Automations', href: '/services#service-06' },
								].map((service, index) => (
									<a
										href={service.href}
										class="hero-service group"
										style={`--i: ${index}`}
									>
										<span class="hero-service__inner">
											<span class="hero-service__label-wrap">
												<span class="hero-service__label-roll">
													<span class="hero-service__label" data-i18n={service.key}>
														{service.label}
													</span>
													<span
														class="hero-service__label"
														data-i18n={service.key}
														aria-hidden="true"
													>
														{service.label}
													</span>
												</span>
											</span>
											<img
												src="/icons/simple-arrow.svg"
												alt=""
												width="22"
												height="18"
												class="hero-service__arrow"
												aria-hidden="true"
											/>
										</span>
									</a>
								))
							}
						</nav>
					</div>
				</div>
			</div>
			<div class="hero-section__tail relative z-10" data-hero-tail aria-hidden="true"></div>
			<div class="hero-meta relative z-10" data-hero-meta>
				<div class="hero-meta__rule" aria-hidden="true"></div>
				<div class="hero-meta__row">
					<nav class="hero-meta__socials" aria-label="Social">
						{
							heroSocials.map((link) => (
								<RollingLink
									href={link.href}
									label={link.label}
									external
									markCurrent={false}
								/>
							))
						}
					</nav>
					<div class="hero-meta__locations" aria-label="Studio locations">
						{
							heroLocations.map((location) => (
								<div class="hero-meta__location">
									<span class="hero-meta__location-label">{location.label}</span>
									<time
										class="hero-meta__location-time"
										datetime={new Date().toISOString()}
										data-timezone={location.timezone}
									>
										{formatHeroLocationTime(location.timezone)}
									</time>
								</div>
							))
						}
					</div>
				</div>
			</div>
		</section>

		<script>
			import { initCinemaPureNoise } from '../scripts/initCinemaPureNoise.ts';
			import { initHeroScrollZoom } from '../scripts/initHeroScrollZoom.ts';
			import { initHeroDust, setHeroDustActive } from '../scripts/initHeroDust.ts';

			let heroStackHidden = false;
			let heroSyncFrame = 0;
			let lockedHeroBgHeight = 0;

			function lockHeroBackgroundViewport(force = false) {
				const stack = document.getElementById('hero-background-stack');
				if (!stack) return;

				const isMobile = window.matchMedia('(max-width: 767px)').matches;
				if (!isMobile) {
					lockedHeroBgHeight = 0;
					stack.style.removeProperty('height');
					stack.style.removeProperty('width');
					stack.style.removeProperty('top');
					stack.style.removeProperty('left');
					stack.style.removeProperty('right');
					return;
				}

				if (!force && lockedHeroBgHeight > 0) return;

				const viewportHeight = Math.round(
					Math.max(
						window.innerHeight,
						document.documentElement.clientHeight,
						window.visualViewport?.height ?? 0,
					),
				);

				// Keep the largest height seen so URL-bar show/hide doesn't resize the layer.
				lockedHeroBgHeight = Math.max(lockedHeroBgHeight, viewportHeight);

				stack.style.top = '0px';
				stack.style.left = '0px';
				stack.style.right = '0px';
				stack.style.width = '100%';
				stack.style.height = `${lockedHeroBgHeight}px`;
			}

			function syncHeroBackgroundStack() {
				const hero = document.getElementById('hero-section');
				const stack = document.getElementById('hero-background-stack');
				if (!hero || !stack) return;

				const heroBottom = hero.getBoundingClientRect().bottom;

				if (!heroStackHidden && heroBottom < -64) {
					heroStackHidden = true;
					stack.classList.add('is-hidden');
					document.documentElement.classList.remove('hero-cinema-active');
					setHeroDustActive(false);
				} else if (heroStackHidden && heroBottom > 0) {
					heroStackHidden = false;
					stack.classList.remove('is-hidden');
					document.documentElement.classList.add('hero-cinema-active');
					initHeroScrollZoom();
					initHeroDust();
					setHeroDustActive(true);
				}
			}

			function scheduleHeroBackgroundSync() {
				if (heroSyncFrame) return;
				heroSyncFrame = window.requestAnimationFrame(() => {
					syncHeroBackgroundStack();
					heroSyncFrame = 0;
				});
			}

			function bootHeroCinema() {
				initCinemaPureNoise('cinema-pure-noise-filter', {
					observeElementId: 'hero-section',
					density: 0.09,
					grainSize: 0.6,
					baseOpacity: 0.11,
				});
				document.documentElement.classList.add('hero-cinema-active');
				lockHeroBackgroundViewport(true);
				syncHeroBackgroundStack();
				initHeroScrollZoom();
				initHeroDust();
			}

			bootHeroCinema();
			window.addEventListener('scroll', scheduleHeroBackgroundSync, { passive: true });
			window.addEventListener(
				'resize',
				() => {
					// Ignore toolbar-driven resizes on mobile; only unlock on real layout changes via orientation.
					if (!window.matchMedia('(max-width: 767px)').matches) {
						lockHeroBackgroundViewport(true);
					}
					scheduleHeroBackgroundSync();
				},
				{ passive: true },
			);
			window.addEventListener(
				'orientationchange',
				() => {
					lockedHeroBgHeight = 0;
					window.setTimeout(() => lockHeroBackgroundViewport(true), 250);
				},
				{ passive: true },
			);
			document.addEventListener('astro:page-load', () => {
				heroStackHidden = false;
				lockedHeroBgHeight = 0;
				bootHeroCinema();
			});
			window.addEventListener('setin:language-change', () => {
				lockHeroBackgroundViewport(true);
				syncHeroBackgroundStack();
				initHeroScrollZoom();
				initHeroDust();
			});
		</script>

		<ClientsSection />

		<ProjectsSection projects={projects} />

		<AboutSection />

		<TestimonialsSection />

	</main>

	<Footer />

	<script>
		import { hasCompletedIntro } from '../scripts/introState.ts';

		function revealHeroText() {
			const headline = document.querySelector<HTMLElement>('[data-hero-headline]');
			if (headline) {
				headline.dataset.revealed = 'true';
				headline.querySelectorAll('.hero-reveal-line').forEach((element) => {
					element.classList.add('is-revealed');
				});
			}

			document.querySelector<HTMLElement>('[data-hero-description]')?.classList.add('is-revealed');
			document.querySelector<HTMLElement>('[data-hero-services]')?.classList.add('is-revealed');
			document.querySelector<HTMLElement>('[data-hero-meta]')?.classList.add('is-revealed');
			requestAnimationFrame(syncHeroPinHeight);
		}

		function prepareHeroCopy() {
			syncHeroPinHeight();
		}

		function syncHeroPinHeight() {
			const pin = document.querySelector<HTMLElement>('[data-hero-pin]');
			const headlineWrap = document.querySelector<HTMLElement>('[data-hero-headline-wrap]');
			const aside = document.querySelector<HTMLElement>('[data-hero-aside]');
			const headline = document.querySelector<HTMLElement>('[data-hero-headline]');
			const services = document.querySelector<HTMLElement>('[data-hero-services]');
			const tail = document.querySelector<HTMLElement>('[data-hero-tail]');
			if (!pin || !headlineWrap || !aside) return;

			const isMobile = window.matchMedia('(max-width: 767px)').matches;
			aside.style.removeProperty('padding-top');
			aside.style.removeProperty('padding-bottom');
			pin.style.removeProperty('min-height');

			if (isMobile) {
				// Pin ends at description bottom (90vh). Services sit below and need flow space.
				if (!tail) return;
				if (!services) {
					tail.style.height = '0px';
					return;
				}
				const marginTop = parseFloat(getComputedStyle(services).marginTop) || 0;
				tail.style.height = `${services.offsetHeight + marginTop}px`;
				return;
			}

			if (tail) tail.style.height = '0px';

			// Start: aside top aligns with headline top.
			// End of scroll: services bottom aligns with headline bottom → next sections follow.
			const shellHeight = headlineWrap.clientHeight || Math.round(window.innerHeight * 0.9);
			const headlineHeight = headline?.offsetHeight ?? 0;
			const contentHeight = aside.offsetHeight;
			const padTop = Math.max(0, shellHeight - headlineHeight);
			const travel = Math.max(0, contentHeight - headlineHeight);

			aside.style.paddingTop = `${padTop}px`;
			pin.style.minHeight = `${shellHeight + travel}px`;
		}

		function initHeroSlideUpReveal() {
			lastHeroLayoutWidth = window.innerWidth;
			prepareHeroCopy();

			if (hasCompletedIntro()) {
				revealHeroText();
			} else {
				window.addEventListener('intro-complete', revealHeroText, { once: true });
			}

			requestAnimationFrame(syncHeroPinHeight);
		}

		let resizeTimer = 0;
		let lastHeroLayoutWidth = 0;

		function onHeroCopyResize() {
			const width = window.innerWidth;
			const isMobile = window.matchMedia('(max-width: 767px)').matches;

			// Mobile URL-bar show/hide fires resize with the same width — skip reflow
			// or the absolute pin (headline/description) jumps mid-scroll.
			if (isMobile && lastHeroLayoutWidth > 0 && width === lastHeroLayoutWidth) {
				return;
			}

			window.clearTimeout(resizeTimer);
			resizeTimer = window.setTimeout(() => {
				lastHeroLayoutWidth = window.innerWidth;
				prepareHeroCopy();
				if (hasCompletedIntro()) revealHeroText();
				syncHeroPinHeight();
			}, 120);
		}

		initHeroSlideUpReveal();
		document.addEventListener('astro:page-load', initHeroSlideUpReveal);
		window.addEventListener('resize', onHeroCopyResize, { passive: true });
		window.addEventListener('setin:language-change', () => {
			prepareHeroCopy();
			if (hasCompletedIntro()) revealHeroText();
			requestAnimationFrame(syncHeroPinHeight);
		});

		if ('fonts' in document) {
			void document.fonts.ready.then(() => {
				syncHeroPinHeight();
			});
		}

		let heroClockInterval: ReturnType<typeof window.setInterval> | null = null;

		function initHeroLocationTimes() {
			if (heroClockInterval !== null) {
				window.clearInterval(heroClockInterval);
				heroClockInterval = null;
			}

			const clocks = document.querySelectorAll<HTMLTimeElement>('.hero-meta__location-time');
			if (!clocks.length) return;

			const formatterCache = new Map<string, Intl.DateTimeFormat>();

			function getFormatter(timeZone: string) {
				let formatter = formatterCache.get(timeZone);
				if (!formatter) {
					formatter = new Intl.DateTimeFormat('en-US', {
						hour: 'numeric',
						minute: '2-digit',
						second: '2-digit',
						hour12: true,
						timeZone,
					});
					formatterCache.set(timeZone, formatter);
				}
				return formatter;
			}

			function updateClocks() {
				const now = new Date();
				clocks.forEach((clock) => {
					const timeZone = clock.dataset.timezone;
					if (!timeZone) return;
					clock.textContent = getFormatter(timeZone).format(now).toUpperCase();
					clock.dateTime = now.toISOString();
				});
			}

			updateClocks();
			heroClockInterval = window.setInterval(updateClocks, 1000);
		}

		initHeroLocationTimes();
		document.addEventListener('astro:page-load', initHeroLocationTimes);
	</script>
</Layout>

<style is:global>
	.hero-background-stack {
		position: fixed;
		top: 0;
		right: 0;
		left: 0;
		z-index: 0;
		overflow: hidden;
		width: 100%;
		/* svh stays stable when mobile browser chrome shows/hides */
		height: 100svh;
		background-color: #0A0A0B;
		transition: opacity 0.35s ease, visibility 0.35s ease;
		transform: translateZ(0);
		backface-visibility: hidden;
	}

	.hero-background-stack.is-hidden {
		opacity: 0;
		visibility: hidden;
	}

	.hero-background-media {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 46%;
		transform: scale(1.08) translateZ(0);
		transform-origin: 50% 46%;
		/* Dawn start — JS brightens to 1 on hero scroll end */
		filter: brightness(0.72) contrast(0.98);
	}

	.hero-background-stack__tint {
		opacity: 0.46;
		background-color: #0A0A0B;
		transition: none;
	}

	.hero-dust-layer {
		mix-blend-mode: screen;
		opacity: 1;
		pointer-events: none;
	}

	/* Soft CRT / old-TV edge falloff — center stays open on the monument */
	.hero-background-stack__vignette {
		background:
			radial-gradient(
				ellipse 78% 72% at 50% 46%,
				rgba(0, 0, 0, 0) 0%,
				rgba(0, 0, 0, 0) 42%,
				rgba(8, 8, 9, 0.28) 68%,
				rgba(5, 5, 6, 0.62) 86%,
				rgba(0, 0, 0, 0.82) 100%
			),
			radial-gradient(
				ellipse 100% 100% at 50% 50%,
				rgba(0, 0, 0, 0) 55%,
				rgba(0, 0, 0, 0.22) 100%
			);
		box-shadow: inset 0 0 12rem 2.5rem rgba(0, 0, 0, 0.45);
		opacity: 0.92;
		mix-blend-mode: multiply;
	}

	@media (max-width: 767px) {
		.hero-background-stack {
			width: 100%;
			min-width: 100%;
		}

		.hero-background-media {
			will-change: transform;
		}

		.hero-dust-layer {
			opacity: 0.9;
		}

		.hero-background-stack__vignette {
			box-shadow: inset 0 0 7rem 1.5rem rgba(0, 0, 0, 0.4);
			opacity: 0.85;
		}
	}

	.hero-background-stack__noise {
		opacity: 1;
	}

	/* Match other image sections: cinema grain only (global overlays sit under main) */
	html.hero-cinema-active .noise-overlay--coarse,
	html.hero-cinema-active .noise-overlay--fine,
	html.hero-cinema-active .noise-scanlines {
		opacity: 0;
	}

	.hero-headline {
		font-weight: 600;
		line-height: 1.15;
		width: 100%;
		max-width: 100%;
		overflow-wrap: normal;
		word-break: normal;
	}

	.hero-section__primary {
		position: relative;
		/* svh stays stable when mobile browser chrome shows/hides (dvh jumps) */
		min-height: 90svh;
		min-height: 90dvh;
		padding-top: 7rem;
	}

	.hero-section__pin {
		position: absolute;
		right: var(--page-gutter);
		bottom: 0;
		left: var(--page-gutter);
		width: auto;
	}

	.hero-section__tail {
		width: 100%;
		pointer-events: none;
	}

	.hero-meta {
		width: 100%;
		padding-inline: var(--page-gutter);
		padding-top: 2.5rem;
		padding-bottom: 0.75rem;
		opacity: 0;
		transform: translateY(0.6rem);
		transition:
			opacity 900ms cubic-bezier(0.16, 1, 0.3, 1) 420ms,
			transform 900ms cubic-bezier(0.16, 1, 0.3, 1) 420ms;
	}

	.hero-meta.is-revealed {
		opacity: 1;
		transform: translateY(0);
	}

	.hero-meta__rule {
		height: 1px;
		width: 100%;
		background-color: rgba(255, 255, 255, 0.18);
	}

	.hero-meta__row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem 1.5rem;
		padding-top: 2.5rem;
	}

	.hero-meta__socials {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1.25rem 1.75rem;
	}

	.hero-meta__socials .rolling-link--nav {
		margin: -0.35rem -0.25rem;
		padding: 0.35rem 0.25rem;
		color: #ffffff;
	}

	.hero-meta__socials .rolling-link__line--nav {
		font-size: 1rem;
		letter-spacing: -0.01em;
	}

	.hero-meta__locations {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: flex-end;
		gap: 1rem 1.75rem;
	}

	.hero-meta__location {
		display: flex;
		align-items: baseline;
		gap: 0.55rem;
		white-space: nowrap;
	}

	.hero-meta__location-label,
	.hero-meta__location-time {
		font-size: 1rem;
		font-weight: 600;
		line-height: 1.2;
		letter-spacing: -0.01em;
		text-transform: uppercase;
		color: #ffffff;
	}

	.hero-meta__location-time {
		font-variant-numeric: tabular-nums;
		opacity: 0.72;
	}

	@media (max-width: 767px) {
		.hero-meta {
			display: none;
		}
	}

	@media (min-width: 768px) {
		.hero-meta {
			padding-top: 4.5rem;
			padding-bottom: 1rem;
		}
	}

	.hero-headline-wrap {
		position: relative;
		z-index: 1;
		min-width: 0;
		width: 100%;
	}

	.hero-aside {
		position: absolute;
		top: 100%;
		left: 0;
		right: 0;
		margin-top: 1.5rem;
		width: 100%;
	}

