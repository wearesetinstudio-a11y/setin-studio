---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProjectHero from '../../components/projects/ProjectHero.astro';
import ProjectOverviewSection from '../../components/projects/ProjectOverviewSection.astro';
import ProjectContentBlock from '../../components/projects/ProjectContentBlock.astro';
import ProjectGallerySection from '../../components/projects/ProjectGallerySection.astro';
import ProjectSidebar, { type SidebarNavItem } from '../../components/projects/ProjectSidebar.astro';
import { getCollection } from 'astro:content';
import {
	buildGalleryLayout,
	getCoverFilename,
	getOverviewGraphic,
	resolveProjectFolderName,
	type GalleryLayoutBlock,
} from '../../utils/getProjectGallery';
import {
	buildProjectPageSegments,
	resolveProjectSections,
} from '../../utils/getProjectSections';
import { withPublicAssetVersion } from '../../utils/withPublicAssetVersion';
import { getYouTubeEmbedUrl } from '../../utils/youtube.ts';
import { buildProjectCopyBundle } from '../../utils/getProjectCopy.ts';
import { normalizeProjectCategories } from '../../utils/projectCategories.ts';

export async function getStaticPaths() {
	const projects = await getCollection('projects');

	return projects
		.filter((project) => !project.data.comingSoon)
		.map((project) => ({
			params: { slug: project.id },
			props: {
				project,
				projectCount: projects.length,
			},
		}));
}

const { project, projectCount } = Astro.props;
const data = project.data;

const title = data.title ?? 'Project';
const heroSubtitle = data.heroSubtitle ?? '';
const heroBackground = data.heroBackground ?? '';
const client = data.client ?? title;
const heroImage = withPublicAssetVersion(data.heroImage || heroBackground);
const year = data.year;
const categories = normalizeProjectCategories(data.tags ?? []);
const service = categories.length > 0 ? categories.join(', ') : (data.service ?? '');
const industry = data.industry ?? '';
const market = data.market ?? '';
const liveUrl = data.liveUrl ?? '';
const liveLabel = data.liveLabel ?? '';
const folderName = resolveProjectFolderName(project);
const projectOgPath = `/portfolio/${folderName}/og.jpg`;
const projectOgImage = existsSync(join(process.cwd(), 'public', 'portfolio', folderName, 'og.jpg'))
	? projectOgPath
	: undefined;
const coverFilename = getCoverFilename(data.thumbnail);
const galleryLayout = buildGalleryLayout(folderName, coverFilename);
const overviewLabel = data.overviewLabel || 'Overview';
const overviewTitle = data.overviewTitle ?? '';
const overviewText = data.overviewText ?? '';
const overviewYoutubeEmbed = data.overviewYoutube
	? getYouTubeEmbedUrl(data.overviewYoutube)
	: null;
const hasGroupOne = galleryLayout.some((block) => block.group === 1);
const overviewGraphicItem = overviewYoutubeEmbed
	? null
	: hasGroupOne
		? null
		: getOverviewGraphic(folderName, coverFilename);
const overviewGraphicSrc = overviewYoutubeEmbed
	? overviewYoutubeEmbed
	: data.overviewGraphic
		? withPublicAssetVersion(data.overviewGraphic)
		: overviewGraphicItem
			? withPublicAssetVersion(overviewGraphicItem.src)
			: '';
const overviewGraphicType = overviewYoutubeEmbed
	? ('youtube' as const)
	: overviewGraphicItem?.type === 'video'
		? ('video' as const)
		: ('image' as const);

// YouTube owns slot 1.1 — remove file-based group 1 from the gallery stream.
const pageGalleryLayout = overviewYoutubeEmbed
	? galleryLayout.filter((block) => block.group !== 1)
	: galleryLayout;

const projectSections = resolveProjectSections(data);

const infoRows = [
	service ? { label: 'Service', value: service, labelKey: 'project.meta.service', fieldKey: 'service' } : null,
	industry
		? { label: 'Industry', value: industry, labelKey: 'project.meta.industry', fieldKey: 'industry' }
		: null,
	market ? { label: 'Market', value: market, labelKey: 'project.meta.market', fieldKey: 'market' } : null,
	year ? { label: 'Year', value: String(year), labelKey: 'project.meta.year' } : null,
	liveUrl
		? {
				label: 'Live',
				value: liveUrl,
				linkText: liveLabel || undefined,
				isLink: true,
				labelKey: 'project.meta.live',
				fieldKey: 'liveUrl',
			}
		: null,
].filter(
	(
		row,
	): row is {
		label: string;
		value: string;
		linkText?: string;
		isLink?: boolean;
		labelKey?: string;
		fieldKey?: string;
	} => row !== null,
);

const showOverview = Boolean(overviewTitle || overviewText || infoRows.length || overviewGraphicSrc);
const pageDescription =
	projectSections.find((section) => section.text)?.text ||
	overviewText ||
	heroSubtitle ||
	title;

function splitGalleryAfterGroup(
	blocks: GalleryLayoutBlock[],
	afterGroup: number,
): { before: GalleryLayoutBlock[]; after: GalleryLayoutBlock[] } {
	const before: GalleryLayoutBlock[] = [];
	const after: GalleryLayoutBlock[] = [];

	for (const block of blocks) {
		if (block.group <= afterGroup) before.push(block);
		else after.push(block);
	}

	return { before, after };
}

const pageSegments = buildProjectPageSegments(
	pageGalleryLayout,
	projectSections,
	splitGalleryAfterGroup,
);

const heroLines = (heroSubtitle || title)
	.split('\n')
	.map((line) => line.trim())
	.filter(Boolean);

let galleryMediaCursor = 0;
const revealHeadingIds = [
	'project-overview-heading',
	...projectSections
		.filter((section) => section.title)
		.map((section) => `project-section-${section.index}-heading`),
];

const navItems: SidebarNavItem[] = [
	...(showOverview
		? [
				{
					id: 'project-section-0',
					num: '01',
					label: overviewLabel,
					isOverview: true,
				},
			]
		: []),
	...projectSections.map((section, idx) => ({
		id: `project-section-${section.index + 1}`,
		num: String(showOverview ? idx + 2 : idx + 1).padStart(2, '0'),
		label: section.label,
		sectionIndex: section.index,
	})),
];

const projectCopy = buildProjectCopyBundle(data);
if (service) {
	projectCopy.en.service = service;
	projectCopy.pl.service = service;
	projectCopy.es.service = service;
}
const projectCopyJson = JSON.stringify(projectCopy).replace(/</g, '\\u003c');
---

<Layout
	title={title}
	description={pageDescription}
	image={projectOgImage}
	imageAlt={projectOgImage ? title : undefined}
>
	<Header projectCount={projectCount} />

	<main id="project-page" class="project-page relative z-20 flex-1">
		<template id="project-copy-data" data-project-copy="true" set:html={projectCopyJson} />
		<script is:inline define:vars={{ projectCopy }}>
			globalThis.__projectCopy = projectCopy;
		</script>

		<ProjectHero heroImage={heroImage} heroLines={heroLines} client={client} />

		<div class="project-page__body relative z-10 bg-white pb-20 lg:pb-0">
			<div class="project-page__container relative mx-auto w-full px-[var(--page-gutter)] pt-24 pb-12 md:pt-36 md:pb-20 lg:pt-48 lg:pb-24">
				<div class="project-page__layout grid grid-cols-1 items-start gap-10 lg:grid-cols-[1fr_70%] lg:gap-24 xl:gap-32">
					{navItems.length > 0 ? <ProjectSidebar items={navItems} /> : null}

					<div class="project-page__content flex min-w-0 flex-col gap-20 md:gap-28 lg:gap-36">
						{
							showOverview ? (
								<ProjectOverviewSection
									id="project-section-0"
									num="01"
									label={overviewLabel}
									title={overviewTitle}
									text={overviewText}
									graphicSrc={overviewGraphicSrc}
									graphicType={overviewGraphicType}
									graphicAlt={client}
									rows={infoRows}
								/>
							) : null
						}

						{
							pageSegments.map((segment) => {
								if (segment.type === 'gallery') {
									const startIndex = galleryMediaCursor;
									galleryMediaCursor += segment.blocks.reduce((count, block) => {
										if (block.kind === 'full') return count + 1;
										return count + block.items.length;
									}, 0);

									return (
										<ProjectGallerySection
											blocks={segment.blocks}
											title={title}
											startIndex={startIndex}
										/>
									);
								}

								const { section } = segment;
								const sectionNum = String(
									showOverview
										? projectSections.findIndex((s) => s.index === section.index) + 2
										: projectSections.findIndex((s) => s.index === section.index) + 1,
								).padStart(2, '0');

								return (
									<ProjectContentBlock
										id={`project-section-${section.index + 1}`}
										num={sectionNum}
										index={section.index + 1}
										sectionIndex={section.index}
										label={section.label}
										title={section.title}
										text={section.text}
										headingId={`project-section-${section.index}-heading`}
									/>
								);
							})
						}
					</div>
				</div>
			</div>
		</div>

	</main>

	<Footer />

	<script is:inline define:vars={{ revealHeadingIds }}>
		globalThis.__projectRevealHeadings = revealHeadingIds;
	</script>

	<script>
		import { bootSlideUpReveal } from '../../scripts/initSlideUpReveal.ts';
		import { initScrollLetterReveals } from '../../scripts/initScrollLetterReveal.ts';
		import { initProjectSidebar } from '../../scripts/initProjectSidebar.ts';

		function initProjectPage() {
			bootSlideUpReveal();
			const ids =
				(globalThis as { __projectRevealHeadings?: string[] }).__projectRevealHeadings ?? [];
			initScrollLetterReveals(ids);
			initProjectSidebar();
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', initProjectPage, { once: true });
		} else {
			initProjectPage();
		}

		document.addEventListener('astro:page-load', initProjectPage);
	</script>
</Layout>

<style>
	.project-page :global([data-slide-up].is-revealed .slide-up-line) {
		transform: translateY(0);
		opacity: 1;
	}

	.project-page__body {
		background: #ffffff;
		color: #131415;
		min-width: 0;
		max-width: 100%;
		overflow-x: clip;
	}

	.project-page__layout,
	.project-page__content {
		min-width: 0;
		max-width: 100%;
	}

	.project-page__body :global(img),
	.project-page__body :global(video) {
		display: block;
		width: 100%;
		max-width: 100%;
		height: auto;
	}

	.project-page__content > :global(.project-gallery) {
		padding-inline: 0;
		padding-block: 0;
	}
</style>
