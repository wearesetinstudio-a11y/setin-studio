---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import PitchLayout from '../../layouts/PitchLayout.astro';
import PitchSectionLabel from '../../components/pitches/PitchSectionLabel.astro';
import PitchSidebar from '../../components/pitches/PitchSidebar.astro';
import PitchSimbolo from '../../components/pitches/PitchSimbolo.astro';

const asset = (file: string) => `/pitches/aeronaval/${encodeURI(file)}`;
/** Media removed from the folder is skipped instead of rendering a broken slot. */
const hasAsset = (file: string) => existsSync(join(process.cwd(), 'public/pitches/aeronaval', file));

const cases = [
	{
		logo: asset('Royal Air Force.svg'),
		logoAlt: 'Royal Air Force',
		title: 'Royal Air Force (Reino Unido)',
		titleLines: 'Royal Air Force|(Reino Unido)',
		text: 'Reestructuró su identidad unificando su escarapela histórica con tipografía precisa, resolviendo restricciones legales de registro y optimizando la marca para patrocinios y difusión pública.',
	},
	{
		logo: asset('WP.svg'),
		logoAlt: 'Wojsko Polskie',
		title: 'Wojsko Polskie (Polonia)',
		titleLines: 'Wojsko Polskie|(Polonia)',
		text: 'Introdujeron un lenguaje gráfico coherente para eliminar la fragmentación heredada, apostando por un símbolo dinámico y accesible enfocado en la comunicación abierta con la sociedad.',
	},
	{
		logo: asset('US Air Force.svg'),
		logoAlt: 'US Air Force',
		title: 'US Air Force (Estados Unidos)',
		titleLines: 'US Air Force|(Estados Unidos)',
		text: 'Modernizó su geometría institucional para la era digital, superando la desconexión visual entre unidades y optimizando drásticamente las campañas de reclutamiento y marketing online.',
	},
	{
		logo: asset('Forsvaret.svg'),
		logoAlt: 'Forsvaret',
		title: 'Forsvaret (Dinamarca)',
		titleLines: 'Forsvaret|(Dinamarca)',
		text: 'Implementaron una arquitectura monolítica para integrar bajo un mismo paraguas visual al ejército, la marina y la aviación, reinterpretando elementos tradicionales en un sistema sólido.',
	},
];

const simboloSteps = [
	{
		title: 'Anatomía y codificación del lenguaje visual',
		text: 'El emblema propuesto para el Servicio Nacional Aeronaval (SENAN) traduce los valores fundacionales de la institución en un lenguaje visual limpio, minimalista y de gran potencia expresiva.',
		visual: 'symbol_1.svg',
	},
	{
		title: 'Ancla',
		text: 'El ancla se consolida como el eje firme de mando y liderazgo estratégico, definiendo con absoluta solidez táctica la presencia inquebrantable del SENAN en la defensa de los mares territoriales, litorales y extensas costas de la República de Panamá.',
		visual: 'symbol_2.svg',
	},
	{
		title: 'Rosa de los vientos',
		text: 'La rosa de los vientos actúa como el símbolo definitivo de vigilancia integral y orientación multidireccional en todas las coordenadas geográficas, asegurando la infatigable capacidad de control y dominio operativo en cualquier teatro de operaciones.',
		visual: 'symbol_3.svg',
	},
	{
		title: 'Alas',
		text: 'Las alas estilizadas representan la soberanía aérea y la superioridad táctica de la institución, concebidas para salvaguardar de forma permanente y con absoluta precisión milimétrica todo el espacio aéreo nacional desde el aire.',
		visual: 'symbol_4.svg',
	},
	{
		title: 'Escudo',
		text: 'El escudo conforma el marco histórico y estructural que resguarda la unidad fundacional, la robustez institucional y la inquebrantable lealtad patriótica de la fuerza mediante una presencia sobria, solemne y profundamente respetuosa.',
		visual: 'symbol_5.svg',
	},
	{
		title: 'Protección',
		text: 'El anillo central cerrado envuelve y protege el núcleo operativo del emblema, simbolizando el perímetro absoluto de seguridad institucional y concentrando una fuerza visual que garantiza una legibilidad impecable.',
		visual: 'symbol_6.svg',
	},
].map(({ visual, ...step }) => ({ ...step, src: asset(visual) }));

const simboloMedia = [
	{ file: 'simbolo_1.webp', alt: 'Del escudo al símbolo', width: 3345, height: 2298 },
	{ file: 'simbolo_2.webm', alt: 'Construcción del símbolo' },
	{ file: 'simbolo_3.webp', alt: 'Escalado del logotipo vertical', width: 3345, height: 1958 },
	{ file: 'simbolo_4.webp', alt: 'Escalado del logotipo horizontal', width: 3345, height: 1958 },
].filter((item) => hasAsset(item.file));

const textSectionsData = [
	{
		id: 'operativa',
		label: 'Operativa',
		title: 'Eficacia visual en entornos operacionales complejos',
		media: [
			'operativa_1.webm',
			'operativa_2.webm',
			'operativa_3.webm',
			'operativa_4.webm',
			'operativa_5.webp',
			'operativa_6.webp',
			'operativa_7.webp',
			'operativa_8.webp',
		],
		text: 'Ya sea sobre patrulleras sometidas a la fuerza del oleaje, vehículos todoterreno cubiertos de fango o aeronaves expuestas a condiciones meteorológicas extremas, el símbolo conserva inalterable su integridad gráfica. Su arquitectura resiste abrasiones, impactos y acumulación de suciedad sin comprometer su impacto visual. El diseño garantiza una identificación inmediata a larga distancia, proyectando la capacidad tecnológica y la firmeza institucional en mar, tierra y aire.',
	},
	{
		id: 'indumentaria',
		label: 'Indumentaria',
		title: 'Integración rigurosa en el equipamiento táctico',
		media: [
			'Indumentaria_1.webm',
			'Indumentaria_2.webm',
			'Indumentaria_3.webm',
			'Indumentaria_4.webm',
			'indumentaria_5.webp',
			'indumentaria_6.webp',
			'indumentaria_7.webp',
		],
		text: 'El diseño ha sido concebido para integrarse sin fricciones en las exigencias del equipamiento militar. Su estructura simplificada estandariza con precisión la producción de parches, insignias bordadas y aplicaciones térmicas sobre los uniformes. La economía de líneas reduce los costes operativos y garantiza una durabilidad excepcional frente al uso intensivo y el desgaste ambiental. Ya sea mediante bordados de alta densidad o termosellados, el emblema preserva una presencia sobria, respetuosa y plenamente distinguible.',
	},
	{
		id: 'entorno',
		label: 'Entorno',
		title: 'Coherencia señalética en LA infraestructura',
		media: [
			'entorno_1.webm',
			'entorno_2.webp',
			'entorno_3.webp',
			'entorno_4.webp',
			'entorno_5.webp',
			'entorno_6.webp',
			'entorno_7.webp',
			'entorno_8.webp',
			'entorno_9.webp',
		],
		text: 'La legibilidad optimizada del símbolo asegura una señalización impecable en hangares, controles de acceso, equipos de comunicación y centros logísticos. A diferencia de los escudos convencionales, propensos a perder definición con el tiempo, este diseño mantiene una claridad absoluta en rótulos metálicos, marcajes pintados o soportes vinílicos. Cada punto de contacto físico proyecta una disciplina institucional unificada y de absoluta solvencia ante la ciudadanía.',
	},
	{
		id: 'promocion',
		label: 'Promoción',
		title: 'Expansión pública y posicionamiento de vanguardia',
		media: ['promocion_1.webm', 'promocion_2.webm', 'promocion_3.webp'],
		text: 'La nueva identidad se acopla con naturalidad a los canales de comunicación contemporáneos, desde producciones audiovisuales hasta plataformas digitales y soportes urbanos. Al potenciar piezas de formato corto y contenidos dinámicos para redes sociales, el sistema refuerza la percepción del SENAN como una fuerza moderna, altamente capacitada y atractiva para las nuevas generaciones. Cada mensaje comunica profesionalismo, disuasión y un firme compromiso con la seguridad nacional.',
	},
	{
		id: 'resumen',
		label: 'Resumen',
		title: 'Una aportación conceptual al servicio de la institución',
		text: 'Este proyecto independiente refleja nuestra visión sobre el potencial de desarrollo y modernización de la identidad visual del Servicio Nacional Aeronaval. Ponemos este trabajo a disposición de las autoridades como una contribución técnica orientada a enaltecer el prestigio de la institución. Si estiman oportuno profundizar en las especificaciones operativas de esta propuesta, estaremos encantados de coordinar una presentación formal.',
	},
];

const textSections = textSectionsData.map((section, index) => {
	const media = section.media?.filter(hasAsset);
	return {
		...section,
		media: media?.length ? media : undefined,
		num: String(index + 5).padStart(2, '0'),
	};
});

const pitchNav = [
	{ id: 'motivacion', num: '01', label: 'Motivación' },
	{ id: 'estandares', num: '02', label: 'Estándares' },
	{ id: 'estrategia', num: '03', label: 'Estrategia' },
	{ id: 'simbolo', num: '04', label: 'Símbolo' },
	...textSections.map(({ id, num, label }) => ({ id, num, label })),
];
---

<PitchLayout
	title="Aeronaval — Propuesta"
	description="Propuesta privada de extensión de identidad visual para el Servicio Nacional Aeronaval por Setin Studio."
	lang="es"
	bodyClass="aero-pitch"
	navLogoSrc="/pitches/aeronaval/nav-lockup.svg"
	navLogoAlt="setin × Aeronaval"
	navLogoWidth={235}
	navLogoHeight={59}
	themeVars={{
		'--pitch-bg': '#0d0e0f',
		'--pitch-fg': '#ffffff',
		'--pitch-accent': '#ffffff',
		'--pitch-font-display': "'Saira', ui-sans-serif, system-ui, sans-serif",
		'--pitch-font-body': "'Public Sans', ui-sans-serif, system-ui, sans-serif",
		'--pitch-font-nav': "'Public Sans', ui-sans-serif, system-ui, sans-serif",
	}}
>
	{/* —— Hero —— */}
	<section id="aero-hero" class="aero-hero relative min-h-[100svh] overflow-hidden" aria-label="Hero" data-pitch-hero>
		<div class="aero-hero__stage" aria-hidden="true" data-pitch-hero-stage>
			<div class="aero-hero__bg-shift" data-pitch-hero-shift>
				<video
					class="aero-hero__bg-video"
					data-toros-video
					autoplay
					muted
					loop
					playsinline
					webkit-playsinline
					preload="auto"
				>
					<source src={asset('hero_bg.webm')} type="video/webm" />
				</video>
			</div>
			<span class="aero-hero__shade"></span>
		</div>

		<div
			class="aero-hero__content relative z-10 flex min-h-[100svh] flex-col px-[var(--pitch-gutter)] pt-24 md:pt-0"
		>
			<div
				class="mx-auto flex w-full max-w-[1100px] flex-1 flex-col items-center justify-center gap-3 text-center text-white md:gap-4"
			>
				<p class="pitch-label">Propuesta</p>
				<h1
					class="pitch-display w-full text-[clamp(1.75rem,6.2vw,3.5rem)] font-normal leading-[1.4] md:whitespace-nowrap md:text-[clamp(1.75rem,4.6vw,3.5rem)]"
					data-pitch-reveal
					data-pitch-lines="La nueva identidad|del Aeronaval"
					data-pitch-lines-desktop="La nueva identidad del Aeronaval"
				>
					La nueva identidad del Aeronaval
				</h1>
				<p class="pitch-body-copy max-w-[42rem] text-white">
					Una evolución gráfica diseñada para potenciar la presencia institucional, modernizar la imagen de la fuerza y consolidar tanto el reconocimiento de marca como el orgullo operativo a nivel global.
				</p>
			</div>

			<div
				class="aero-hero__scroll pointer-events-none flex shrink-0 flex-col items-center pb-[calc(4.25rem+env(safe-area-inset-bottom,0px))] md:absolute md:inset-x-0 md:bottom-10 md:pb-0"
				aria-hidden="true"
			>
				<span class="block h-7 w-px shrink-0 bg-white/80"></span>
				<img
					src={asset('aeronaval_symbol.svg')}
					alt=""
					width="77"
					height="56"
					class="block h-[44px] w-auto shrink-0"
				/>
				<svg width="12" height="8" viewBox="0 0 12 8" fill="none" class="block h-2 w-3 shrink-0">
					<path d="M1 1.5L6 6.5L11 1.5" stroke="white" stroke-width="1.5"></path>
				</svg>
			</div>
		</div>
	</section>

	{/* —— Body (sidebar + content) —— */}
	<div class="toros-body relative z-[2]">
		<div class="mx-auto w-full pt-16 pb-20 md:pt-24 md:pb-28 lg:pt-32 lg:pb-32">
			<div class="grid grid-cols-1 gap-12 lg:grid-cols-[320px_minmax(0,1fr)] lg:gap-0">
				<PitchSidebar items={pitchNav} />

				<div class="toros-body__content flex min-w-0 flex-col gap-0">
					{/* —— 01 / Motivación —— */}
					<section id="motivacion" class="toros-section scroll-mt-32 text-white" aria-label="Motivación">
						<div class="toros-section__pad">
							<PitchSectionLabel num="01" label="Motivación" />
							<h2
								class="pitch-display mt-7 w-full text-[clamp(1.5rem,3.4vw,2.25rem)] font-normal leading-[1.2]"
								data-pitch-reveal
							>
								El origen de Iniciativa conceptual
							</h2>
							<p class="pitch-body-copy mt-6 w-full text-white/85 md:mt-8">
								El escudo tradicional del SENAN es indispensable para preservar el legado histórico, pero
								la institución padece hoy una evidente falta de estandarización visual y una fragmentación
								en su comunicación digital y operativa. La ausencia de un lenguaje gráfico unificado y de
								una estrategia clara de posicionamiento debilita la narrativa de la marca en los canales
								contemporáneos.
							</p>
							<p class="pitch-body-copy mt-5 w-full text-white/85">
								Por esto, desarrollamos una propuesta que estandariza el sistema visual del Aeronaval y
								consolida su posicionamiento como una fuerza moderna, soberana y de élite. Un estándar
								alineado con los modelos de las fuerzas armadas globales, diseñado para proyectar orgullo
								patrio, especialización táctica e innovación a través de una identidad coherente y
								contundente.
							</p>
						</div>
						<figure class="aero-play mt-12 w-full overflow-hidden md:mt-16" data-pitch-play>
							<video
								class="block aspect-video h-auto w-full bg-black object-cover"
								preload="none"
								data-pitch-preload="metadata"
								playsinline
								webkit-playsinline
								aria-label="Video Motivación Aeronaval"
							>
								<source src={`${asset('motivacion_1.mp4')}#t=0.1`} type="video/mp4" />
							</video>
							<button
								type="button"
								class="aero-play__button"
								data-pitch-play-button
								aria-label="Reproducir video con sonido"
							>
								<svg width="28" height="32" viewBox="0 0 28 32" fill="none" aria-hidden="true">
									<path d="M27 16L1 31V1L27 16Z" fill="white"></path>
								</svg>
							</button>
						</figure>
					</section>

					{/* —— 02 / Estándares —— */}
					<section id="estandares" class="toros-section scroll-mt-32 text-white" aria-label="Estándares">
						<div class="toros-section__pad pt-[var(--pitch-section-y)]">
							<PitchSectionLabel num="02" label="Estándares" />
							<h2
								class="pitch-display mt-7 w-full text-[clamp(1.5rem,3.4vw,2.25rem)] font-normal leading-[1.2]"
								data-pitch-reveal
							>
								La evolución en la referencia internacional
							</h2>
							<p class="pitch-body-copy mt-6 w-full text-white/85 md:mt-8">
								A nivel global, las fuerzas armadas de referencia implementan transformaciones en sus
								sistemas de identidad para resolver problemas estructurales críticos, optimizar la
								funcionalidad y unificar su presencia institucional.
							</p>

							<ul class="mt-14 flex flex-col gap-14 md:mt-20 md:gap-16 lg:gap-20">
								{
									cases.map((item) => (
										<li class="toros-value__case">
											<div class="toros-value__case-logo">
												<img
													src={item.logo}
													alt={item.logoAlt}
													width="300"
													height="100"
													class="toros-case-logo"
													loading="lazy"
												/>
											</div>
											<h3
												class="toros-value__case-title pitch-display font-normal leading-[1.25]"
												data-pitch-reveal
												data-pitch-lines={item.titleLines}
												data-pitch-lines-desktop={item.title}
											>
												{item.title}
											</h3>
											<p class="toros-value__case-text pitch-body-copy text-white/85">{item.text}</p>
										</li>
									))
								}
							</ul>
						</div>
					</section>

					{/* —— 03 / Estrategia —— */}
					<section id="estrategia" class="toros-section scroll-mt-32 text-white" aria-label="Estrategia">
						<div class="toros-section__pad pt-[var(--pitch-section-y)]">
							<PitchSectionLabel num="03" label="Estrategia" />
							<h2
								class="pitch-display mt-7 w-full text-[clamp(1.5rem,3.4vw,2.25rem)] font-normal leading-[1.2]"
								data-pitch-reveal
							>
								Síntesis de herencia y evolución operativa
							</h2>
							<p class="pitch-body-copy mt-6 w-full text-white/85 md:mt-8">
								Nuestra aproximación metodológica se fundamenta en la evolución y no en la sustitución:
								cada elemento del nuevo sistema visual brota directamente del escudo tradicional para
								transformarlo en una herramienta funcional y contemporánea. Esta extensión respetuosa honra
								el legado de la institución sin borrarlo, resolviendo la falta de estandarización previa
								mediante un lenguaje gráfico unificado que sitúa al SENAN a la vanguardia de las fuerzas de
								seguridad globales, proyectando pericia técnica, disciplina y solvencia profesional en
								cualquier escenario.
							</p>
						</div>
						{
							hasAsset('estrategia_1.webp') && (
								<figure class="mt-12 w-full overflow-hidden md:mt-16">
									<img
										src={asset('estrategia_1.webp')}
										alt="Del escudo al símbolo"
										width="3345"
										height="2298"
										class="block h-auto w-full"
										loading="lazy"
										decoding="async"
									/>
								</figure>
							)
						}
					</section>

					{/* —— 04 / Símbolo (sticky mark + scroll swap) —— */}
					<PitchSimbolo
						num="04"
						steps={simboloSteps}
						visualWidth={224}
						visualHeight={165}
						stageWidth={300}
						stageMobileWidth="min(224px, 60vw)"
						surface="#17181c"
						class="pt-[var(--pitch-section-y)]"
					>
						{
							simboloMedia.map((item) => (
								<figure class="w-full overflow-hidden">
									{item.file.endsWith('.webm') ? (
										<video
											class="block h-auto w-full"
											data-toros-video
											muted
											loop
											playsinline
											webkit-playsinline
											preload="none"
											aria-label={item.alt}
										>
											<source src={asset(item.file)} type="video/webm" />
										</video>
									) : (
										<img
											src={asset(item.file)}
											alt={item.alt}
											width={item.width}
											height={item.height}
											class="block h-auto w-full"
											loading="lazy"
										/>
									)}
								</figure>
							))
						}
					</PitchSimbolo>

					{/* —— 05–09 —— */}
					{
						textSections.map((section) => (
							<section
								id={section.id}
								class="toros-section scroll-mt-32 text-white"
								aria-label={section.label}
							>
								<div class="toros-section__pad pt-[var(--pitch-section-y)]">
									<PitchSectionLabel num={section.num} label={section.label} />
									<h2
										class="pitch-display mt-7 w-full text-[clamp(1.5rem,3.4vw,2.25rem)] font-normal leading-[1.2]"
										data-pitch-reveal
									>
										{section.title}
									</h2>
									<p class="pitch-body-copy mt-6 w-full text-white/85 md:mt-8">{section.text}</p>
								</div>
								{section.media && (
									<div class="aero-media-stack mt-12 md:mt-16">
										{section.media.map((file) => (
											<figure class="w-full overflow-hidden">
												{file.endsWith('.webp') ? (
													<img
														src={asset(file)}
														alt={section.label}
														width="1760"
														height="1328"
														class="block h-auto w-full"
														loading="lazy"
														decoding="async"
													/>
												) : (
												<video
													class="block h-auto w-full"
													data-toros-video
													muted
													loop
													playsinline
													webkit-playsinline
													preload="none"
													aria-label={section.label}
												>
													<source src={asset(file)} type="video/webm" />
												</video>
												)}
											</figure>
										))}
									</div>
								)}
							</section>
						))
					}
				</div>
			</div>
		</div>
	</div>

	<script>
		import { initTorosNav } from '../../scripts/initTorosNav.ts';
		import { initTorosVideos } from '../../scripts/initTorosVideos.ts';
		import { initPitchBlurReveal } from '../../scripts/initPitchBlurReveal.ts';
		import { initTorosSidebar } from '../../scripts/initTorosSidebar.ts';
		import { initPitchPlayVideo } from '../../scripts/initPitchPlayVideo.ts';
		import { initSimboloSwap } from '../../scripts/initSimboloSwap.ts';
		import { initPitchHeroParallax } from '../../scripts/initPitchHeroParallax.ts';

		initTorosNav();
		initTorosVideos();
		initPitchBlurReveal();
		initSimboloSwap();
		initTorosSidebar();
		initPitchPlayVideo();
		initPitchHeroParallax();
	</script>
</PitchLayout>

<style>
	:global(.aero-pitch .pitch-root) {
		--pitch-gutter: 20px;
	}

	@media (width >= 768px) {
		:global(.aero-pitch .pitch-root) {
			--pitch-gutter: 60px;
		}
	}

	/* —— Hero —— */
	.aero-hero {
		z-index: 0;
	}

	.aero-hero__stage {
		position: fixed;
		inset: 0;
		z-index: 0;
		width: 100%;
		height: 100svh;
		background: #0d0e0f;
		pointer-events: none;
