---
import PitchLayout from '../../layouts/PitchLayout.astro';

const asset = (file: string) => `/pitches/toros-dechiriqui/${file}`;

const simboloSteps = [
	{
		label: 'Símbolo',
		title: 'Geometría diseñada para dominar',
		text: 'Sintetizamos fuerza y precisión mediante trazos angulares y planos firmes. Enfatizamos los cuernos y una postura frontal para asegurar presencia dominante en la pista y un equilibrio visual perfecto.',
		visual: 'simbolo-0.svg',
	},
	{
		title: 'La baloncesto',
		text: 'El balón en la parte inferior actúa como una extensión anatómica del toro, sintetizado en solo ocho planos geométricos. Esta solución comunica de forma directa e inmediata la disciplina deportiva del club.',
		visual: 'simbolo-1.svg',
	},
	{
		title: 'La cabeza del toro',
		text: 'Construida con formas geométricas fundamentales para garantizar su reconocimiento a distancia. Su expresión evita la agresividad desmedida y los rasgos cómicos, apostando por un carácter estoico que transmite confianza y respeto.',
		visual: 'simbolo-2.svg',
	},
	{
		title: 'La estrella',
		text: 'Una estrella solitaria representa la identidad local sin recargar el diseño con las catorce estrellas de la bandera provincial. Este detalle aporta rigor a la arquitectura de marca y refuerza el vínculo con Chiriquí.',
		visual: 'simbolo-3.svg',
	},
	{
		title: 'Contorno estructural',
		text: 'Sintetizamos fuerza, movimiento y precisión mediante trazos angulares y planos firmes. Enfatizamos los cuernos y una postura de combate frontal para asegurar una presencia dominante en la pista y un equilibrio visual perfecto.',
		visual: 'simbolo-4.svg',
	},
];

const cases = [
	{
		logo: asset('logo-anadolu.svg'),
		logoAlt: 'Anadolu Efes',
		logoClass: 'w-[100px] sm:w-[126px]',
		title: 'Anadolu Efes',
		titleLines: 'Anadolu|Efes',
		text: 'La actualización integral de la marca y su adaptación a entornos digitales generó un incremento del 711% en las ventas de merchandising, un aumento del 11% en ingresos por patrocinio con la entrada de marcas globales, y un crecimiento del 120% en la asistencia al pabellón.',
	},
	{
		logo: asset('logo-euroleague.svg'),
		logoAlt: 'Euroleague Basketball',
		logoClass: 'w-[120px] sm:w-[154px]',
		title: 'Euroleague basketball',
		titleLines: 'Euroleague|basketball',
		text: 'La unificación de la identidad digital en los clubes de la EuroLiga impulsó un crecimiento del 40% en los ingresos de mercado de los equipos a lo largo de 3 temporadas, destacando un aumento del 30% en patrocinios comerciales y un 85% en facturación durante los días de partido.',
	},
	{
		logo: asset('logo-bucks.svg'),
		logoAlt: 'Milwaukee Bucks',
		logoClass: 'w-[100px] sm:w-[130px]',
		title: 'Milwaukee Bucks',
		titleLines: 'Milwaukee|Bucks',
		text: 'La franquicia transformó su emblema en 2015 mediante un símbolo más agresivo, geométrico y limpio. La implementación del nuevo sistema visual permitió superar los $10 millones de dólares anuales en ventas de mercancía oficial.',
	},
	{
		logo: asset('logo-hornets.svg'),
		logoAlt: 'Charlotte Hornets',
		logoClass: 'w-[120px] sm:w-[161px]',
		title: 'Charlotte Hornets',
		titleLines: 'Charlotte|Hornets',
		text: 'En 2014, el equipo ejecutó un rediseño integral para cerrar la etapa de los Bobcats y recuperar su identidad histórica en un formato modernizado. El impacto gráfico permitió incrementar un 300% la venta de indumentaria en su primera temporada y escalar seis posiciones en la asistencia al pabellón, superando las métricas registradas en años anteriores.',
	},
];

const pitchNav = [
	{ id: 'motivacion', num: '01', label: 'Motivación' },
	{ id: 'valor', num: '02', label: 'Valor' },
	{ id: 'estrategia', num: '03', label: 'Estrategia' },
	{ id: 'simbolo', num: '04', label: 'Símbolo' },
	{ id: 'logotipo', num: '05', label: 'Logotipo' },
	{ id: 'home-kit', num: '06', label: 'Home Kit' },
	{ id: 'away-kit', num: '07', label: 'Away Kit' },
	{ id: 'merchandising', num: '08', label: 'Merch' },
	{ id: 'promocion', num: '09', label: 'Promoción' },
	{ id: 'futuro', num: '10', label: 'Futuro' },
];
---

<PitchLayout
	title="Toros de Chiriquí — Propuesta de Rebranding"
	description="Propuesta privada de rebranding para Toros de Chiriquí por Setin Studio."
	lang="es"
	bodyClass="toros-pitch"
	navLogoSrc="/pitches/toros-dechiriqui/nav-lockup.svg"
	navLogoAlt="setin × TOROS"
	navLogoWidth={297}
	navLogoHeight={59}
	themeVars={{
		'--pitch-bg': '#0b140f',
		'--pitch-fg': '#ffffff',
		'--pitch-accent': '#a4ff00',
		'--pitch-font-display': "'Science Gothic', ui-sans-serif, system-ui, sans-serif",
		'--pitch-font-body': "'Montserrat', ui-sans-serif, system-ui, sans-serif",
		'--pitch-font-nav': "'Montserrat', ui-sans-serif, system-ui, sans-serif",
	}}
>
	{/* —— Hero —— */}
	<section
		id="toros-hero"
		class="toros-hero relative min-h-[100svh] overflow-hidden"
		aria-label="Hero"
	>
		<div class="toros-hero__stage" aria-hidden="true">
			<img
				src={asset('bg.webp')}
				alt=""
				class="toros-hero__bg-image"
				width="3275"
				height="2026"
			/>
		</div>

		<div
			class="toros-hero__content relative z-10 flex min-h-[100svh] flex-col px-[var(--pitch-gutter)] pt-24 md:pt-0"
		>
			<div
				class="toros-hero__copy mx-auto flex w-full max-w-[843px] flex-1 flex-col items-center justify-center gap-3 text-center text-white md:gap-4"
			>
				<p class="pitch-label">Propuesta de&nbsp;Rebranding</p>
				<h1
					class="pitch-display w-full text-[clamp(1.75rem,6.2vw,3.5rem)] font-normal leading-[1.4] md:whitespace-nowrap"
					data-pitch-reveal
					data-pitch-lines="La Nueva Era|del Toro"
					data-pitch-lines-desktop="La Nueva Era del Toro"
				>
					La Nueva Era del Toro
				</h1>
				<p class="pitch-body-copy max-w-[42rem] text-white">
					En&nbsp;Setin&nbsp;Studio&nbsp;rediseñamos&nbsp;la&nbsp;identidad visual&nbsp;de&nbsp;Toros&nbsp;de&nbsp;Chiriquí&nbsp;para&nbsp;transformar su&nbsp;legado&nbsp;en&nbsp;un&nbsp;activo&nbsp;comercial de&nbsp;alto&nbsp;impacto.
				</p>
			</div>

			<div
				class="toros-hero__scroll pointer-events-none flex shrink-0 flex-col items-center pb-[calc(4.25rem+env(safe-area-inset-bottom,0px))] md:absolute md:inset-x-0 md:bottom-10 md:pb-0"
				aria-hidden="true"
			>
				<span class="block h-7 w-px shrink-0 bg-white/80"></span>
				<img
					src={asset('scroll-bull.svg')}
					alt=""
					width="56"
					height="60"
					class="toros-hero__scroll-bull block h-[60px] w-14 shrink-0"
				/>
				<img
					src={asset('scroll-arrow.svg')}
					alt=""
					width="12"
					height="8"
					class="toros-hero__scroll-arrow block h-2 w-3 shrink-0"
				/>
			</div>
		</div>
	</section>

	{/* —— Body (project-analog: sidebar + content) —— */}
	<div class="toros-body relative z-[2]">
		<div
			class="toros-body__container mx-auto w-full pt-16 pb-20 md:pt-24 md:pb-28 lg:pt-32 lg:pb-32"
		>
			<div
				class="toros-body__layout grid grid-cols-1 gap-12 lg:grid-cols-[320px_minmax(0,1fr)] lg:gap-0"
			>
				<aside
					class="toros-sidebar relative hidden self-stretch pl-[var(--pitch-gutter)] pr-6 lg:block"
					data-toros-sidebar
				>
					<div class="toros-sidebar__inner sticky top-[calc(var(--pitch-nav-offset,6.5rem)+3.5rem)]">
						<nav class="toros-sidebar__nav" aria-label="Secciones de la propuesta">
							{
								pitchNav.map((item, idx) => (
									<a
										href={`#${item.id}`}
										class:list={['toros-sidebar__link', idx === 0 && 'is-active']}
										data-toros-section-target={item.id}
									>
										<span class="toros-sidebar__index">{item.num}&nbsp;/&nbsp;</span>
										<span class="toros-sidebar__name">{item.label}</span>
									</a>
								))
							}
						</nav>
					</div>
				</aside>

				{/* Mobile section nav */}
				<div
					class="toros-sidebar-mobile fixed inset-x-0 bottom-0 z-40 border-0 bg-[#0d0e0f]/95 px-[var(--pitch-gutter)] backdrop-blur-md transition-all duration-500 lg:hidden"
					data-toros-sidebar-mobile
				>
					<div
						id="toros-mobile-dropdown"
						class="toros-sidebar-mobile__dropdown grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-in"
						data-toros-mobile-nav-dropdown
					>
						<div class="overflow-hidden">
							<nav
								class="toros-sidebar-mobile__nav flex max-h-[60vh] flex-col gap-[18px] overflow-y-auto pb-5 pt-4"
								aria-label="Secciones de la propuesta (móvil)"
							>
								{
									pitchNav.map((item, idx) => (
										<a
											href={`#${item.id}`}
											class:list={['toros-sidebar__link', idx === 0 && 'is-active']}
											data-toros-section-target={item.id}
										>
											<span class="toros-sidebar__index">{item.num}&nbsp;/&nbsp;</span>
											<span class="toros-sidebar__name">{item.label}</span>
										</a>
									))
								}
							</nav>
						</div>
					</div>
					<button
						type="button"
						class="flex w-full items-center justify-between py-3.5 pb-[max(0.875rem,env(safe-area-inset-bottom))] text-left uppercase"
						aria-expanded="false"
						aria-controls="toros-mobile-dropdown"
						data-toros-mobile-nav-trigger
					>
						<span class="toros-sidebar-mobile__current">
							<span class="toros-sidebar__index" data-toros-mobile-current-num>
								{pitchNav[0].num}&nbsp;/&nbsp;
							</span>
							<span class="toros-sidebar__name is-active" data-toros-mobile-current-label>
								{pitchNav[0].label}
							</span>
						</span>
						<svg
							width="14"
							height="14"
							viewBox="0 0 14 14"
							fill="none"
							xmlns="http://www.w3.org/2000/svg"
							class="toros-sidebar-mobile__chevron shrink-0"
							aria-hidden="true"
						>
							<path d="M1 3.5L7 9.5L13 3.5" stroke="currentColor" stroke-width="2"></path>
						</svg>
					</button>
				</div>

				<div class="toros-body__content flex min-w-0 flex-col gap-0">
					{/* —— Intro / Motivación (Intro.pdf) —— */}
					<section
						id="motivacion"
						class="toros-section toros-intro scroll-mt-32 text-white"
						aria-label="Motivación"
					>
						<div class="toros-section__pad">
							<div class="toros-section__label">
								<span class="toros-section__num">01&nbsp;/&nbsp;</span>
								<span class="toros-section__label-name">Motivación</span>
							</div>
							<h2
								class="pitch-display mt-7 w-full text-[clamp(1.5rem,3.4vw,2.25rem)] font-normal leading-[1.2]"
								data-pitch-reveal
							>
								Una identidad a la altura de sus ambiciones
							</h2>
							<div class="pitch-body-copy mt-6 flex w-full flex-col gap-5 text-white/85 md:mt-8">
								<p>
									Somos un estudio de diseño independiente. Creamos marcas, productos y sistemas
									digitales concebidos para perdurar y generar resultados de negocio claros.
								</p>
								<p>
									Decidimos desarrollar esta propuesta para Toros de Chiriquí porque la energía de su
									marca y la fidelidad de su afición nos sirvieron de inspiración directa.
									Identificamos en la institución una fuerza genuina que merece un sistema gráfico de
									nivel internacional. Nuestro trabajo transforma esa identidad en una herramienta
									comercial precisa, diseñada para unificar la comunicación del club, incrementar el
									valor de los patrocinios y acelerar las ventas de indumentaria en cada punto de
									contacto.
								</p>
							</div>
						</div>
						<figure class="toros-section__visual mt-12 w-full overflow-hidden md:mt-16">
							<img
								src={asset('intro-flag.webp')}
								alt="Bandera Toros de Chiriquí"
								width="1536"
								height="1536"
								class="block h-auto w-full object-cover"
								loading="lazy"
							/>
						</figure>
					</section>

					{/* —— Valor / Business examples —— */}
					<section
						id="valor"
						class="toros-section toros-value scroll-mt-32 text-white"
						aria-label="Valor"
					>
						<div class="toros-section__pad pt-[var(--pitch-section-y)]">
						<div class="toros-section__label">
							<span class="toros-section__num">02&nbsp;/&nbsp;</span>
							<span class="toros-section__label-name">Valor</span>
						</div>
						<h2
							class="pitch-display mt-7 w-full text-[clamp(1.5rem,3.4vw,2.25rem)] font-normal leading-[1.2]"
							data-pitch-reveal
							data-pitch-lines="El futuro del|baloncesto comienza|en Chiriquí"
							data-pitch-lines-desktop="El futuro del baloncesto comienza en|Chiriquí"
						>
							El futuro del baloncesto comienza en Chiriquí
						</h2>
						<p class="pitch-body-copy mt-6 w-full text-white/85 md:mt-8">
							El rediseño de marca en el deporte profesional cada vez responde a un impulso
							puramente estético. Para una franquicia en desarrollo, representa una palanca de
							negocio capaz de multiplicar el valor de los patrocinios, acelerar la venta de
							indumentaria y ampliar el alcance digital. Un sistema gráfico preciso unifica la
							arquitectura de la organización, abre nuevas vías de ingresos y consolida el
							patrimonio institucional a largo plazo.
						</p>

						<ul class="toros-value__cases mt-14 flex flex-col gap-14 md:mt-20 md:gap-16 lg:gap-20">
							{
								cases.map((item) => (
									<li class="toros-value__case">
										<div class="toros-value__case-logo">
											<img
												src={item.logo}
												alt={item.logoAlt}
												class:list={['toros-case-logo', item.logoClass]}
												loading="lazy"
											/>
										</div>
										<h3
											class="toros-value__case-title pitch-display font-normal leading-[1.25]"
											data-pitch-reveal
											data-pitch-lines={item.titleLines}
											data-pitch-lines-desktop={item.title}
										>
											{item.title}
										</h3>
										<p class="toros-value__case-text pitch-body-copy text-white/85">{item.text}</p>
									</li>
								))
							}
						</ul>
						</div>
					</section>

					{/* —— Strategy (Strategy.pdf) —— */}
					<section
						id="estrategia"
						class="toros-section toros-strategy scroll-mt-32 text-white"
						aria-label="Estrategia"
					>
						<div class="toros-section__pad pt-[var(--pitch-section-y)]">
							<div class="toros-section__label">
								<span class="toros-section__num">03&nbsp;/&nbsp;</span>
								<span class="toros-section__label-name">Estrategia</span>
							</div>
							<h2
								class="pitch-display mt-7 w-full text-[clamp(1.5rem,3.4vw,2.25rem)] font-normal leading-[1.2]"
								data-pitch-reveal
								data-pitch-lines="Diagnóstico de marca y|dirección estratégica"
								data-pitch-lines-desktop="Diagnóstico de marca y dirección|estratégica"
							>
								Diagnóstico de marca y dirección estratégica
							</h2>
							<p class="pitch-body-copy mt-6 w-full text-white/85 md:mt-8">
								La identidad histórica de Toros de Chiriquí dependía de gráficos obsoletos que
								limitaban el crecimiento comercial de la institución. Identificamos deficiencias graves
								en la escalabilidad del logotipo en pantallas móviles, inconsistencia tipográfica en
								soportes impresos y una baja legibilidad del escudo durante las transmisiones en
								directo. Nuestro objetivo fue construir un sistema visual rotundo que conserve la
								esencia del club mientras responde a las exigencias de producción actuales. Eliminamos
								la ornamentación innecesaria a favor de una geometría limpia, logrando una figura de
								impacto inmediato.
							</p>
						</div>
						<figure class="toros-section__visual mt-12 w-full overflow-hidden md:mt-16">
							<img
								src={asset('strategy-ball.webp')}
								alt="Balón Toros de Chiriquí"
								width="4096"
								height="3058"
								class="block h-auto w-full object-cover"
								loading="lazy"
							/>
						</figure>
					</section>

					{/* —— Símbolo (sticky mark + scroll swap) —— */}
					<section
						id="simbolo"
						class="toros-section toros-simbolo scroll-mt-32 text-white"
						aria-label="Símbolo"
						style={`--simbolo-steps: ${simboloSteps.length}`}
					>
						<div class="toros-simbolo__scroller" data-simbolo-scroller>
							<div class="toros-section__pad toros-simbolo__grid">
								<div class="toros-section__label toros-simbolo__mobile-label lg:hidden">
									<span class="toros-section__num">04&nbsp;/&nbsp;</span>
									<span class="toros-section__label-name">Símbolo</span>
								</div>

								<div class="toros-simbolo__stage-wrap">
									<div class="toros-simbolo__stage" aria-hidden="true">
										{
											simboloSteps.map((step, index) => (
												<img
													src={asset(step.visual)}
													alt=""
													width="260"
													height="280"
													class:list={['toros-simbolo__visual', index === 0 && 'is-active']}
													data-simbolo-visual={index}
													loading={index === 0 ? 'eager' : 'lazy'}
													aria-hidden={index === 0 ? 'false' : 'true'}
												/>
											))
										}
									</div>
								</div>

								<div class="toros-simbolo__copy">
									<div class="toros-section__label toros-simbolo__desktop-label hidden lg:block">
										<span class="toros-section__num">04&nbsp;/&nbsp;</span>
										<span class="toros-section__label-name">Símbolo</span>
									</div>
									<div class="toros-simbolo__steps">
										{
											simboloSteps.map((step, index) => (
												<article
													class:list={['toros-simbolo__step', index === 0 && 'is-active']}
													data-simbolo-step={index}
												>
													<h2 class="pitch-display w-full text-[clamp(1.35rem,2.8vw,2rem)] font-normal leading-[1.2]">
														{step.title}
													</h2>
													<p class="pitch-body-copy w-full text-white/85">{step.text}</p>
												</article>
											))
										}
									</div>
								</div>
							</div>
						</div>

						<figure class="toros-section__visual toros-simbolo__crest w-full overflow-hidden">
							<img
								src={asset('simbolo-crest.webp')}
								alt="Escudo Toros bordado"
								width="1252"
								height="935"
								class="block h-auto w-full object-cover"
								loading="lazy"
							/>
						</figure>
					</section>

					{/* —— Logotipo —— */}
	<section
		id="logotipo"
		class="toros-logotipo relative z-[2] scroll-mt-32"
		aria-label="Logotipo"
	>
		<div
			class="mx-auto flex max-w-[1440px] flex-col px-[var(--pitch-gutter)] pb-[clamp(2.5rem,6vw,3.75rem)] pt-[var(--pitch-section-y)] text-white lg:px-[120px]"
		>
			<div class="toros-section__label">
				<span class="toros-section__num">05&nbsp;/&nbsp;</span>
				<span class="toros-section__label-name">Logotipo</span>
			</div>
			<h2
				class="pitch-display mt-7 w-full max-w-[52rem] text-[clamp(1.35rem,2.8vw,2.125rem)] font-normal leading-[1.25] md:mt-8"
				data-pitch-reveal
			>
				Rotulación artesanal con carácter deportivo
			</h2>
			<div class="pitch-body-copy mt-6 flex max-w-[52rem] flex-col gap-5 text-white/85 md:mt-8">
				<p>
					El logotipo fue dibujado a mano desde cero, tomando como referencia la tradición gráfica de
					los clubes de baloncesto profesionales. La estructura se apoya en una letra T inicial de
					gran escala que da paso a trazos caligráficos fluidos en el resto de la palabra. Aplicamos
					una inclinación diagonal precisa para otorgar al conjunto una sensación de velocidad y
					dinamismo en la cancha.
				</p>
				<p>
					El rasgo distintivo del diseño reside en los remates de cada carácter, donde integramos
					cortes angulares que evocan la forma de los cuernos del toro. El resultado es un activo
					tipográfico exclusivo que conserva una visibilidad impecable en composiciones
					monocromáticas, impresiones textiles, plataformas publicitarias digitales y soportes de
					gran formato.
				</p>
			</div>
		</div>
		<figure class="relative w-full overflow-hidden">
			<video
				class="block h-auto w-full"
				data-toros-video
				autoplay
				muted
				loop
				playsinline
				webkit-playsinline
				preload="auto"
				aria-label="Wordmark TOROS"
			>
				<source src={asset('Torors-Logotype.webm')} type="video/webm" />
			</video>
		</figure>
	</section>

	{/* —— Home Kit (Home Kit.pdf / HomeKit_Mobile.pdf) —— */}
	<section
		id="home-kit"
		class="toros-home-kit relative z-[2] scroll-mt-32"
		aria-label="Home Kit"
	>
		<div
