---
import PitchLayout from '../../layouts/PitchLayout.astro';

const asset = (file: string) => `/pitches/toros-dechiriqui/${file}`;

const navLinks = [
	{ href: '#estrategia', id: 'estrategia', label: 'Strategia' },
	{ href: '#simbolo', id: 'simbolo', label: 'Símbolo' },
	{ href: '#logotipo', id: 'logotipo', label: 'Logotipo' },
	{ href: '#home-kit', id: 'home-kit', label: 'Home Kit' },
	{ href: '#away-kit', id: 'away-kit', label: 'Away Kit' },
	{ href: '#merchandising', id: 'merchandising', label: 'Merchandising' },
	{ href: '#promocion', id: 'promocion', label: 'Promoción' },
];

const simboloSteps = [
	{
		label: 'Símbolo',
		title: 'Geometría diseñada para dominar',
		text: 'El nuevo símbolo sintetiza fuerza, movimiento y precisión geométrica. Eliminamos la ilustración recargada y los detalles complejos que perdían nitidez en las plataformas digitales actuales. En su lugar, construimos la figura del toro mediante trazos angulares y planos firmes, enfatizando los cuernos y una postura de combate frontal. Esta estructura otorga una presencia dominante en la pista y asegura un equilibrio visual perfecto.',
		visual: 'simbolo-0.svg',
	},
	{
		title: 'La baloncesto',
		text: 'El balón de baloncesto en la parte inferior del escudo actúa como una extensión anatómica natural del torso del toro. La cabeza masiva del animal se transforma de forma fluida en la pelota, la cual se sintetiza en únicamente ocho planos geométricos primarios. Esta solución directa comunica de manera inmediata y sin interferencias la disciplina deportiva del club.',
		visual: 'simbolo-1.svg',
	},
	{
		title: 'La cabeza del toro',
		text: 'La cabeza del toro está construida a partir de formas geométricas fundamentales para garantizar el reconocimiento inmediato del símbolo a gran distancia. En el plano anatómico, la expresión facial evita conscientemente tanto la agresividad desmedida como los rasgos cómicos. Apostamos por un carácter serio, stoico y sobrio que transmite confianza y exige respeto hacia la organización.',
		visual: 'simbolo-2.svg',
	},
	{
		title: 'La estrella',
		text: 'Como un guiño discreto a la identidad local, el diseño incorpora una estrella solitaria y bien definida. Este elemento sustituye la representación literal de las catorce estrellas de la bandera provincial, cuya concentración masiva habría fragmentado la geometría del símbolo. La estrella funciona como un indicador clásico y sobrio de orgullo territorial. Es un detalle que demuestra el rigor en la arquitectura de la marca, elevando el valor percibido del club y reforzando su vínculo con la provincia de Chiriquí.',
		visual: 'simbolo-3.svg',
	},
	{
		title: 'Contorno estructural',
		text: 'Un contorno exterior unificado integra todos los elementos en una sola estructura sólida. Esta solución técnica evita que los detalles individuales parezcan flotar en el espacio, otorgando al escudo un acabado compacto y ejecutado bajo los más altos estándares. Gracias a esta forma cerrada, el símbolo alcanza una adaptabilidad total, permitiendo su aplicación sobre cualquier fondo, textura, soporte textil o plataforma digital sin comprometer el contraste ni la legibilidad.',
		visual: 'simbolo-4.svg',
	},
];

const cases = [
	{
		logo: asset('logo-anadolu.svg'),
		logoAlt: 'Anadolu Efes',
		logoClass: 'w-[100px] sm:w-[126px]',
		title: 'Anadolu Efes',
		text: 'La actualización integral de la marca y su adaptación a entornos digitales generó un incremento del 711% en las ventas de merchandising, un aumento del 11% en ingresos por patrocinio con la entrada de marcas globales, y un crecimiento del 120% en la asistencia al pabellón.',
	},
	{
		logo: asset('logo-euroleague.svg'),
		logoAlt: 'Euroleague Basketball',
		logoClass: 'w-[120px] sm:w-[154px]',
		title: 'Euroleague basketball',
		text: 'La unificación de la identidad digital en los clubes de la EuroLiga impulsó un crecimiento del 40% en los ingresos de mercado de los equipos a lo largo de 3 temporadas, destacando un aumento del 30% en patrocinios comerciales y un 85% en facturación durante los días de partido.',
	},
	{
		logo: asset('logo-bucks.svg'),
		logoAlt: 'Milwaukee Bucks',
		logoClass: 'w-[100px] sm:w-[130px]',
		title: 'Milwaukee Bucks',
		text: 'La franquicia transformó su emblema en 2015 mediante un símbolo más agresivo, geométrico y limpio. La implementación del nuevo sistema visual permitió superar los $10 millones de dólares anuales en ventas de mercancía oficial.',
	},
	{
		logo: asset('logo-hornets.svg'),
		logoAlt: 'Charlotte Hornets',
		logoClass: 'w-[120px] sm:w-[161px]',
		title: 'Charlotte Hornets',
		text: 'En 2014, el equipo ejecutó un rediseño integral para cerrar la etapa de los Bobcats y recuperar su identidad histórica en un formato modernizado. El impacto gráfico permitió incrementar un 300% la venta de indumentaria en su primera temporada y escalar seis posiciones en la asistencia al pabellón, superando las métricas registradas en años anteriores.',
	},
];
---

<PitchLayout
	title="Toros de Chiriquí — Propuesta de Rebranding"
	description="Propuesta privada de rebranding para Toros de Chiriquí por Setin Studio."
	lang="es"
	bodyClass="toros-pitch"
	themeVars={{
		'--pitch-bg': '#0b140f',
		'--pitch-fg': '#ffffff',
		'--pitch-accent': '#a4ff00',
		'--pitch-font-display': "'Science Gothic', ui-sans-serif, system-ui, sans-serif",
		'--pitch-font-body': "'Montserrat', ui-sans-serif, system-ui, sans-serif",
		'--pitch-font-nav': "'Montserrat', ui-sans-serif, system-ui, sans-serif",
	}}
>
	{/* —— Custom pitch navbar (Figma 6052:64) —— */}
	<header id="pitch-nav" class="toros-nav fixed inset-x-0 top-0 z-40">
		<div
			class="toros-nav__inner flex items-center justify-between gap-8 px-[var(--pitch-gutter)] py-8 md:py-10"
		>
			<a href="/" class="toros-nav__brand shrink-0" aria-label="Setin × Toros">
				<img
					src={asset('nav-lockup.svg')}
					alt="setin × TOROS"
					width="297"
					height="59"
					class="h-10 w-auto md:h-[59px]"
				/>
			</a>

			<nav
				class="toros-nav__links relative hidden min-w-0 flex-1 items-center justify-center overflow-hidden px-5 lg:flex"
				aria-label="Secciones de la propuesta"
			>
				{
					navLinks.map((link) => (
						<a href={link.href} class="toros-nav__link" data-section={link.id}>
							{link.label}
						</a>
					))
				}
			</nav>

			<a href="#contact" class="toros-nav__cta shrink-0">Contacta nos</a>
		</div>
	</header>

	{/* —— Hero (Figma 6039:569) —— */}
	<section
		id="toros-hero"
		class="toros-hero relative min-h-[100svh] overflow-hidden"
		aria-label="Hero"
	>
		<div class="toros-hero__stage" aria-hidden="true">
			<img
				src={asset('hero-bg.webp')}
				alt=""
				class="toros-hero__bg-image"
				width="1440"
				height="891"
			/>
			{/* Figma 6080:8642 */}
			<div
				class="toros-hero__gradient"
				style="background-image: linear-gradient(180deg, rgba(11, 20, 15, 0.7) 0%, rgba(11, 20, 15, 0.011) 33.407%, rgba(11, 20, 15, 0.6) 64.478%, rgb(11, 20, 15) 100%)"
			></div>
		</div>

		<div
			class="toros-hero__content relative z-10 flex min-h-[100svh] flex-col justify-end px-[var(--pitch-gutter)] pb-16 pt-36 md:pb-[60px]"
		>
			<div class="mx-auto flex max-w-[843px] flex-col items-center gap-3 text-center text-white">
				<p class="pitch-label">Propuesta de Rebranding</p>
				<h1
					class="pitch-display w-full text-[clamp(1.75rem,6.2vw,3.5rem)] font-normal leading-[1.4] md:whitespace-nowrap"
					data-pitch-reveal
					data-pitch-lines="La Nueva|Era del Toro"
					data-pitch-lines-desktop="La Nueva Era del Toro"
				>
					La Nueva Era del Toro
				</h1>
				<p class="pitch-body-copy max-w-[42rem] text-white">
					En Setin Studio rediseñamos la identidad visual de Toros de Chiriquí
					<br class="hidden sm:block" aria-hidden="true" />
					para transformar su legado en un activo comercial de alto impacto.
				</p>
				<div class="mt-1 flex flex-col items-center gap-1" aria-hidden="true">
					<span class="h-4 w-px bg-white/80"></span>
					<img
						src={asset('scroll-bull.svg')}
						alt=""
						width="72"
						height="78"
						class="h-[78px] w-[72px]"
					/>
					<span class="h-4 w-px bg-gradient-to-b from-white/80 to-transparent"></span>
				</div>
			</div>
		</div>
	</section>

	{/* —— Intro / Motivación —— */}
	<section
		id="motivacion"
		class="toros-intro relative z-[2] overflow-hidden bg-[#0b140f] px-[var(--pitch-gutter)] pb-[60px] pt-[var(--pitch-section-y)]"
	>
		<img
			src={asset('intro-line.svg')}
			alt=""
			class="pointer-events-none absolute -left-[40%] top-0 w-[180%] max-w-none opacity-80"
			aria-hidden="true"
		/>
		<div
			class="relative mx-auto grid max-w-[1320px] gap-10 md:grid-cols-2 md:gap-[60px] md:px-10 lg:px-40"
		>
			<div class="flex flex-col gap-[26px] uppercase text-white">
				<p class="pitch-label">Motivación</p>
				<h2
					class="pitch-display w-full max-w-none text-[clamp(1.25rem,2.4vw,1.75rem)] font-normal leading-[1.4] md:max-w-[470px]"
					data-pitch-reveal
				>
					Una identidad a la altura de sus ambiciones
				</h2>
			</div>
			<div class="pitch-body-copy flex flex-col justify-end gap-5 text-white">
				<p>
					Somos un estudio de diseño independiente. Creamos marcas, productos y sistemas digitales
					concebidos para perdurar y generar resultados de negocio claros.
				</p>
				<p>
					Decidimos desarrollar esta propuesta para Toros de Chiriquí porque la energía de su marca y
					la fidelidad de su afición nos sirvieron de inspiración directa. Identificamos en la
					institución una fuerza genuina que merece un sistema gráfico de nivel internacional.
					Nuestro trabajo transforma esa identidad en una herramienta comercial precisa, diseñada
					para unificar la comunicación del club, incrementar el valor de los patrocinios y acelerar
					las ventas de indumentaria en cada punto de contacto.
				</p>
			</div>
		</div>
		<figure class="relative mx-auto mt-[clamp(4rem,10vw,7.5rem)] max-w-[1320px] overflow-hidden">
			<img
				src={asset('intro-flag.webp')}
				alt="Bandera Toros de Chiriquí"
				width="1320"
				height="884"
				class="aspect-[1320/884] h-auto w-full object-cover"
				loading="lazy"
			/>
		</figure>
	</section>

	{/* —— Business value —— */}
	<section
		id="valor"
		class="toros-value relative z-[2] bg-[#111a15] px-[var(--pitch-gutter)] py-[var(--pitch-section-y)] md:px-16 lg:px-40 xl:px-56"
	>
		<div
			class="toros-value__grid mx-auto grid max-w-[1320px] grid-cols-1 gap-16 lg:grid-cols-[minmax(320px,0.42fr)_minmax(0,1fr)] lg:items-start lg:gap-x-24 xl:gap-x-32"
		>
			<div
				class="toros-value__sticky flex w-full flex-col gap-[26px] text-white lg:sticky lg:top-[calc(var(--pitch-nav-offset,8.5rem)+2.5rem)] lg:self-start"
			>
				<p class="pitch-label">Mas que un imagen</p>
				<h2
					class="pitch-display w-full text-[clamp(1.25rem,2.4vw,1.75rem)] font-normal leading-[1.4]"
					data-pitch-reveal
				>
					El futuro del baloncesto comienza en Chiriquí
				</h2>
			</div>

			<div class="toros-value__scroll flex min-w-0 flex-col gap-[clamp(3rem,8vw,5.625rem)]">
				<p class="pitch-body-copy text-white">
					El rediseño de marca en el deporte profesional cada vez responde a un impulso puramente
					estético. Para una franquicia en desarrollo, representa una palanca de negocio capaz de
					multiplicar el valor de los patrocinios, acelerar la venta de indumentaria y ampliar el
					alcance digital. Un sistema gráfico preciso unifica la arquitectura de la organización,
					abre nuevas vías de ingresos y consolida el patrimonio institucional a largo plazo.
				</p>

				<ul class="flex flex-col gap-[clamp(3rem,6vw,5.625rem)]">
					{
						cases.map((item) => (
							<li class="flex flex-col gap-8 sm:flex-row sm:items-center sm:gap-[60px]">
								<div class="flex w-full shrink-0 items-center justify-center sm:w-40">
									<img
										src={item.logo}
										alt={item.logoAlt}
										class:list={['toros-case-logo h-auto w-auto object-contain', item.logoClass]}
										loading="lazy"
									/>
								</div>
								<div class="flex min-w-0 flex-1 flex-col gap-[30px] text-white">
									<h3
										class="pitch-display text-[clamp(1.05rem,1.5vw,1.25rem)] font-normal leading-[1.4]"
										data-pitch-reveal
									>
										{item.title}
									</h3>
									<p class="pitch-body-copy">{item.text}</p>
								</div>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</section>

	{/* —— Strategy —— */}
	<section id="estrategia" class="toros-strategy relative z-[2] bg-[#0b140f]">
		<div class="mx-auto grid max-w-[1440px] lg:grid-cols-2">
			<div
				class="flex flex-col gap-[26px] px-[var(--pitch-gutter)] py-[var(--pitch-section-y)] text-white lg:pl-40 lg:pr-20"
			>
				<p class="pitch-label">Strategia</p>
				<h2
					class="pitch-display text-[clamp(1.25rem,2.4vw,1.75rem)] font-normal leading-[1.4]"
					data-pitch-reveal
				>
					Diagnóstico de marca y dirección estratégica
				</h2>
				<div class="pitch-body-copy flex flex-col gap-5">
					<p>
						La identidad histórica de Toros de Chiriquí dependía de gráficos obsoletos que limitaban
						el crecimiento comercial de la institución. Identificamos deficiencias graves en la
						escalabilidad del logotipo en pantallas móviles, inconsistencia tipográfica en soportes
						impresos y una baja legibilidad del escudo durante las transmisiones en directo.
					</p>
					<p>
						Nuestro objetivo fue construir un sistema visual rotundo que conserve la esencia del
						club mientras responde a las exigencias de producción actuales. Eliminamos la
						ornamentación innecesaria a favor de una geometría limpia, logrando una figura de
						impacto inmediato.
					</p>
				</div>
			</div>
			<figure class="relative min-h-[420px] lg:min-h-full">
				<img
					src={asset('strategy-ball.webp')}
					alt="Balón Toros de Chiriquí"
					width="600"
					height="708"
					class="absolute inset-0 h-full w-full object-cover"
					loading="lazy"
				/>
			</figure>
		</div>
	</section>

	{/* —— Símbolo —— */}
	<section
		id="simbolo"
		class="toros-simbolo relative z-[2] scroll-mt-32 bg-[#111a15] px-[var(--pitch-gutter)] pt-[var(--pitch-section-y)]"
		aria-label="Símbolo"
	>
		<div
			class="toros-simbolo__grid mx-auto grid max-w-[1200px] grid-cols-1 gap-12 pb-[var(--pitch-section-y)] lg:grid-cols-[minmax(260px,280px)_minmax(0,1fr)] lg:items-start lg:gap-x-[100px] lg:gap-y-16 lg:pb-[max(var(--pitch-section-y),calc(50vh-150px))]"
		>
			{/* Desktop sticky swap stage — hidden on mobile (per-step visuals below) */}
			<div
				class="toros-simbolo__stage relative mx-auto hidden h-[300px] w-[280px] lg:sticky lg:top-[max(calc(var(--pitch-nav-offset,7.5rem)+1.5rem),calc(50vh-150px))] lg:mx-0 lg:block lg:self-start"
			>
				{
					simboloSteps.map((step, index) => (
						<img
							src={asset(step.visual)}
							alt=""
							width="280"
							height="300"
							class:list={['toros-simbolo__visual', index === 0 && 'is-active']}
							data-simbolo-visual={index}
							aria-hidden={index === 0 ? 'false' : 'true'}
						/>
					))
				}
			</div>

			<div class="toros-simbolo__steps flex flex-col gap-[clamp(3.5rem,10vw,5.625rem)]">
				{
					simboloSteps.map((step, index) => (
						<article
							class:list={[
								'toros-simbolo__step flex flex-col justify-center gap-[30px] text-white',
								index < simboloSteps.length - 1
									? 'min-h-0 lg:min-h-[min(70vh,520px)]'
									: 'min-h-0 pb-0',
							]}
							data-simbolo-step={index}
						>
							<figure class="toros-simbolo__mobile-visual mx-auto flex h-[240px] w-[220px] items-center justify-center lg:hidden">
								<img
									src={asset(step.visual)}
									alt=""
									width="220"
									height="240"
									class="h-full w-full object-contain"
									loading={index === 0 ? 'eager' : 'lazy'}
									aria-hidden="true"
								/>
							</figure>
							{step.label ? <p class="pitch-label">{step.label}</p> : null}
							<h2
								class:list={[
									'pitch-display font-normal leading-[1.4]',
									index === 0
										? 'text-[clamp(1.25rem,2.4vw,1.75rem)]'
										: 'text-[clamp(1.1rem,1.8vw,1.25rem)]',
								]}
								data-pitch-reveal
							>
								{step.title}
							</h2>
							<p class="pitch-body-copy max-w-[38rem]">{step.text}</p>
						</article>
					))
				}
			</div>
		</div>

		<figure class="relative mx-auto aspect-[1252/935] w-full max-w-[1252px] overflow-hidden">
			<img
				src={asset('simbolo-crest.webp')}
				alt="Escudo Toros bordado"
				width="1252"
				height="935"
				class="h-full w-full object-cover"
				loading="lazy"
			/>
		</figure>
	</section>

	{/* —— Logotipo (Figma 6059:276) —— */}
	<section
		id="logotipo"
		class="toros-logotipo relative z-[2] scroll-mt-32 bg-[#0b140f]"
		aria-label="Logotipo"
	>
		<div
			class="mx-auto flex max-w-[1440px] flex-col gap-[26px] px-[var(--pitch-gutter)] py-[var(--pitch-section-y)] text-white lg:px-40"
		>
			<p class="pitch-label">Logotipo</p>
			<div class="grid gap-10 lg:grid-cols-[minmax(0,526px)_minmax(0,1fr)] lg:gap-[60px]">
				<h2
					class="pitch-display text-[clamp(1.25rem,2.4vw,2.125rem)] font-normal leading-[1.4]"
					data-pitch-reveal
				>
					Rotulación artesanal con carácter deportivo
				</h2>
				<div class="pitch-body-copy flex flex-col justify-end gap-5">
					<p>
						El logotipo fue dibujado a mano desde cero, tomando como referencia la tradición gráfica
						de los clubes de baloncesto profesionales. La estructura se apoya en una letra T inicial
						de gran escala que da paso a trazos caligráficos fluidos en el resto de la palabra.
						Aplicamos una inclinación diagonal precisa para otorgar al conjunto una sensación de
						velocidad y dinamismo en la cancha.
					</p>
					<p>
						El rasgo distintivo del diseño reside en los remates de cada carácter, donde integramos
						cortes angulares que evocan la forma de los cuernos del toro. El resultado es un activo
						tipográfico exclusivo que conserva una visibilidad impecable en composiciones
						monocromáticas, impresiones textiles, plataformas publicitarias digitales y soportes de
						gran formato.
					</p>
				</div>
			</div>
		</div>
		<figure class="relative w-full overflow-hidden bg-[#111a15]">
			<video
				class="block h-auto w-full"
				data-toros-video
				autoplay
				muted
				loop
				playsinline
				webkit-playsinline
				preload="auto"
				aria-label="Wordmark TOROS"
			>
				<source src={asset('logotipo-wordmark.webm')} type="video/webm" />
			</video>
		</figure>
	</section>

	{/* —— Home Kit (Figma 6059:6697) —— */}
	<section
		id="home-kit"
		class="toros-home-kit relative z-[2] scroll-mt-32 bg-[#0b140f]"
		aria-label="Home Kit"
	>
		<div
			class="mx-auto flex max-w-[1440px] flex-col items-start gap-12 px-[var(--pitch-gutter)] pb-[60px] pt-[var(--pitch-section-y)] lg:flex-row lg:gap-10 lg:px-[120px]"
		>
			<div class="flex w-full flex-col gap-[26px] text-white lg:max-w-[400px] lg:shrink-0">
				<p class="pitch-label">Home Kit</p>
				<h2
					class="pitch-display text-[clamp(1.25rem,2.4vw,2.125rem)] font-normal leading-[1.4]"
					data-pitch-reveal
				>
					Volcanic lava
				</h2>
				<p class="pitch-body-copy">
					Diseñamos una camiseta que responde a la profundidad pura de nuestra naturaleza. Su concepto
					no se dibuja, brota como la lava desde lo más profundo de nuestra tierra, de la misma forma
					en que nuestras ambiciones, el valor y el orgullo emergen de este territorio para dominar
					cada cancha. Es la encarnación del calor del Volcán Barú y de la presión interna de un
					equipo que no espera la suerte, sino que rompe la resistencia. Los trazos fluidos en el
					pecho son magma vivo en movimiento, los laterales en borgoña oscuro son la roca firme que
					sostiene esa fuerza. Salir a jugar con esta camiseta es vestir el fuego puro de Chiriquí.
				</p>
