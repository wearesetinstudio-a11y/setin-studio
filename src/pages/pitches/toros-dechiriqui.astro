		flex-direction: column;
		align-items: stretch;
		justify-content: flex-start;
		gap: 0;
		height: calc(
			100svh - var(--pitch-nav-offset, 6.5rem) - 4.75rem - env(safe-area-inset-bottom, 0px)
		);
		max-height: calc(
			100svh - var(--pitch-nav-offset, 6.5rem) - 4.75rem - env(safe-area-inset-bottom, 0px)
		);
		overflow: clip;
		touch-action: pan-y;
		background: #111a15;
		/* Clear previous-section media + keep label fully visible */
		padding-top: 1.75rem;
		padding-bottom: 0.5rem;
		box-sizing: border-box;
	}

	.toros-simbolo__mobile-label {
		flex: 0 0 auto;
	}

	.toros-simbolo__grid > .toros-simbolo__mobile-label {
