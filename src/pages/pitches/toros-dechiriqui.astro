	/* Pin mark + copy; scroll progress swaps steps in place (blur crossfade).
	   Mobile: center the PDF-spaced stack in the sticky viewport.
	   overflow: clip (not hidden) so touch pan scrolls the page, not a dead nested scroller. */
	.toros-simbolo__scroller {
		height: calc(var(--simbolo-steps, 5) * 85svh);
