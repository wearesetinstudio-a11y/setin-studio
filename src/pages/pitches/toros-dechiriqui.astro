		opacity: 1;
	}

	.toros-simbolo__desktop-label {
		flex: 0 0 auto;
	}

	.toros-simbolo__copy > .toros-simbolo__desktop-label {
		margin: 0 0 1.25rem;
	}

	.toros-simbolo__copy {
		flex: 0 0 auto;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 0;
		touch-action: pan-y;
		pointer-events: none;
	}

	/* Stack all steps in one cell → height = tallest step → no reflow / symbol jump */
	.toros-simbolo__steps {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		flex: 0 0 auto;
		min-width: 0;
		overflow: clip;
