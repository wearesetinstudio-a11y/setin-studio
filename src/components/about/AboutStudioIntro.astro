<section id="about-studio-intro" class="about-studio-intro relative z-10 bg-[#131415] px-[var(--page-gutter)] pt-[var(--section-padding-y)] pb-[60px]">
	<div class="grid min-w-0 gap-6 md:grid-cols-2 md:gap-20 lg:gap-24">
		<h2
			id="about-studio-heading"
			class="about-studio-intro__heading min-w-0 w-full max-w-full uppercase leading-[1.15] md:max-w-lg"
		>
			<span data-reveal-line data-i18n="aboutPage.introHeading">Setin Studio is a digital product studio built on vision and execution.</span>
		</h2>

		<div class="body-txt-1 about-studio-intro__body min-w-0 leading-relaxed text-setin-muted">
			<p data-i18n="aboutPage.introBody1">
				As brothers, we have developed a unique collaborative way of working, that allows us to
				move fast, eliminate friction, and stay completely consistent. Operating as a specialized
				digital studio, we focus on transforming businesses through strategic branding,
				user-centric UI/UX design, and premium development.
			</p>
			<p class="mt-6" data-i18n="aboutPage.introBody2">
				We don't believe in one size and all fits services. Instead, we partner with you to craft
				custom digital tools, scalable platforms, and brand identities that mean something to your
				audience and bring measurable value to your business.
			</p>
		</div>
	</div>
</section>

<style is:global>
	.about-studio-intro__heading {
		overflow-wrap: break-word;
		line-height: 1.15;
		max-width: 100%;
	}

	.about-studio-intro__body {
		max-width: 100%;
		overflow-wrap: break-word;
	}
</style>

<script>
	function wrapLetters(element: HTMLElement) {
		if (element.querySelector('.reveal-char')) return;

		const text = element.textContent ?? '';
		element.textContent = '';

		for (const char of text) {
			const span = document.createElement('span');
			span.className = 'reveal-char';
			span.textContent = char === ' ' ? ' ' : char;
			element.appendChild(span);
		}
	}

	function updateAboutStudioHeadingReveal() {
		const heading = document.getElementById('about-studio-heading');
		if (!heading) return;

		const chars = heading.querySelectorAll('.reveal-char');
		if (!chars.length) return;

		const rect = heading.getBoundingClientRect();
		const viewportHeight = window.innerHeight;
		const startLine = viewportHeight * 0.88;
		const endLine = viewportHeight * 0.45;
		const range = startLine - endLine;
		const progress = Math.min(1, Math.max(0, (startLine - rect.top) / range));
		const activeCount = Math.ceil(progress * chars.length);

		chars.forEach((char, index) => {
			char.classList.toggle('active', index < activeCount);
		});
	}

	let scrollTicking = false;

	function onAboutStudioScroll() {
		if (scrollTicking) return;
		scrollTicking = true;
		requestAnimationFrame(() => {
			updateAboutStudioHeadingReveal();
			scrollTicking = false;
		});
	}

	function initAboutStudioIntro() {
		const heading = document.getElementById('about-studio-heading');
		const section = document.getElementById('about-studio-intro');

		if (heading) {
			heading.querySelectorAll('[data-reveal-line]').forEach((line) => {
				wrapLetters(line as HTMLElement);
			});

			if (heading.dataset.scrollReady !== 'true') {
				heading.dataset.scrollReady = 'true';
				window.addEventListener('scroll', onAboutStudioScroll, { passive: true });
				window.addEventListener('resize', updateAboutStudioHeadingReveal, { passive: true });
			}
		}

		updateAboutStudioHeadingReveal();

		if (!section || section.dataset.revealObserved === 'true') return;

		section.dataset.revealObserved = 'true';

		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) updateAboutStudioHeadingReveal();
				}
			},
			{ threshold: [0, 0.25, 0.5, 0.75, 1] },
		);

		observer.observe(section);
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initAboutStudioIntro, { once: true });
	} else {
		initAboutStudioIntro();
	}

	document.addEventListener('astro:page-load', initAboutStudioIntro);
</script>
