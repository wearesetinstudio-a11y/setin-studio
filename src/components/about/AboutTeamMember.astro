---
interface Props {
	name: string;
	role: string;
	bio: string;
	roleKey?: string;
	bioKey?: string;
	imageSrc: string;
	imageAlt: string;
	links: { label: string; href: string }[];
	align?: 'start' | 'end';
}

const { name, role, bio, roleKey, bioKey, imageSrc, imageAlt, links, align = 'start' } = Astro.props;
---

<article
	class:list={[
		'about-team-member flex flex-col gap-12 md:flex-row md:items-start md:gap-x-20 lg:gap-x-24',
		align === 'end' && 'about-team-member--end',
	]}
>
	{
		align === 'end' && (
			<div class="about-team-member__spacer hidden min-w-0 md:block md:flex-1" aria-hidden="true" />
		)
	}

	<div
		class="about-team-member__photo-wrap relative w-full overflow-hidden md:h-[400px] md:w-[320px] md:shrink-0"
		data-team-photo-wrap
	>
		<div class="about-team-member__parallax-layer pointer-events-none absolute inset-x-0">
			<img
				src={imageSrc}
				alt={imageAlt}
				width="320"
				height="400"
				class="about-team-member__photo h-full w-full object-cover grayscale"
				loading="lazy"
				decoding="async"
			/>
		</div>
	</div>

	<div class="about-team-member__content min-w-0 md:max-w-[540px] md:shrink-0 md:pt-1">
		<h2 class="about-team-member__heading uppercase text-setin-fg">
			<span class="font-semibold">{name}</span>
			<span class="ml-4 font-normal text-setin-fg/80" data-i18n={roleKey}>{role}</span>
		</h2>

		<p class="body-txt-1 about-team-member__bio mt-8 leading-relaxed text-setin-fg" data-i18n={bioKey}>{bio}</p>

		<div class="mt-10 flex flex-wrap gap-x-10 gap-y-3">
			{
				links.map((link) => (
					<a
						href={link.href}
						class="about-team-member__link text-[1rem] font-semibold uppercase text-setin-muted transition-opacity hover:opacity-70"
						target="_blank"
						rel="noopener noreferrer"
					>
						{link.label}
					</a>
				))
			}
		</div>
	</div>

	{
		align === 'start' && (
			<div class="about-team-member__spacer hidden min-w-0 md:block md:flex-1" aria-hidden="true" />
		)
	}
</article>

<style is:global>
	.about-team-member__photo-wrap {
		aspect-ratio: 4 / 5;
	}

	.about-team-member__parallax-layer {
		top: -4%;
		height: 108%;
		will-change: transform;
	}

	.about-team-member__heading {
		font-size: 1.2rem;
		line-height: 1.3;
	}

	.about-team-member__bio {
		overflow-wrap: break-word;
	}

	@media (max-width: 767px) {
		.about-team-member__heading {
			overflow-wrap: break-word;
		}
	}
</style>

<script>
	function initAboutTeamMemberParallax() {
		const wraps = document.querySelectorAll('[data-team-photo-wrap]');

		wraps.forEach((wrap) => {
			if (wrap.dataset.parallaxInit === 'true') return;

			const layer = wrap.querySelector('.about-team-member__parallax-layer');
			if (!layer) return;

			wrap.dataset.parallaxInit = 'true';

			const PARALLAX_SPEED = 0.14;
			const MAX_SHIFT_RATIO = 0.04;

			function updateParallax() {
				const containerHeight = wrap.offsetHeight;
				const maxShift = containerHeight * MAX_SHIFT_RATIO;
				const scrollOffset = -wrap.getBoundingClientRect().top;
				const rawOffset = scrollOffset * PARALLAX_SPEED;
				const offset = Math.max(-maxShift * 0.2, Math.min(maxShift * 0.55, rawOffset));

				layer.style.transform = `translate3d(0, ${offset}px, 0)`;
			}

			let ticking = false;

			function onScroll() {
				if (ticking) return;
				ticking = true;
				requestAnimationFrame(() => {
					updateParallax();
					ticking = false;
				});
			}

			updateParallax();
			window.addEventListener('scroll', onScroll, { passive: true });
			window.addEventListener('resize', updateParallax, { passive: true });
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initAboutTeamMemberParallax, { once: true });
	} else {
		initAboutTeamMemberParallax();
	}

	document.addEventListener('astro:page-load', initAboutTeamMemberParallax);
</script>
