<section id="about-hero" class="about-hero relative min-h-[68vh] overflow-hidden md:min-h-[96vh]">
	<div id="about-hero-visual" class="about-hero-visual absolute inset-0 overflow-hidden">
		<div
			id="about-hero-parallax-layer"
			class="about-hero-parallax__layer pointer-events-none absolute inset-x-0"
		>
			<picture>
				<source srcset="/brothers-intro.webp" type="image/webp" />
				<img
					src="/brothers-intro.webp"
					alt="The two founders of Setin Studio"
					width="1920"
					height="1080"
					class="about-hero-parallax__image h-full w-full object-cover object-[center_22%] grayscale"
					loading="eager"
					decoding="async"
				/>
			</picture>
		</div>

		<canvas
			id="about-hero-noise-filter"
			class="pointer-events-none absolute inset-0 z-[2] block h-full w-full bg-transparent"
			aria-hidden="true"
		></canvas>

		<div
			class="about-hero__overlay pointer-events-none absolute inset-0 z-[1] bg-[#131415]/10"
			aria-hidden="true"
		></div>
	</div>

	<div class="relative z-10 flex min-h-[68vh] items-end px-[var(--page-gutter)] pb-14 pt-28 md:min-h-[96vh] md:pb-16">
		<h1
			id="hero-headline"
			class="about-hero__title about-hero-headline max-w-4xl uppercase text-setin-fg"
			data-about-hero-headline
			data-raw-text={'Two brothers,\none vision'}
		>
			Two brothers, one vision
		</h1>
	</div>
</section>

<style is:global>
	.about-hero-parallax__layer {
		top: -4%;
		height: 108%;
		will-change: transform;
	}

	.about-hero-parallax__image {
		transform: scale(1.06);
		transform-origin: center 22%;
	}

	.about-hero__title {
		line-height: 1.3;
	}

	@media (min-width: 768px) {
		.about-hero__title {
			font-size: 3rem;
		}
	}

	@media (max-width: 767px) {
		.about-hero-parallax__layer {
			top: 0;
			height: 100%;
		}

		.about-hero-parallax__image {
			object-fit: cover;
			object-position: center 8%;
			transform: scale(1);
			transform-origin: center 8%;
		}
	}

	.about-hero-headline:not([data-prepared]) {
		opacity: 0;
	}

	.about-hero-headline .hero-reveal-mask {
		display: block;
		overflow: hidden;
		padding-top: 0.08em;
	}

	.about-hero-headline .hero-reveal-line {
		display: block;
		transform: translateY(110%);
		opacity: 0;
		transition:
			transform 1200ms cubic-bezier(0.16, 1, 0.3, 1),
			opacity 1200ms cubic-bezier(0.16, 1, 0.3, 1);
		transition-delay: calc(var(--i, 0) * 90ms);
	}

	.about-hero-headline .hero-reveal-line.is-revealed {
		transform: translateY(0);
		opacity: 1;
	}
</style>

<script>
	import { initCinemaPureNoise } from '../../scripts/initCinemaPureNoise.ts';
	import { splitIntoRevealLines, waitForPageReveal } from '../../scripts/lineSlideUpReveal.ts';

	function initAboutHeroParallax() {
		const visual = document.getElementById('about-hero-visual');
		const layer = document.getElementById('about-hero-parallax-layer');
		if (!visual || !layer || visual.dataset.parallaxInit === 'true') return;

		visual.dataset.parallaxInit = 'true';

		const PARALLAX_SPEED = 0.16;
		const MAX_SHIFT_RATIO = 0.045;

		function updateParallax() {
			const containerHeight = visual.offsetHeight;
			const maxShift = containerHeight * MAX_SHIFT_RATIO;
			const scrollOffset = -visual.getBoundingClientRect().top;
			const rawOffset = scrollOffset * PARALLAX_SPEED;
			const offset = Math.max(-maxShift * 0.2, Math.min(maxShift * 0.55, rawOffset));

			layer.style.transform = `translate3d(0, ${offset}px, 0)`;
		}

		let ticking = false;

		function onScroll() {
			if (ticking) return;
			ticking = true;
			requestAnimationFrame(() => {
				updateParallax();
				ticking = false;
			});
		}

		updateParallax();
		window.addEventListener('scroll', onScroll, { passive: true });
		window.addEventListener('resize', updateParallax, { passive: true });
	}

	function prepareAboutHeroCopy() {
		const headline = document.querySelector<HTMLElement>('[data-about-hero-headline]');
		if (!headline) return;

		splitIntoRevealLines(headline, {
			fixedLines: true,
			alreadyRevealed: headline.dataset.revealed === 'true',
		});
		headline.dataset.prepared = 'true';
	}

	function revealAboutHeroText() {
		const headline = document.querySelector<HTMLElement>('[data-about-hero-headline]');
		if (!headline || headline.dataset.revealed === 'true') return;

		if (headline.dataset.prepared !== 'true') {
			prepareAboutHeroCopy();
		}

		void headline.offsetWidth;

		requestAnimationFrame(() => {
			if (headline.dataset.revealed === 'true') return;
			headline.dataset.revealed = 'true';
			headline.querySelectorAll('.hero-reveal-line').forEach((element) => {
				element.classList.add('is-revealed');
			});
		});
	}

	function initAboutHeroReveal() {
		const hero = document.getElementById('about-hero');
		if (!hero || hero.dataset.heroRevealInit === 'true') return;

		hero.dataset.heroRevealInit = 'true';
		prepareAboutHeroCopy();
		waitForPageReveal(revealAboutHeroText);
	}

	function initAboutHero() {
		if (!document.getElementById('about-hero')) return;
		initAboutHeroParallax();
		initAboutHeroReveal();
		initCinemaPureNoise('about-hero-noise-filter', { observeElementId: 'about-hero-visual' });
	}

	document.addEventListener('astro:page-load', initAboutHero);
</script>
