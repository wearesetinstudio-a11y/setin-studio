---
import { FOUNDERS_PHOTO_ALTS } from '../../utils/projectImageAlt';
---

<section id="about-hero" class="about-hero relative min-h-[95svh] overflow-hidden md:min-h-[96vh]">
	<div
		id="about-hero-visual"
		class="about-hero-visual pointer-events-none fixed inset-x-0 top-0 isolate z-0 w-full overflow-hidden bg-[#131415]"
	>
		<div class="about-hero-photo-shift">
			<picture class="absolute inset-0">
				<source srcset="/images/brothers-intro.webp" type="image/webp" />
				<img
					src="/images/brothers-intro.webp"
					alt={FOUNDERS_PHOTO_ALTS.en}
					width="2400"
					height="1604"
					class="about-hero-photo h-full w-full grayscale"
					loading="eager"
					decoding="async"
					fetchpriority="high"
					data-alts={JSON.stringify(FOUNDERS_PHOTO_ALTS)}
				/>
			</picture>
		</div>

		<canvas
			id="about-hero-noise-filter"
			class="pointer-events-none absolute inset-0 z-[2] block h-full w-full bg-transparent"
			aria-hidden="true"
		></canvas>

		<div
			class="about-hero__overlay pointer-events-none absolute inset-0 z-[1] bg-[#131415]/10"
			aria-hidden="true"
		></div>
	</div>

	<div class="about-hero__copy relative z-10 flex min-h-[95svh] items-end px-[var(--page-gutter)] pb-14 pt-28 md:min-h-[96vh] md:pb-16">
		<h1
			id="hero-headline"
			class="about-hero__title about-hero-headline max-w-4xl uppercase text-setin-fg"
			data-about-hero-headline
			data-i18n="aboutPage.hero"
		>
			Two brothers, one vision
		</h1>
	</div>
</section>

<style is:global>
	.about-hero-visual.is-hidden {
		opacity: 0;
		visibility: hidden;
	}

	.about-hero-visual {
		height: 100vh;
		height: 100svh;
	}

	.about-hero-photo-shift {
		position: absolute;
		inset: 0;
		will-change: transform;
	}

	.about-hero-photo {
		object-fit: cover;
		object-position: center 22%;
	}

	@media (min-width: 768px) {
		.about-hero-photo {
			transform: scale(1.4);
			transform-origin: center 12%;
		}
	}

	.about-hero__title {
		line-height: 1.3;
	}

	@media (min-width: 768px) {
		.about-hero__title {
			font-size: 3rem;
		}
	}

	@media (max-width: 767px) {
		.about-hero {
			min-height: 95svh;
		}

		/* Mobile: fixed bg, no parallax — image stays in place while scrolling. */
		.about-hero-visual {
			height: 95svh;
			min-height: 95svh;
		}

		.about-hero__copy {
			height: 95svh;
			min-height: 95svh;
		}

		.about-hero-photo-shift {
			inset: 0;
			height: 100%;
			will-change: auto;
		}

		.about-hero-photo {
			object-fit: cover;
			object-position: center 15%;
			transform: none;
		}
	}

	@media (max-width: 767px) and (orientation: landscape) {
		.about-hero {
			min-height: 100svh;
		}

		.about-hero-visual,
		.about-hero__copy {
			height: 100svh;
			min-height: 100svh;
		}

		.about-hero-photo {
			object-position: center center;
		}
	}

	.about-hero-headline:not([data-prepared]) {
		opacity: 0;
	}

	.about-hero-headline .hero-reveal-mask {
		display: block;
		overflow: hidden;
		padding-top: 0.08em;
	}

	.about-hero-headline .hero-reveal-line {
		display: block;
		transform: translateY(110%);
		opacity: 0;
		transition:
			transform 1200ms cubic-bezier(0.16, 1, 0.3, 1),
			opacity 1200ms cubic-bezier(0.16, 1, 0.3, 1);
		transition-delay: calc(var(--i, 0) * 90ms);
	}

	.about-hero-headline .hero-reveal-line.is-revealed {
		transform: translateY(0);
		opacity: 1;
	}
</style>

<script>
	import { initCinemaPureNoise } from '../../scripts/initCinemaPureNoise.ts';
	import {
		fixedStageOffset,
		getParallaxSpeed,
		isParallaxMobile,
		onParallaxScroll,
	} from '../../scripts/initSlowBgParallax.ts';
	import { splitIntoRevealLines, waitForPageReveal } from '../../scripts/lineSlideUpReveal.ts';

	function initAboutHeroVisual() {
		const hero = document.getElementById('about-hero');
		const visual = document.getElementById('about-hero-visual');
		if (!hero || !visual || hero.dataset.heroVisualInit === 'true') return;

		hero.dataset.heroVisualInit = 'true';

		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const shift = visual.querySelector<HTMLElement>('.about-hero-photo-shift');

		const syncHeroVisual = () => {
			const rect = hero.getBoundingClientRect();
			visual.classList.toggle('is-hidden', rect.bottom <= 0);
			// Mobile: fixed only — no parallax motion.
			if (!shift || reduceMotion || isParallaxMobile()) {
				if (shift) shift.style.transform = 'translate3d(0, 0, 0)';
				return;
			}
			const speed = getParallaxSpeed();
			shift.style.transform = `translate3d(0, ${fixedStageOffset(rect.top, speed)}px, 0)`;
		};

		onParallaxScroll(syncHeroVisual)();
	}

	function prepareAboutHeroCopy() {
		const headline = document.querySelector<HTMLElement>('[data-about-hero-headline]');
		if (!headline) return;

		splitIntoRevealLines(headline, {
			fixedLines: true,
			alreadyRevealed: headline.dataset.revealed === 'true',
		});
		headline.dataset.prepared = 'true';
	}

	function revealAboutHeroText() {
		const headline = document.querySelector<HTMLElement>('[data-about-hero-headline]');
		if (!headline || headline.dataset.revealed === 'true') return;

		if (headline.dataset.prepared !== 'true') {
			prepareAboutHeroCopy();
		}

		void headline.offsetWidth;

		requestAnimationFrame(() => {
			if (headline.dataset.revealed === 'true') return;
			headline.dataset.revealed = 'true';
			headline.querySelectorAll('.hero-reveal-line').forEach((element) => {
				element.classList.add('is-revealed');
			});
		});
	}

	function initAboutHeroReveal() {
		const hero = document.getElementById('about-hero');
		if (!hero || hero.dataset.heroRevealInit === 'true') return;

		hero.dataset.heroRevealInit = 'true';
		prepareAboutHeroCopy();
		waitForPageReveal(revealAboutHeroText);
	}

	function initAboutHero() {
		if (!document.getElementById('about-hero')) return;
		initAboutHeroVisual();
		initAboutHeroReveal();
		initCinemaPureNoise('about-hero-noise-filter', { observeElementId: 'about-hero' });
	}

	document.addEventListener('astro:page-load', initAboutHero);
	window.addEventListener('setin:language-change', () => {
		const headline = document.querySelector<HTMLElement>('[data-about-hero-headline]');
		if (!headline) return;
		const wasRevealed = headline.dataset.revealed === 'true';
		delete headline.dataset.prepared;
		prepareAboutHeroCopy();
		if (wasRevealed) {
			headline.dataset.revealed = 'true';
			headline.querySelectorAll('.hero-reveal-line').forEach((element) => {
				element.classList.add('is-revealed');
			});
		}
	});
</script>
