	.mobile-nav-panel__cta .work-with-us-button span {
		font-size: 2rem;
		line-height: 1.15;
	}

	.mobile-nav-link--current {
		color: rgba(255, 255, 255, 0.5) !important;
		opacity: 1;
	}

	/* Former gap-8 (2rem) → link padding; negative margin keeps outer spacing */
	.mobile-nav-links {
		gap: 0;
		margin-block: -1rem;
	}

	.mobile-nav-link {
		display: inline-flex;
		align-self: flex-start;
		padding-block: 1rem;
		padding-inline: 0.5rem;
		margin-inline: -0.5rem;
	}

	.mobile-nav-panel {
		pointer-events: none;
		visibility: hidden;
		overscroll-behavior: none;
		touch-action: none;
	}

	.mobile-nav-bars {
		display: flex;
		width: 100%;
		height: 100%;
	}

	.mobile-nav-bar {
		flex: 1 1 0;
		min-width: 0;
		height: 100%;
		margin-right: -1px;
		background-color: var(--theme-color, #131415);
		transform: translateY(-100%);
	}

	.mobile-nav-bar:last-child {
		margin-right: 0;
	}

	.mobile-nav-bar:nth-child(1) {
		--bar-delay: 0s;
		--bar-hide-delay: 0.45s;
	}
	.mobile-nav-bar:nth-child(2) {
		--bar-delay: 75ms;
		--bar-hide-delay: 0.375s;
	}
	.mobile-nav-bar:nth-child(3) {
		--bar-delay: 0.15s;
		--bar-hide-delay: 0.3s;
	}
	.mobile-nav-bar:nth-child(4) {
		--bar-delay: 0.225s;
		--bar-hide-delay: 0.225s;
	}
	.mobile-nav-bar:nth-child(5) {
		--bar-delay: 0.3s;
		--bar-hide-delay: 0.15s;
	}
	.mobile-nav-bar:nth-child(6) {
		--bar-delay: 0.375s;
		--bar-hide-delay: 75ms;
	}
	.mobile-nav-bar:nth-child(7) {
		--bar-delay: 0.45s;
		--bar-hide-delay: 0s;
	}

	.mobile-nav-panel.is-active {
		pointer-events: auto;
		visibility: visible;
	}

	.mobile-nav-panel.is-open .mobile-nav-bar,
	.mobile-nav-panel.is-covered .mobile-nav-bar,
	.mobile-nav-panel.is-closing .mobile-nav-bar,
	.mobile-nav-panel.is-covering .mobile-nav-bar,
	.mobile-nav-panel.is-revealing .mobile-nav-bar {
		will-change: transform;
	}

	.mobile-nav-panel.is-open .mobile-nav-bar,
	.mobile-nav-panel.is-covered .mobile-nav-bar,
	.mobile-nav-panel.is-closing .mobile-nav-bar {
		transform: translateY(0);
	}

	.mobile-nav-panel.is-covering .mobile-nav-bar {
		animation: mobile-nav-bar-cover 900ms cubic-bezier(0.85, 0, 0.15, 1) var(--bar-delay) forwards;
	}

	.mobile-nav-panel.is-revealing .mobile-nav-bar {
		animation: mobile-nav-bar-hide 900ms cubic-bezier(0.85, 0, 0.15, 1) var(--bar-hide-delay) forwards;
	}

	@keyframes mobile-nav-bar-cover {
		from {
			transform: translateY(-100%);
		}
		to {
			transform: translateY(0);
		}
	}

	@keyframes mobile-nav-bar-hide {
		from {
			transform: translateY(0);
		}
		to {
			transform: translateY(-100%);
		}
	}

	.mobile-nav-panel__content {
		pointer-events: none;
	}

	.mobile-nav-panel.is-covering .mobile-nav-panel__content,
	.mobile-nav-panel.is-open:not(.is-closing) .mobile-nav-panel__content {
		pointer-events: auto;
	}

	.mobile-nav-item__reveal {
		display: block;
		overflow: hidden;
	}

	.mobile-nav-item__motion {
		display: block;
		width: fit-content;
		max-width: 100%;
		transform: translateX(-110%);
		transition: transform 0.7s cubic-bezier(0.76, 0, 0.24, 1);
		transition-delay: 0s;
		will-change: transform;
	}

		/* Links start shortly after bars begin covering — not after they finish. */
		.mobile-nav-panel.is-covering .mobile-nav-item__motion,
		.mobile-nav-panel.is-open:not(.is-closing) .mobile-nav-item__motion {
			transform: translateX(0);
			transition-delay: calc(220ms + var(--nav-i, 0) * 80ms);
		}

		.mobile-nav-panel.is-closing .mobile-nav-item__motion {
			transform: translateX(-110%);
			/* Leave immediately; bars follow after MOBILE_NAV_ITEM_LEAD_MS in JS. */
			transition-delay: calc(var(--nav-i, 0) * 80ms);
		}

	body.mobile-nav-open {
		overflow: hidden;
		overscroll-behavior: none;
	}

	html.mobile-nav-open {
		overflow: hidden;
		overscroll-behavior: none;
	}

	@media (prefers-reduced-motion: reduce) {
		.mobile-nav-toggle,
		.mobile-nav-toggle__dot,
		.mobile-nav-toggle__glow,
		.mobile-nav-toggle__ring,
		.mobile-nav-item__motion {
			transition: none !important;
		}

		.mobile-nav-toggle__dot--a,
		.mobile-nav-toggle__dot--b,
		.mobile-nav-toggle__dot--c,
		.mobile-nav-toggle__dot--a .mobile-nav-toggle__glow,
		.mobile-nav-toggle__dot--b .mobile-nav-toggle__glow,
		.mobile-nav-toggle__dot--c .mobile-nav-toggle__glow {
			animation: none !important;
		}

		.mobile-nav-toggle__dot--a {
			transform: translate(0, -8px) scale(1);
		}

		.mobile-nav-toggle__dot--b {
			transform: translate(-7px, 5px) scale(1);
		}

		.mobile-nav-toggle__dot--c {
			transform: translate(7px, 5px) scale(1);
		}

		.mobile-nav-toggle.is-open .mobile-nav-toggle__dot--a {
			transform: translate(0, 0) scale(2);
		}

		.mobile-nav-toggle.is-open .mobile-nav-toggle__dot--b,
		.mobile-nav-toggle.is-open .mobile-nav-toggle__dot--c {
			opacity: 0;
			transform: translate(0, 0) scale(0.2);
		}

		.mobile-nav-toggle.is-open .mobile-nav-toggle__ring {
			opacity: 1;
			transform: scale(1);
		}

		.mobile-nav-panel.is-covering .mobile-nav-bar,
		.mobile-nav-panel.is-revealing .mobile-nav-bar {
			animation: none !important;
		}

		.mobile-nav-panel.is-covering .mobile-nav-bar,
		.mobile-nav-panel.is-open .mobile-nav-bar,
		.mobile-nav-panel.is-covered .mobile-nav-bar {
			transform: translateY(0);
		}

		.mobile-nav-panel.is-revealing .mobile-nav-bar {
			transform: translateY(-100%);
		}

		.mobile-nav-panel.is-covering .mobile-nav-item__motion,
		.mobile-nav-panel.is-open:not(.is-closing) .mobile-nav-item__motion {
			transform: none;
		}
	}
</style>

<script>
	import { hasCompletedIntro } from '../scripts/introState.ts';
	import {
		getLenis,
		scrollToImmediate,
		startSmoothScroll,
		stopSmoothScroll,
	} from '../scripts/initSmoothScroll.ts';

	let headerScrollCleanup: (() => void) | null = null;
	let mobileNavCleanup: (() => void) | null = null;
	let syncHeaderAppearance: (() => void) | null = null;
	let lockedScrollY = 0;
	let mobileNavBusy = false;
	let mobileNavToken = 0;
	let mobileNavCloseTimer: number | null = null;
	let mobileNavPendingNavigation = false;

	function isCrossPageNavigation(link: HTMLAnchorElement | null, event: MouseEvent) {
		if (!link || event.defaultPrevented) return false;
		if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return false;
		if (link.target && link.target !== '_self') return false;
		if (link.hasAttribute('download') || link.hasAttribute('data-astro-reload')) return false;
		const href = link.getAttribute('href');
		if (!href || href.startsWith('#')) return false;
		const url = new URL(link.href, window.location.href);
		if (url.origin !== window.location.origin) return false;
		return url.pathname !== window.location.pathname;
	}

	function resetMobileNavAfterNavigation() {
		if (!mobileNavPendingNavigation) return;
		mobileNavPendingNavigation = false;
		mobileNavToken++;
		mobileNavBusy = false;
		document.documentElement.classList.remove('mobile-nav-open');
		document.body.classList.remove('mobile-nav-open');
		startSmoothScroll();
		getLenis()?.resize();
	}

	const MOBILE_NAV_BAR_MS = 900;
	const MOBILE_NAV_STAGGER_MS = 75;
	const MOBILE_NAV_TOTAL_MS = MOBILE_NAV_BAR_MS + MOBILE_NAV_STAGGER_MS * 6;
	const MOBILE_NAV_ITEM_MS = 700;
	const MOBILE_NAV_ITEM_STAGGER_MS = 80;
	/** Links lag bars on open / lead bars on close. */
	const MOBILE_NAV_ITEM_LEAD_MS = 220;

	function prefersReducedMotion() {
		return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	}

	function getMobileNavItemsOutMs(panel: HTMLElement) {
		const count = panel.querySelectorAll('.mobile-nav-item').length;
		if (count <= 0) return 0;
		return MOBILE_NAV_ITEM_MS + (count - 1) * MOBILE_NAV_ITEM_STAGGER_MS;
	}

	function clearMobileNavBarAnimations(panel: HTMLElement) {
		const bars = panel.querySelectorAll<HTMLElement>('.mobile-nav-bar');
		bars.forEach((bar) => {
			bar.style.animation = 'none';
		});
		void panel.offsetWidth;
		bars.forEach((bar) => {
			bar.style.animation = '';
		});
	}

	function resetMobileNavBars(panel: HTMLElement) {
		panel.classList.remove(
			'is-covering',
			'is-revealing',
			'is-covered',
			'is-open',
			'is-closing',
			'is-active',
		);
		clearMobileNavBarAnimations(panel);
	}

	function lockBodyScroll() {
		lockedScrollY = window.scrollY;
		stopSmoothScroll();
		document.documentElement.classList.add('mobile-nav-open');
		document.body.classList.add('mobile-nav-open');
		document.body.style.position = 'fixed';
		document.body.style.top = `-${lockedScrollY}px`;
		document.body.style.left = '0';
		document.body.style.right = '0';
		document.body.style.width = '100%';
	}

	function unlockBodyScroll() {
		if (!document.body.classList.contains('mobile-nav-open')) return;

		const pendingRaw = document.body.dataset.mobileNavUnlockY;
		const pendingFromDataset = pendingRaw != null ? Number(pendingRaw) : NaN;
		const pendingFromWindow = (window as Window & { __setinMobileNavUnlockY?: number })
			.__setinMobileNavUnlockY;
		const pendingY = Number.isFinite(pendingFromDataset)
			? pendingFromDataset
			: typeof pendingFromWindow === 'number'
				? pendingFromWindow
				: NaN;
		const scrollY = Number.isFinite(pendingY) ? pendingY : lockedScrollY;

		delete document.body.dataset.mobileNavUnlockY;
		delete (window as Window & { __setinMobileNavUnlockY?: number }).__setinMobileNavUnlockY;
		lockedScrollY = scrollY;

		document.documentElement.classList.remove('mobile-nav-open');
		document.body.classList.remove('mobile-nav-open');
		document.body.style.position = '';
		document.body.style.top = '';
		document.body.style.left = '';
		document.body.style.right = '';
		document.body.style.width = '';
		scrollToImmediate(scrollY);
		startSmoothScroll();
		getLenis()?.resize();
		// Lenis can snap back to its pre-lock scroll on start/resize — re-assert once.
		requestAnimationFrame(() => {
			scrollToImmediate(scrollY);
			getLenis()?.resize();
		});
	}

	function readDotPose(el: HTMLElement) {
		const raw = getComputedStyle(el).transform;
		if (!raw || raw === 'none') return { x: 0, y: 0, s: 1 };

		if (raw.startsWith('matrix3d(')) {
			const p = raw
				.slice(9, -1)
				.split(',')
				.map((value) => Number(value.trim()));
			return {
				x: p[12] ?? 0,
				y: p[13] ?? 0,
				s: Math.max(0.01, Math.hypot(p[0] ?? 1, p[1] ?? 0)),
			};
		}

		const p = raw
			.slice(7, -1)
			.split(',')
			.map((value) => Number(value.trim()));
		return {
			x: p[4] ?? 0,
			y: p[5] ?? 0,
			s: Math.max(0.01, Math.hypot(p[0] ?? 1, p[1] ?? 0)),
		};
	}

	function poseTransform(x: number, y: number, s: number) {
		return `translate(${x}px, ${y}px) scale(${s})`;
	}

	const DOT_REST = [
		{ x: 0, y: -8, s: 1 },
		{ x: -7, y: 5, s: 1 },
		{ x: 7, y: 5, s: 1 },
	] as const;
	const DOT_MERGED = { x: 0, y: 0, s: 2 } as const;
	const DOT_MORPH_MS = 720;

	function setToggleOpen(toggle: HTMLElement, isOpen: boolean) {
		const dots = [...toggle.querySelectorAll<HTMLElement>('.mobile-nav-toggle__dot')];
		const glows = [...toggle.querySelectorAll<HTMLElement>('.mobile-nav-toggle__glow')];
		const ease = `transform ${DOT_MORPH_MS}ms cubic-bezier(0.22, 1, 0.36, 1), opacity ${DOT_MORPH_MS}ms cubic-bezier(0.16, 1, 0.3, 1)`;
		const glowEase =
			`opacity ${DOT_MORPH_MS}ms ease, width ${DOT_MORPH_MS}ms ease, height ${DOT_MORPH_MS}ms ease, margin ${DOT_MORPH_MS}ms ease, filter ${DOT_MORPH_MS}ms ease, transform ${DOT_MORPH_MS}ms ease`;

		if (isOpen) {
			// Freeze current triangle poses as interpolatable translate+scale
			dots.forEach((dot) => {
				const pose = readDotPose(dot);
				dot.style.animation = 'none';
				dot.style.transition = 'none';
				dot.style.opacity = '1';
				dot.style.transform = poseTransform(pose.x, pose.y, pose.s);
			});
			glows.forEach((glow) => {
				glow.style.animation = 'none';
				glow.style.transition = 'none';
				glow.style.opacity = '0.55';
				glow.style.width = '22px';
				glow.style.height = '22px';
				glow.style.margin = '-11px 0 0 -11px';
				glow.style.filter = 'blur(3.5px)';
				glow.style.transform = 'translate(0, 0) scale(1)';
			});

			void toggle.offsetWidth;
			toggle.classList.add('is-morphing', 'is-open');

			requestAnimationFrame(() => {
				// All three fly to center and grow into one stacked circle
				dots.forEach((dot) => {
					dot.style.transition = ease;
					dot.style.opacity = '1';
					dot.style.transform = poseTransform(DOT_MERGED.x, DOT_MERGED.y, DOT_MERGED.s);
				});
				glows.forEach((glow) => {
					glow.style.transition = glowEase;
					glow.style.width = '28px';
					glow.style.height = '28px';
					glow.style.margin = '-14px 0 0 -14px';
					glow.style.opacity = '0.4';
					glow.style.filter = 'blur(4px)';
					glow.style.transform = 'translate(0, 0) scale(1)';
				});
			});
		} else {
			toggle.classList.add('is-morphing');

			// Start from merged center (restore B/C so they can split out)
			dots.forEach((dot) => {
				dot.style.animation = 'none';
				dot.style.transition = 'none';
				dot.style.opacity = '1';
				dot.style.transform = poseTransform(DOT_MERGED.x, DOT_MERGED.y, DOT_MERGED.s);
			});
			glows.forEach((glow) => {
				glow.style.animation = 'none';
				glow.style.transition = 'none';
				glow.style.width = '28px';
				glow.style.height = '28px';
				glow.style.margin = '-14px 0 0 -14px';
				glow.style.opacity = '0.4';
				glow.style.filter = 'blur(4px)';
				glow.style.transform = 'translate(0, 0) scale(1)';
			});

			void toggle.offsetWidth;
			toggle.classList.remove('is-open');

			requestAnimationFrame(() => {
				dots.forEach((dot, index) => {
					const rest = DOT_REST[index] ?? DOT_REST[0];
					dot.style.transition = ease;
					dot.style.opacity = '1';
					dot.style.transform = poseTransform(rest.x, rest.y, rest.s);
				});
				glows.forEach((glow) => {
					glow.style.transition = glowEase;
					glow.style.width = '22px';
					glow.style.height = '22px';
					glow.style.margin = '-11px 0 0 -11px';
					glow.style.opacity = '0.55';
					glow.style.filter = 'blur(3.5px)';
					glow.style.transform = 'translate(0, 0) scale(1)';
				});

				window.setTimeout(() => {
					if (toggle.classList.contains('is-open')) return;
					dots.forEach((dot) => {
						dot.style.removeProperty('animation');
						dot.style.removeProperty('transition');
						dot.style.removeProperty('transform');
						dot.style.removeProperty('opacity');
					});
					glows.forEach((glow) => {
						glow.style.removeProperty('animation');
						glow.style.removeProperty('transition');
						glow.style.removeProperty('transform');
						glow.style.removeProperty('opacity');
						glow.style.removeProperty('width');
						glow.style.removeProperty('height');
						glow.style.removeProperty('margin');
						glow.style.removeProperty('filter');
					});
					toggle.classList.remove('is-morphing');
				}, DOT_MORPH_MS + 40);
			});
		}

		toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
		toggle.setAttribute('aria-label', isOpen ? 'Close menu' : 'Open menu');
		toggle.setAttribute('data-i18n-aria', isOpen ? 'nav.closeMenu' : 'nav.openMenu');
	}

	async function openMobileNav() {
		const toggle = document.getElementById('mobile-nav-toggle');
		const panel = document.getElementById('mobile-nav-panel');
		if (!toggle || !panel) return;
		if (toggle.classList.contains('is-open') && panel.classList.contains('is-open')) return;

		const token = ++mobileNavToken;
		mobileNavBusy = true;
		if (mobileNavCloseTimer != null) {
			window.clearTimeout(mobileNavCloseTimer);
			mobileNavCloseTimer = null;
		}

		setToggleOpen(toggle, true);
		lockBodyScroll();
		syncHeaderAppearance?.();

		panel.setAttribute('aria-hidden', 'false');
		panel.classList.add('is-active');
		panel.classList.remove('is-revealing', 'is-covered', 'is-open', 'is-closing');
		clearMobileNavBarAnimations(panel);

		if (prefersReducedMotion()) {
			if (token !== mobileNavToken) return;
			panel.classList.add('is-covered', 'is-open');
			syncHeaderAppearance?.();
			mobileNavBusy = false;
			return;
		}

		void panel.offsetWidth;
		panel.classList.add('is-covering');

		await new Promise<void>((resolve) => {
			window.setTimeout(resolve, MOBILE_NAV_TOTAL_MS);
		});

		if (token !== mobileNavToken) return;

		panel.classList.remove('is-covering');
		panel.classList.add('is-covered', 'is-open');
		syncHeaderAppearance?.();
		mobileNavBusy = false;
	}

	async function closeMobileNav() {
		const toggle = document.getElementById('mobile-nav-toggle');
		const panel = document.getElementById('mobile-nav-panel');
		if (!toggle || !panel) return;
		if (!panel.classList.contains('is-active') && !toggle.classList.contains('is-open')) return;

		const token = ++mobileNavToken;
		mobileNavBusy = true;
		if (mobileNavCloseTimer != null) {
			window.clearTimeout(mobileNavCloseTimer);
			mobileNavCloseTimer = null;
		}

		setToggleOpen(toggle, false);
		panel.setAttribute('aria-hidden', 'true');

		if (prefersReducedMotion()) {
			if (token !== mobileNavToken) return;
			resetMobileNavBars(panel);
			unlockBodyScroll();
			syncHeaderAppearance?.();
			mobileNavBusy = false;
			return;
		}

		// Items may already be mid-reveal while bars are still covering.
		const hadItemsVisible =
			panel.classList.contains('is-open') || panel.classList.contains('is-covering');
		if (hadItemsVisible) {
			panel.classList.add('is-closing');
			panel.classList.remove('is-open');
			void panel.offsetWidth;
		}

		// Keep bars fully covering — never drop is-covered before reveal starts,
		// otherwise the page flashes through empty space between bars.
		if (panel.classList.contains('is-covering')) {
			panel.classList.remove('is-covering');
			panel.classList.add('is-covered');
		} else if (!panel.classList.contains('is-covered')) {
			panel.classList.add('is-covered');
		}

		// Links leave first; bars follow after the same lead used on open.
		if (hadItemsVisible) {
			await new Promise<void>((resolve) => {
				mobileNavCloseTimer = window.setTimeout(() => {
					mobileNavCloseTimer = null;
					resolve();
				}, MOBILE_NAV_ITEM_LEAD_MS);
			});
			if (token !== mobileNavToken) return;
		} else {
			panel.classList.remove('is-open');
		}

		clearMobileNavBarAnimations(panel);
		void panel.offsetWidth;
		panel.classList.add('is-revealing');
		syncHeaderAppearance?.();

		const itemsRemainingMs = hadItemsVisible
			? Math.max(0, getMobileNavItemsOutMs(panel) - MOBILE_NAV_ITEM_LEAD_MS)
			: 0;
		const closeMs = Math.max(itemsRemainingMs, MOBILE_NAV_TOTAL_MS);

		await new Promise<void>((resolve) => {
			mobileNavCloseTimer = window.setTimeout(() => {
				mobileNavCloseTimer = null;
				resolve();
			}, closeMs);
		});

		if (token !== mobileNavToken) return;

		resetMobileNavBars(panel);
		unlockBodyScroll();
		syncHeaderAppearance?.();
		mobileNavBusy = false;
	}

	function initHeaderSolidBackground() {
		headerScrollCleanup?.();
		headerScrollCleanup = null;

		const header = document.getElementById('site-header');
		if (!header) return;

		const isLightBg = header.dataset.theme === 'light-bg';
		const headline = document.getElementById('hero-headline');

		function updateHeaderSolid() {
			const menuOpen = document.body.classList.contains('mobile-nav-open');

			// While mobile menu bars are up they are the header backdrop — no solid fill.
			if (menuOpen) {
				header.classList.remove('header-solid');
				return;
			}

			const isLogoCompact = window.scrollY > 40;

			if (isLightBg) {
				header.classList.toggle('header-solid', isLogoCompact);
				return;
			}

			if (!headline) {
				header.classList.toggle('header-solid', isLogoCompact);
				return;
			}

			const headlineTop = headline.getBoundingClientRect().top;
			const headerHeight = header.offsetHeight;
			header.classList.toggle('header-solid', headlineTop <= headerHeight);
		}

		let ticking = false;

		function onScroll() {
			if (ticking) return;
			ticking = true;
			requestAnimationFrame(() => {
				updateHeaderSolid();
				ticking = false;
			});
		}

		updateHeaderSolid();
		window.addEventListener('scroll', onScroll, { passive: true });
		window.addEventListener('resize', updateHeaderSolid, { passive: true });

		headerScrollCleanup = () => {
			window.removeEventListener('scroll', onScroll);
			window.removeEventListener('resize', updateHeaderSolid);
		};

		syncHeaderAppearance = updateHeaderSolid;
	}

	function initMobileNav() {
		mobileNavCleanup?.();
		mobileNavCleanup = null;
		mobileNavBusy = false;

		const toggle = document.getElementById('mobile-nav-toggle');
		const panel = document.getElementById('mobile-nav-panel');

		if (!toggle || !panel) {
			void closeMobileNav();
			return;
		}

		resetMobileNavBars(panel);
		setToggleOpen(toggle, false);
		unlockBodyScroll();

		const onUnlockTarget = (event: Event) => {
			const detail = (event as CustomEvent<number>).detail;
			if (typeof detail === 'number' && Number.isFinite(detail)) {
				lockedScrollY = Math.max(0, detail);
			}
		};
		window.addEventListener('setin:mobile-nav-unlock-y', onUnlockTarget);

		const onToggleClick = () => {
			const shouldOpen = !toggle.classList.contains('is-open');
			if (shouldOpen) {
				void openMobileNav();
			} else {
				void closeMobileNav();
			}
		};

		const onPanelClick = (event: Event) => {
			const target = event.target as HTMLElement | null;
			if (!target?.closest('[data-mobile-nav-link]')) return;
			// Menu stays up until the page transition overlay covers it.
			if (isCrossPageNavigation(target.closest('a'), event as MouseEvent)) {
				mobileNavPendingNavigation = true;
				let navigationStarted = false;
				document.addEventListener(
					'astro:before-preparation',
					() => {
						navigationStarted = true;
					},
					{ once: true },
				);
				window.setTimeout(() => {
					if (navigationStarted || !mobileNavPendingNavigation) return;
					mobileNavPendingNavigation = false;
					void closeMobileNav();
				}, 400);
				return;
			}
			void closeMobileNav();
		};

		const onKeyDown = (event: KeyboardEvent) => {
			if (event.key === 'Escape') void closeMobileNav();
		};

		toggle.addEventListener('click', onToggleClick);
		panel.addEventListener('click', onPanelClick);
		window.addEventListener('keydown', onKeyDown);

		mobileNavCleanup = () => {
			toggle.removeEventListener('click', onToggleClick);
			panel.removeEventListener('click', onPanelClick);
			window.removeEventListener('keydown', onKeyDown);
			window.removeEventListener('setin:mobile-nav-unlock-y', onUnlockTarget);
			void closeMobileNav();
		};
	}

	function getHeaderNavRevealItems(header: HTMLElement): HTMLElement[] {
		const logo = header.querySelector<HTMLElement>('.site-header__logo-link');
		const toggle = header.querySelector<HTMLElement>('.mobile-nav-toggle');
		const nav = header.querySelector<HTMLElement>('.site-header__nav');
		const isMobile = window.matchMedia('(max-width: 767px)').matches;

		if (isMobile) {
			return [logo, toggle].filter((el): el is HTMLElement => !!el);
		}

		const navItems = nav
			? Array.from(nav.children).filter((el): el is HTMLElement => el instanceof HTMLElement)
			: [];

		return [logo, ...navItems].filter((el): el is HTMLElement => !!el);
	}

	function revealHeaderNav(header: HTMLElement) {
		const items = getHeaderNavRevealItems(header);

		items.forEach((item, index) => {
			item.style.setProperty('--nav-reveal-i', String(index));
		});

		header.classList.remove('is-intro-pending', 'pointer-events-none');
		header.classList.add('is-intro-revealing');

		requestAnimationFrame(() => {
			items.forEach((item) => item.classList.add('is-nav-revealed'));
		});
	}

	function initHeaderIntroReveal() {
		const header = document.getElementById('site-header');
		if (!header || header.dataset.waitIntro !== 'true') return;

		if (hasCompletedIntro()) {
			header.classList.remove('is-intro-pending', 'pointer-events-none', 'is-intro-revealing');
			getHeaderNavRevealItems(header).forEach((item) => {
				item.classList.add('is-nav-revealed');
				item.style.removeProperty('--nav-reveal-i');
			});
			return;
		}

		window.addEventListener(
			'intro-complete',
			() => {
				revealHeaderNav(header);
			},
			{ once: true },
		);
	}

	function initHeader() {
		initHeaderSolidBackground();
		initMobileNav();
		initHeaderIntroReveal();
	}

	initHeader();
	document.addEventListener('astro:after-swap', resetMobileNavAfterNavigation);
	document.addEventListener('astro:page-load', () => {
		resetMobileNavAfterNavigation();
		closeMobileNav();
		initHeader();
	});
</script>
