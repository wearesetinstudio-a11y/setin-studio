---
import RollingLink from './RollingLink.astro';
import WorkWithUsButton from './WorkWithUsButton.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { stripLocalePrefix } from '../i18n/seo.ts';
import { isActiveNavHref, normalizeNavPath } from '../utils/isActiveNavHref.ts';
import { STUDIO_LOGO_ALTS } from '../utils/projectImageAlt.ts';

interface Props {
	projectCount?: number;
	waitForIntro?: boolean;
	theme?: 'default' | 'light-bg';
	/** Optional lockup (e.g. Setin × client) for pitch/proposal pages. */
	logoSrc?: string;
	logoAlt?: string;
	logoWidth?: number;
	logoHeight?: number;
}

const {
	projectCount = 0,
	waitForIntro = false,
	theme = 'default',
	logoSrc = '/logo-setin.svg',
	logoAlt = STUDIO_LOGO_ALTS.en,
	logoWidth = 111,
	logoHeight = 42,
} = Astro.props;

const originPathname =
	typeof Astro.originPathname === 'string' && Astro.originPathname
		? Astro.originPathname
		: Astro.url.pathname;
const barePath = normalizeNavPath(stripLocalePrefix(originPathname));

const hasLocalContact =
	barePath === '/' ||
	barePath === '/about' ||
	barePath === '/services' ||
	barePath === '/projects' ||
	barePath.startsWith('/pitches/') ||
	/^\/projects\/[^/]+$/.test(barePath);

const workWithUsHref = hasLocalContact ? '#contact' : '/#contact';
const isLightBg = theme === 'light-bg';
const isLockupLogo = logoSrc !== '/logo-setin.svg';

const nav = [
	{ href: '/projects', label: 'Projects', count: projectCount, i18nKey: 'nav.projects' },
	{ href: '/services', label: 'Services', i18nKey: 'nav.services' },
	{ href: '/about', label: 'About us', i18nKey: 'nav.about' },
];

const headerClass = waitForIntro ? 'is-intro-pending pointer-events-none' : '';
---

<header
	id="site-header"
	data-wait-intro={waitForIntro ? 'true' : 'false'}
	data-theme={theme}
	class:list={[
		'site-header fixed inset-x-0 top-0 z-50 bg-transparent transition-all duration-500 ease-[cubic-bezier(0.76,0,0.24,1)]',
		isLightBg && 'site-header--light-bg',
		headerClass,
	]}
>
	<div class="grid h-[72px] w-full grid-cols-[1fr_auto] items-center px-[var(--page-gutter)] md:h-[100px]">
		<a
			href="/"
			class="site-header__logo-link justify-self-start block w-fit transition-opacity hover:opacity-70"
			aria-label={logoAlt || 'Setin Studio — home'}
			data-i18n-aria={isLockupLogo ? undefined : 'nav.homeAria'}
		>
			<img
				src={logoSrc}
				alt={logoAlt}
				width={logoWidth}
				height={logoHeight}
				class:list={[
					'site-header__logo-setin w-auto',
					isLockupLogo ? 'h-8 md:h-12' : 'h-[32px]',
				]}
				data-alts={isLockupLogo ? undefined : JSON.stringify(STUDIO_LOGO_ALTS)}
				aria-hidden={logoAlt ? undefined : 'true'}
			/>
		</a>

		<nav
			class="site-header__nav hidden items-center justify-self-end gap-8 md:flex lg:gap-10"
			aria-label="Main"
			data-i18n-aria="nav.mainAria"
		>
			{
				nav.map((item) => (
					<RollingLink
						href={item.href}
						label={item.label}
						count={item.count}
						inverted={isLightBg}
						i18nKey={item.i18nKey}
						current={isActiveNavHref(item.href, barePath)}
					/>
				))
			}
			<LanguageSwitcher inverted={isLightBg} />
			<WorkWithUsButton
				href={workWithUsHref}
				variant={isLightBg ? 'dark' : 'light'}
				label="Work with us"
				i18nKey="nav.workWithUs"
			/>
		</nav>

		<button
			type="button"
			id="mobile-nav-toggle"
			class="mobile-nav-toggle relative -mr-1 flex h-10 w-10 items-center justify-center justify-self-end md:hidden"
			aria-expanded="false"
			aria-controls="mobile-nav-panel"
			aria-label="Open menu"
			data-i18n-aria="nav.openMenu"
		>
			<span class="mobile-nav-toggle__orb" aria-hidden="true">
				<span class="mobile-nav-toggle__dot mobile-nav-toggle__dot--a">
					<span class="mobile-nav-toggle__glow"></span>
					<span class="mobile-nav-toggle__core"></span>
				</span>
				<span class="mobile-nav-toggle__dot mobile-nav-toggle__dot--b">
					<span class="mobile-nav-toggle__glow"></span>
					<span class="mobile-nav-toggle__core"></span>
				</span>
				<span class="mobile-nav-toggle__dot mobile-nav-toggle__dot--c">
					<span class="mobile-nav-toggle__glow"></span>
					<span class="mobile-nav-toggle__core"></span>
				</span>
				<span class="mobile-nav-toggle__ring"></span>
			</span>
		</button>
	</div>
</header>

<div
	id="mobile-nav-panel"
	class="mobile-nav-panel fixed inset-x-0 top-0 z-[45] h-[100dvh] overflow-hidden md:hidden"
	aria-hidden="true"
>
	<div class="mobile-nav-bars" aria-hidden="true">
		<div class="mobile-nav-bar"></div>
		<div class="mobile-nav-bar"></div>
		<div class="mobile-nav-bar"></div>
		<div class="mobile-nav-bar"></div>
		<div class="mobile-nav-bar"></div>
		<div class="mobile-nav-bar"></div>
		<div class="mobile-nav-bar"></div>
	</div>

	<div class="mobile-nav-panel__content absolute inset-0 z-[1] flex h-full flex-col justify-center px-[var(--page-gutter)]">
		<div class="mobile-nav-panel__inner flex w-full flex-col gap-10">
			<nav class="mobile-nav-links flex flex-col" aria-label="Mobile" data-i18n-aria="nav.mobileAria">
				{
					nav.map((item, index) => {
						const current = isActiveNavHref(item.href, barePath);
						return (
							<a
								href={item.href}
								class:list={[
									'mobile-nav-link mobile-nav-item text-[2rem] font-semibold uppercase leading-none text-setin-fg',
									current && 'mobile-nav-link--current',
								]}
								style={`--nav-i: ${index}`}
								data-mobile-nav-link
								data-nav-href={item.href}
								aria-current={current ? 'page' : undefined}
							>
								<span class="mobile-nav-item__reveal">
									<span
										class="mobile-nav-item__motion"
										data-i18n-count={item.count !== undefined ? item.i18nKey : undefined}
										data-count={item.count !== undefined ? String(item.count) : undefined}
										data-i18n={item.count === undefined ? item.i18nKey : undefined}
									>
										{item.count !== undefined ? `${item.label} [${item.count}]` : item.label}
									</span>
								</span>
							</a>
						);
					})
				}
			</nav>

			<div class="mobile-nav-item" style={`--nav-i: ${nav.length}`}>
				<div class="mobile-nav-item__reveal">
					<div class="mobile-nav-item__motion">
						<LanguageSwitcher mobile />
					</div>
				</div>
			</div>

			<div
				class="mobile-nav-panel__cta mobile-nav-item"
				style={`--nav-i: ${nav.length + 1}`}
				data-mobile-nav-link
			>
				<div class="mobile-nav-item__reveal">
					<div class="mobile-nav-item__motion">
						<WorkWithUsButton href={workWithUsHref} size="large" i18nKey="nav.workWithUs" />
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<style is:global>
	.site-header__logo-link,
	.site-header__nav > *,
	.site-header .mobile-nav-toggle {
		opacity: 1;
		transform: translateY(0);
		transition:
			opacity 550ms cubic-bezier(0.16, 1, 0.3, 1),
			transform 550ms cubic-bezier(0.16, 1, 0.3, 1);
		transition-delay: 0ms;
	}

	.site-header.is-intro-pending .site-header__logo-link,
	.site-header.is-intro-pending .site-header__nav > *,
	.site-header.is-intro-pending .mobile-nav-toggle {
		opacity: 0;
		transform: translateY(0.45rem);
	}

	.site-header.is-intro-revealing .site-header__logo-link.is-nav-revealed,
	.site-header.is-intro-revealing .site-header__nav > *.is-nav-revealed,
	.site-header.is-intro-revealing .mobile-nav-toggle.is-nav-revealed {
		opacity: 1;
		transform: translateY(0);
		transition-delay: calc(var(--nav-reveal-i, 0) * 75ms);
	}

	@media (prefers-reduced-motion: reduce) {
		.site-header__logo-link,
		.site-header__nav > *,
		.site-header .mobile-nav-toggle {
			transition: none !important;
			transition-delay: 0ms !important;
			opacity: 1 !important;
			transform: none !important;
		}
	}

	.site-header.header-solid {
		background-color: var(--theme-color, #131415);
	}

	.site-header--light-bg:not(.header-solid) .site-header__logo-setin {
		filter: brightness(0);
	}

	.site-header--light-bg.header-solid .site-header__logo-setin {
		filter: none;
	}

	.site-header--light-bg:not(.header-solid) .rolling-link,
	.site-header--light-bg:not(.header-solid) .rolling-link span {
		color: #000000 !important;
	}

	.site-header--light-bg:not(.header-solid) .rolling-link--current,
	.site-header--light-bg:not(.header-solid) .rolling-link--current .rolling-link__line,
	.site-header--light-bg:not(.header-solid) .rolling-link--current span {
		color: rgba(0, 0, 0, 0.5) !important;
	}

	.site-header--light-bg.header-solid .rolling-link,
	.site-header--light-bg.header-solid .rolling-link span {
		color: #f5f5f5 !important;
	}

	.site-header--light-bg.header-solid .rolling-link--current,
	.site-header--light-bg.header-solid .rolling-link--current .rolling-link__line,
	.site-header--light-bg.header-solid .rolling-link--current span {
		color: rgba(255, 255, 255, 0.5) !important;
	}

	.site-header--light-bg:not(.header-solid) .work-with-us-button,
	.site-header--light-bg:not(.header-solid) .work-with-us-button span {
		color: #000000 !important;
	}

	.site-header--light-bg:not(.header-solid) .work-with-us-button__underline {
		background-color: #000000 !important;
	}

	.site-header--light-bg.header-solid .work-with-us-button,
	.site-header--light-bg.header-solid .work-with-us-button span {
		color: #f5f5f5 !important;
	}

	.site-header--light-bg.header-solid .work-with-us-button__underline {
		background-color: #ffffff !important;
	}

	body.mobile-nav-open .site-header--light-bg .site-header__logo-setin {
		filter: none;
	}

	body.mobile-nav-open .site-header--light-bg .mobile-nav-toggle {
		color: #f5f5f5;
	}

	.mobile-nav-toggle {
		position: relative;
		z-index: 50;
		color: #f5f5f5;
	}

	.mobile-nav-toggle__orb {
		position: relative;
		display: block;
		width: 36px;
		height: 36px;
	}

	.mobile-nav-toggle__dot {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 6px;
		height: 6px;
		margin: -3px 0 0 -3px;
		will-change: transform, opacity;
	}

	.mobile-nav-toggle__core {
		position: absolute;
		inset: 0;
		border-radius: 9999px;
		background-color: currentColor;
		box-shadow: 0 0 6px color-mix(in srgb, currentColor 45%, transparent);
	}

	.mobile-nav-toggle__glow {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 22px;
		height: 22px;
		margin: -11px 0 0 -11px;
		border-radius: 9999px;
		background: radial-gradient(
			ellipse at center,
			color-mix(in srgb, currentColor 55%, transparent) 0%,
			color-mix(in srgb, currentColor 22%, transparent) 42%,
			color-mix(in srgb, currentColor 6%, transparent) 68%,
			transparent 80%
		);
		filter: blur(3.5px);
		opacity: 0.55;
		transform: translate(0, 0) scale(1);
		transform-origin: center;
		pointer-events: none;
		will-change: transform, opacity, width, height;
	}

	.mobile-nav-toggle__dot--a {
		animation: mobile-nav-dot-a 9s cubic-bezier(0.4, 0, 0.2, 1) infinite;
	}

	.mobile-nav-toggle__dot--b {
		animation: mobile-nav-dot-b 9s cubic-bezier(0.4, 0, 0.2, 1) infinite;
	}

	.mobile-nav-toggle__dot--c {
		animation: mobile-nav-dot-c 9s cubic-bezier(0.4, 0, 0.2, 1) infinite;
	}

	.mobile-nav-toggle__dot--a .mobile-nav-toggle__glow {
		animation: mobile-nav-glow-a 9s cubic-bezier(0.45, 0.05, 0.25, 1) infinite;
	}

	.mobile-nav-toggle__dot--b .mobile-nav-toggle__glow {
		animation: mobile-nav-glow-b 9s cubic-bezier(0.45, 0.05, 0.25, 1) infinite;
	}

	.mobile-nav-toggle__dot--c .mobile-nav-toggle__glow {
		animation: mobile-nav-glow-c 9s cubic-bezier(0.45, 0.05, 0.25, 1) infinite;
	}

	@media (min-width: 768px) {
		.mobile-nav-toggle__dot,
		.mobile-nav-toggle__glow {
			animation: none !important;
			will-change: auto;
		}
	}

	/* Positions every 3s (9s cycle). Hold ~2.15s, morph move ~0.85s */
	@keyframes mobile-nav-dot-a {
		0%,
		23.8% {
			transform: translate(0, -8px) scale(1);
		}
		33.33%,
		57.13% {
			transform: translate(7px, 5px) scale(1);
		}
		66.66%,
		90.46% {
			transform: translate(-7px, 5px) scale(1);
		}
		100% {
			transform: translate(0, -8px) scale(1);
		}
	}

	@keyframes mobile-nav-dot-b {
		0%,
		23.8% {
			transform: translate(-7px, 5px) scale(1);
		}
		33.33%,
		57.13% {
			transform: translate(0, -8px) scale(1);
		}
		66.66%,
		90.46% {
			transform: translate(7px, 5px) scale(1);
		}
		100% {
			transform: translate(-7px, 5px) scale(1);
		}
	}

	@keyframes mobile-nav-dot-c {
		0%,
		23.8% {
			transform: translate(7px, 5px) scale(1);
		}
		33.33%,
		57.13% {
			transform: translate(-7px, 5px) scale(1);
		}
		66.66%,
		90.46% {
			transform: translate(0, -8px) scale(1);
		}
		100% {
			transform: translate(7px, 5px) scale(1);
		}
	}

	/* Idle halo → soft trail: long ramps, mild stretch (no hard idle/move snap) */
	@keyframes mobile-nav-glow-a {
		0%,
		20% {
			width: 22px;
			height: 22px;
			margin: -11px 0 0 -11px;
			opacity: 0.5;
			transform: translate(0, 0) rotate(0deg);
			filter: blur(3.5px);
		}
		24% {
			width: 24px;
			height: 20px;
			margin: -10px 0 0 -12px;
			opacity: 0.54;
			transform: translate(-1.5px, -1px) rotate(40deg);
			filter: blur(3.7px);
		}
		28.5% {
			width: 28px;
			height: 18px;
			margin: -9px 0 0 -14px;
			opacity: 0.6;
			transform: translate(-3.5px, -2.5px) rotate(100deg);
			filter: blur(4px);
		}
		31% {
			width: 30px;
			height: 17px;
			margin: -8.5px 0 0 -15px;
			opacity: 0.62;
			transform: translate(-4px, -3px) rotate(125deg);
			filter: blur(4.2px);
		}
		33.33%,
		53.33% {
			width: 22px;
			height: 22px;
			margin: -11px 0 0 -11px;
			opacity: 0.5;
			transform: translate(0, 0) rotate(0deg);
			filter: blur(3.5px);
		}
		57.33% {
			width: 24px;
			height: 20px;
			margin: -10px 0 0 -12px;
			opacity: 0.54;
			transform: translate(1.5px, 0) rotate(60deg);
			filter: blur(3.7px);
		}
		61.8% {
			width: 28px;
			height: 18px;
			margin: -9px 0 0 -14px;
			opacity: 0.6;
			transform: translate(3.5px, 0) rotate(140deg);
			filter: blur(4px);
		}
		64.3% {
			width: 30px;
			height: 17px;
			margin: -8.5px 0 0 -15px;
			opacity: 0.62;
			transform: translate(4px, 0) rotate(180deg);
			filter: blur(4.2px);
		}
		66.66%,
		86.66% {
			width: 22px;
			height: 22px;
			margin: -11px 0 0 -11px;
			opacity: 0.5;
			transform: translate(0, 0) rotate(0deg);
			filter: blur(3.5px);
		}
		90.66% {
			width: 24px;
			height: 20px;
			margin: -10px 0 0 -12px;
			opacity: 0.54;
			transform: translate(0, 1.5px) rotate(-20deg);
			filter: blur(3.7px);
		}
		95.2% {
			width: 28px;
			height: 18px;
			margin: -9px 0 0 -14px;
			opacity: 0.6;
			transform: translate(0, 3.5px) rotate(-45deg);
			filter: blur(4px);
		}
		97.7% {
			width: 30px;
			height: 17px;
			margin: -8.5px 0 0 -15px;
			opacity: 0.62;
			transform: translate(0, 4px) rotate(-55deg);
			filter: blur(4.2px);
		}
		100% {
			width: 22px;
			height: 22px;
			margin: -11px 0 0 -11px;
			opacity: 0.5;
			transform: translate(0, 0) rotate(0deg);
			filter: blur(3.5px);
		}
	}

	@keyframes mobile-nav-glow-b {
		0%,
		20% {
			width: 22px;
			height: 22px;
			margin: -11px 0 0 -11px;
			opacity: 0.5;
			transform: translate(0, 0) rotate(0deg);
			filter: blur(3.5px);
		}
		24% {
			width: 24px;
			height: 20px;
			margin: -10px 0 0 -12px;
			opacity: 0.54;
			transform: translate(-1.5px, 1px) rotate(-20deg);
			filter: blur(3.7px);
		}
		28.5% {
			width: 28px;
			height: 18px;
			margin: -9px 0 0 -14px;
			opacity: 0.6;
			transform: translate(-3px, 2.5px) rotate(-45deg);
			filter: blur(4px);
		}
		31% {
			width: 30px;
			height: 17px;
			margin: -8.5px 0 0 -15px;
			opacity: 0.62;
			transform: translate(-3.5px, 3px) rotate(-55deg);
			filter: blur(4.2px);
		}
		33.33%,
		53.33% {
			width: 22px;
			height: 22px;
			margin: -11px 0 0 -11px;
			opacity: 0.5;
			transform: translate(0, 0) rotate(0deg);
			filter: blur(3.5px);
		}
		57.33% {
			width: 24px;
			height: 20px;
			margin: -10px 0 0 -12px;
			opacity: 0.54;
			transform: translate(1.5px, -1px) rotate(40deg);
			filter: blur(3.7px);
		}
		61.8% {
			width: 28px;
			height: 18px;
			margin: -9px 0 0 -14px;
			opacity: 0.6;
			transform: translate(3.5px, -2.5px) rotate(100deg);
			filter: blur(4px);
		}
		64.3% {
			width: 30px;
			height: 17px;
			margin: -8.5px 0 0 -15px;
			opacity: 0.62;
			transform: translate(4px, -3px) rotate(125deg);
			filter: blur(4.2px);
		}
		66.66%,
		86.66% {
			width: 22px;
			height: 22px;
			margin: -11px 0 0 -11px;
			opacity: 0.5;
			transform: translate(0, 0) rotate(0deg);
			filter: blur(3.5px);
		}
		90.66% {
			width: 24px;
			height: 20px;
			margin: -10px 0 0 -12px;
			opacity: 0.54;
			transform: translate(-1.5px, 0) rotate(20deg);
			filter: blur(3.7px);
		}
		95.2% {
			width: 28px;
			height: 18px;
			margin: -9px 0 0 -14px;
			opacity: 0.6;
			transform: translate(-3.5px, 0) rotate(10deg);
			filter: blur(4px);
		}
		97.7% {
			width: 30px;
			height: 17px;
			margin: -8.5px 0 0 -15px;
			opacity: 0.62;
			transform: translate(-4px, 0) rotate(0deg);
			filter: blur(4.2px);
		}
		100% {
			width: 22px;
			height: 22px;
			margin: -11px 0 0 -11px;
			opacity: 0.5;
			transform: translate(0, 0) rotate(0deg);
			filter: blur(3.5px);
		}
	}

	@keyframes mobile-nav-glow-c {
		0%,
		20% {
			width: 22px;
			height: 22px;
			margin: -11px 0 0 -11px;
			opacity: 0.5;
			transform: translate(0, 0) rotate(0deg);
			filter: blur(3.5px);
		}
		24% {
			width: 24px;
			height: 20px;
			margin: -10px 0 0 -12px;
			opacity: 0.54;
			transform: translate(1.5px, 0) rotate(20deg);
			filter: blur(3.7px);
		}
		28.5% {
			width: 28px;
			height: 18px;
			margin: -9px 0 0 -14px;
			opacity: 0.6;
			transform: translate(3.5px, 0) rotate(10deg);
			filter: blur(4px);
		}
		31% {
			width: 30px;
			height: 17px;
			margin: -8.5px 0 0 -15px;
			opacity: 0.62;
			transform: translate(4px, 0) rotate(0deg);
			filter: blur(4.2px);
		}
		33.33%,
		53.33% {
			width: 22px;
			height: 22px;
			margin: -11px 0 0 -11px;
			opacity: 0.5;
			transform: translate(0, 0) rotate(0deg);
			filter: blur(3.5px);
