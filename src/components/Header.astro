	.mobile-nav-toggle__ring {
		position: absolute;
		top: 50%;
		left: 50%;
		/* Open core 12px + 10px gap each side → 32px */
		width: 32px;
		height: 32px;
		margin: -16px 0 0 -16px;
		border: 1.5px solid currentColor;
		border-radius: 9999px;
		opacity: 0;
		transform: scale(0.35);
		pointer-events: none;
		transition:
			opacity 0.45s cubic-bezier(0.16, 1, 0.3, 1) 0.28s,
			transform 0.75s cubic-bezier(0.22, 1, 0.36, 1) 0.18s;
	}

	.site-header--light-bg:not(.header-solid) .mobile-nav-toggle {
		color: #000000;
	}

	.site-header--light-bg.header-solid .mobile-nav-toggle,
	.site-header:not(.site-header--light-bg) .mobile-nav-toggle {
		color: #f5f5f5;
	}

	.mobile-nav-toggle.is-morphing .mobile-nav-toggle__dot,
	.mobile-nav-toggle.is-morphing .mobile-nav-toggle__glow {
		animation: none !important;
	}

	.mobile-nav-toggle.is-open .mobile-nav-toggle__ring {
		opacity: 1;
		transform: scale(1);
	}

	.mobile-nav-toggle.is-open .mobile-nav-toggle__glow {
		opacity: 0.4;
		width: 28px;
		height: 28px;
		margin: -14px 0 0 -14px;
