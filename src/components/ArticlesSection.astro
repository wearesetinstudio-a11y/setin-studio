---
import WorkWithUsButton from './WorkWithUsButton.astro';
import { formatArticleMonthYear, getSortedArticles } from '../utils/getArticles.ts';

interface Props {
	standalone?: boolean;
}

const { standalone = false } = Astro.props;
const allArticles = await getSortedArticles();
const featuredArticles = allArticles.slice(0, 3);
const displayedArticles = standalone ? allArticles : featuredArticles;
---

<section
	id="articles"
	class:list={[
		'articles-section relative z-20 bg-white px-[var(--page-gutter)] py-[var(--section-padding-y)]',
		standalone && 'pt-[calc(var(--section-padding-y)+5.5rem)]',
	]}
>
	<div class="articles-section__grid grid gap-12 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.35fr)] lg:items-start lg:gap-16 xl:gap-24">
		<div class="articles-section__intro min-w-0">
			<h2 id="articles-heading" class="articles-heading max-w-md uppercase leading-[1.15]">
				<span data-reveal-line data-i18n="articles.heading1">Inside</span>
				<br />
				<span data-reveal-line data-i18n="articles.heading2">the process</span>
			</h2>

			<p
				class="body-txt-1 articles-description mt-6 max-w-md leading-relaxed text-black/55"
				data-i18n="articles.description"
			>
				We're opening our internal documentation to showcase the systems, technical shifts, and
				strategic decisions that drive our studio.
			</p>
		</div>

		<div class="articles-section__list min-w-0">
			<ul class="articles-list">
				{
					displayedArticles.map((article) => (
						<li class="articles-list__item">
							<a href={`/articles/${article.id}`} class="article-row group">
								<div class="article-row__media overflow-hidden bg-[#D9D9D9]">
									<img
										src={article.data.coverImage}
										alt=""
										width="240"
										height="180"
										class="h-full w-full object-cover"
										loading="lazy"
									/>
								</div>

								<div class="article-row__content min-w-0">
									<h3 class="article-row__title">{article.data.title}</h3>
									<p class="article-row__meta">
										<span>{formatArticleMonthYear(article.data.publishedAt)}</span>
										<span>{article.data.author}</span>
									</p>
								</div>
							</a>
						</li>
					))
				}
			</ul>

			{
				!standalone && (
					<div class="articles-section__cta mt-10">
						<WorkWithUsButton
							href="/articles"
							label="View more articles"
							variant="dark"
							i18nKey="articles.viewMore"
							count={allArticles.length}
						/>
					</div>
				)
			}
		</div>
	</div>
</section>

<style is:global>
	.articles-heading {
		color: #000000;
	}

	#articles-heading .reveal-char {
		color: rgba(0, 0, 0, 0.15);
		transition: color 0.35s ease-out;
	}

	#articles-heading .reveal-char.active {
		color: #000000;
	}

	.articles-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.articles-list__item {
		border-bottom: 1px solid rgba(0, 0, 0, 0.12);
	}

	.articles-list__item:first-child {
		border-top: 1px solid rgba(0, 0, 0, 0.12);
	}

	.article-row {
		display: grid;
		grid-template-columns: 7.5rem minmax(0, 1fr);
		gap: 1.25rem;
		align-items: stretch;
		height: 5.625rem; /* 7.5rem × 3/4 */
		padding: 1.5rem 0;
		overflow: hidden;
		text-decoration: none;
		box-sizing: content-box;
	}

	@media (min-width: 768px) {
		.article-row {
			grid-template-columns: 9.5rem minmax(0, 1fr);
			gap: 1.75rem;
			height: 7.125rem; /* 9.5rem × 3/4 */
			padding: 1.75rem 0;
		}
	}

	.article-row__media {
		aspect-ratio: 4 / 3;
		width: 100%;
		height: 100%;
		overflow: hidden;
	}

	.article-row__media img {
		display: block;
		height: 100%;
		width: 100%;
		object-fit: cover;
		transform: scale(1);
		transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
	}

	@media (hover: hover) and (pointer: fine) {
		.article-row:hover .article-row__media img {
			transform: scale(1.12);
		}
	}

	@media (hover: none), (pointer: coarse) {
		.article-row:active .article-row__media img {
			transform: scale(1.12);
		}
	}

	.article-row__content {
		display: flex;
		height: 100%;
		min-height: 0;
		flex-direction: column;
		justify-content: space-between;
		overflow: hidden;
	}

	.article-row__title {
		padding-block: 2px;
		font-size: 1.05rem;
		font-weight: 500;
		line-height: 1.45;
		color: #000000;
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		line-clamp: 2;
		overflow: hidden;
		transition:
			padding-block 0.45s cubic-bezier(0.16, 1, 0.3, 1),
			opacity 0.3s ease;
	}

	@media (min-width: 768px) {
		.article-row__title {
			font-size: 1.15rem;
		}
	}

	@media (hover: hover) and (pointer: fine) {
		.article-row:hover .article-row__title {
			padding-block: 8px;
			opacity: 0.65;
		}
	}

	@media (hover: none), (pointer: coarse) {
		.article-row:active .article-row__title {
			padding-block: 8px;
			opacity: 0.65;
		}
	}

	.article-row__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		column-gap: 1.5rem;
		row-gap: 0.25rem;
		margin-top: auto;
		padding-block: 2px;
		font-size: 0.95rem;
		line-height: 1.3;
		color: rgba(0, 0, 0, 0.4);
		transition: padding-block 0.45s cubic-bezier(0.16, 1, 0.3, 1);
	}

	@media (max-width: 767px) {
		.article-row__meta {
			flex-wrap: nowrap;
			column-gap: 0.75rem;
			row-gap: 0;
			font-size: 0.75rem;
			line-height: 1.25;
			white-space: nowrap;
			overflow: hidden;
		}
	}

	@media (hover: hover) and (pointer: fine) {
		.article-row:hover .article-row__meta {
			padding-block: 8px;
		}
	}

	@media (hover: none), (pointer: coarse) {
		.article-row:active .article-row__meta {
			padding-block: 8px;
		}
	}
</style>

<script>
	function wrapLetters(element: HTMLElement) {
		const text = element.textContent ?? '';
		element.textContent = '';

		for (const char of text) {
			const span = document.createElement('span');
			span.className = 'reveal-char';
			span.textContent = char === ' ' ? ' ' : char;
			element.appendChild(span);
		}
	}

	function updateArticlesHeadingReveal() {
		const heading = document.getElementById('articles-heading');
		if (!heading) return;

		const chars = heading.querySelectorAll('.reveal-char');
		if (!chars.length) return;

		const rect = heading.getBoundingClientRect();
		const viewportHeight = window.innerHeight;
		const startLine = viewportHeight * 0.88;
		const endLine = viewportHeight * 0.45;
		const range = startLine - endLine;
		const progress = Math.min(1, Math.max(0, (startLine - rect.top) / range));
		const activeCount = Math.ceil(progress * chars.length);

		chars.forEach((char, index) => {
			char.classList.toggle('active', index < activeCount);
		});
	}

	let scrollTicking = false;

	function onArticlesScroll() {
		if (scrollTicking) return;
		scrollTicking = true;
		requestAnimationFrame(() => {
			updateArticlesHeadingReveal();
			scrollTicking = false;
		});
	}

	function initArticlesHeadingReveal() {
		const heading = document.getElementById('articles-heading');
		if (!heading) return;

		if (heading.dataset.revealInit !== 'true') {
			heading.dataset.revealInit = 'true';

			heading.querySelectorAll('[data-reveal-line]').forEach((line) => {
				wrapLetters(line as HTMLElement);
			});

			window.addEventListener('scroll', onArticlesScroll, { passive: true });
			window.addEventListener('resize', updateArticlesHeadingReveal, { passive: true });
		}

		updateArticlesHeadingReveal();
	}

	function bootArticlesHeadingReveal() {
		initArticlesHeadingReveal();

		const section = document.getElementById('articles');
		if (!section || section.dataset.revealObserved === 'true') return;

		section.dataset.revealObserved = 'true';

		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) updateArticlesHeadingReveal();
				}
			},
			{ threshold: [0, 0.25, 0.5, 0.75, 1] },
		);

		observer.observe(section);
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', bootArticlesHeadingReveal, { once: true });
	} else {
		bootArticlesHeadingReveal();
	}

	document.addEventListener('astro:page-load', bootArticlesHeadingReveal);
</script>
