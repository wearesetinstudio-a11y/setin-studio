---
import { getClientLogoAlts } from '../utils/projectImageAlt';
import { t } from '../i18n/dictionaries.ts';
import { getLocaleFromPath } from '../i18n/seo.ts';

const locale = getLocaleFromPath(Astro.url.pathname);

const clientEntries = [
	{ name: 'Epic Realty', src: '/logos/epic-realty.svg', height: 34 },
	{ name: 'See More Logistics', src: '/logos/see-more.svg', height: 42 },
	{ name: 'Snacks Lovers', src: '/logos/snacks-lovers.svg', height: 48 },
	{ name: 'Detalles', src: '/logos/detalles.svg', height: 34 },
	{ name: 'Avendin', src: '/logos/avendin.svg', height: 27 },
	{ name: 'Andrea Vega', src: '/logos/andrea-vega.svg', height: 48 },
	{ name: 'NRV Control Systems', src: '/logos/nrv.svg', height: 38 },
	{ name: 'Mexi Munchies', src: '/logos/meximunchies.svg', height: 48 },
	{ name: 'TRG Abogada', src: '/logos/trg.svg', height: 56 },
	{ name: 'Fiesta House', src: '/logos/fiesta-house.svg', height: 56 },
	{ name: 'Znicz Pruszków', src: '/logos/znicz-pruszkow.svg', height: 68 },
	{ name: 'Agencia Panamá Pacífico', src: '/logos/agencia-panama-pacifico.svg', height: 40 },
	{ name: 'WCR Kraków', src: '/logos/wcr-krk.svg', height: 48 },
	{ name: 'Visioneer', src: '/logos/visioneer.svg', height: 36 },
	{ name: 'ACLA', src: '/logos/acla.svg', height: 40 },
	{ name: 'Nesta', src: '/logos/nesta.svg', height: 48 },
	{ name: 'Pioneer Polska', src: '/logos/pioneer-polska.svg', height: 44 },
	{ name: 'Hokofast', src: '/logos/hokofast.svg', height: 42 },
	{ name: 'Med Tracker IO', src: '/logos/med-tracker-io.svg', height: 34 },
].map((client) => ({
	...client,
	alts: getClientLogoAlts(client.name),
	altsJson: JSON.stringify(getClientLogoAlts(client.name)),
}));

const rowSize = Math.ceil(clientEntries.length / 3);
const logoRows = [
	{ direction: 'ltr' as const, clients: clientEntries.slice(0, rowSize) },
	{ direction: 'rtl' as const, clients: clientEntries.slice(rowSize, rowSize * 2) },
	{ direction: 'ltr' as const, clients: clientEntries.slice(rowSize * 2) },
];
---

<section id="clients-section" class="relative z-20 bg-[#0A0A0B] px-[var(--page-gutter)] py-[var(--section-padding-y)]">
	<div class="grid gap-6 md:grid-cols-2 md:gap-16">
		<h2 id="clients-heading" class="clients-heading max-w-sm uppercase leading-[1.15]">
			<span data-reveal-line data-i18n="clients.heading1">{t(locale, 'clients.heading1')}</span>
			<br />
			<span data-reveal-line data-i18n="clients.heading2">{t(locale, 'clients.heading2')}</span>
		</h2>
		<p class="body-txt-1 clients-description max-w-md leading-relaxed md:ml-auto" data-i18n="clients.description">{t(locale, 'clients.description')}</p>
	</div>

	<div id="clients-logos" class="clients-marquees mt-10 md:mt-20" aria-label="Client logos">
		{
			logoRows.map((row) => (
				<div class={`clients-marquee clients-marquee--${row.direction}`} data-direction={row.direction}>
					<div class="clients-marquee__track">
						{[0, 1].map((copy) => (
							<ul class="clients-marquee__group" aria-hidden={copy === 1 ? 'true' : undefined}>
								{row.clients.map((client) => (
									<li class="client-logo-item">
										<img
											src={client.src}
											alt={copy === 0 ? client.alts.en : ''}
											width="200"
											height={client.height}
											style={`--logo-h: ${client.height}px`}
											class="h-auto w-auto max-w-none object-contain object-center brightness-0 invert"
											loading="eager"
											decoding="async"
											data-alts={copy === 0 ? client.altsJson : undefined}
											aria-hidden={copy === 1 ? 'true' : undefined}
										/>
									</li>
								))}
							</ul>
						))}
					</div>
				</div>
			))
		}
	</div>
</section>

<style is:global>
	.clients-heading {
		line-height: 1.15;
	}

	.clients-description {
		color: #ffffff;
	}

	#clients-heading .reveal-char {
		color: rgba(255, 255, 255, 0.15);
		transition: color 0.35s ease-out;
	}

	#clients-heading .reveal-char.active {
		color: rgba(255, 255, 255, 1);
	}

	.clients-marquees {
		--clients-marquee-gap: clamp(1.75rem, 4vw, 5rem);
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
		margin-inline: calc(var(--page-gutter) * -1);
		opacity: 0;
		transform: translateY(8px);
		transition:
			opacity 0.8s ease,
			transform 0.8s cubic-bezier(0.25, 1, 0.5, 1);
		-webkit-mask-image: linear-gradient(
			to right,
			transparent,
			#000 8%,
			#000 92%,
			transparent
		);
		mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
		-webkit-user-select: none;
		user-select: none;
	}

	.clients-marquees.is-visible {
		opacity: 1;
		transform: translateY(0);
	}

	.clients-marquee {
		overflow: hidden;
		width: 100%;
	}

	.clients-marquee__track {
		display: flex;
		width: max-content;
		will-change: transform;
	}

	.clients-marquee__group {
		display: flex;
		align-items: center;
		flex-shrink: 0;
		gap: var(--clients-marquee-gap);
		/* One trailing gap so the seam between duplicated groups matches item spacing */
		padding: 0;
		margin: 0;
		padding-right: var(--clients-marquee-gap);
		list-style: none;
	}

	.client-logo-item {
		display: flex;
		flex-shrink: 0;
		align-items: center;
		justify-content: center;
		min-height: 48px;
		opacity: 0.6;
		transition: opacity 0.35s ease;
	}

	.client-logo-item:hover {
		opacity: 1;
	}

	.client-logo-item img {
		max-height: calc(var(--logo-h) * 0.72);
		-webkit-user-drag: none;
		pointer-events: none;
	}

	@media (min-width: 768px) {
		.client-logo-item {
			min-height: 68px;
		}

		.client-logo-item img {
			max-height: var(--logo-h);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.clients-marquee__track {
			width: 100%;
			justify-content: center;
			flex-wrap: wrap;
			row-gap: 1.5rem;
			transform: none !important;
		}

		.clients-marquee__group[aria-hidden='true'] {
			display: none;
		}

		.clients-marquee__group {
			padding-right: 0;
			flex-wrap: wrap;
			justify-content: center;
		}
	}
</style>

<script>
	function wrapLetters(element: HTMLElement) {
		const text = element.textContent ?? '';
		element.textContent = '';

		for (const char of text) {
			const span = document.createElement('span');
			span.className = 'reveal-char';
			span.textContent = char === ' ' ? ' ' : char;
			element.appendChild(span);
		}
	}

	function updateHeadingReveal() {
		const heading = document.getElementById('clients-heading');
		if (!heading) return;

		const chars = heading.querySelectorAll('.reveal-char');
		if (!chars.length) return;

		const rect = heading.getBoundingClientRect();
		const viewportHeight = window.innerHeight;
		const startLine = viewportHeight * 0.88;
		const endLine = viewportHeight * 0.45;
		const range = startLine - endLine;
		const progress = Math.min(1, Math.max(0, (startLine - rect.top) / range));
		const activeCount = Math.ceil(progress * chars.length);

		chars.forEach((char, index) => {
			char.classList.toggle('active', index < activeCount);
		});
	}

	function revealClientLogos() {
		const logos = document.getElementById('clients-logos');
		if (!logos || logos.dataset.revealed === 'true') return;

		logos.dataset.revealed = 'true';
		logos.classList.add('is-visible');
	}

	function initLogosReveal() {
		const logos = document.getElementById('clients-logos');
		if (!logos) return;

		if (logos.dataset.revealed === 'true') return;

		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						revealClientLogos();
						observer.disconnect();
					}
				}
			},
			{ threshold: 0.15, rootMargin: '0px 0px -5% 0px' },
		);

		observer.observe(logos);

		const rect = logos.getBoundingClientRect();
		if (rect.top < window.innerHeight * 0.85 && rect.bottom > 0) {
			revealClientLogos();
			observer.disconnect();
		}
	}

	type MarqueeState = {
		root: HTMLElement;
		track: HTMLElement;
		direction: 1 | -1;
		offset: number;
		velocity: number;
		targetSpeed: number;
		loopWidth: number;
		paused: boolean;
	};

	const SPEED_PX_PER_SEC = 42;
	const VELOCITY_LERP = 0.06;

	function wrapOffset(offset: number, loopWidth: number) {
		if (loopWidth <= 0) return offset;
		const wrapped = offset % loopWidth;
		return wrapped > 0 ? wrapped - loopWidth : wrapped;
	}

	function initClientMarquees() {
		const root = document.getElementById('clients-logos');
		if (!root || root.dataset.marqueeInit === 'true') return;
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

		root.dataset.marqueeInit = 'true';

		const rows = Array.from(root.querySelectorAll<HTMLElement>('.clients-marquee'));
		const states: MarqueeState[] = [];

		const measureState = (state: MarqueeState) => {
			const group = state.track.querySelector<HTMLElement>('.clients-marquee__group');
			const nextWidth = group?.getBoundingClientRect().width ?? state.track.scrollWidth / 2;
			if (!nextWidth) return;

			const prevWidth = state.loopWidth;
			state.loopWidth = nextWidth;

			if (prevWidth > 0 && Math.abs(prevWidth - nextWidth) > 0.5) {
				const progress = prevWidth ? state.offset / prevWidth : 0;
				state.offset = progress * nextWidth;
			}

			state.offset = wrapOffset(state.offset, state.loopWidth);
			state.track.style.transform = `translate3d(${state.offset}px, 0, 0)`;
		};

		rows.forEach((row) => {
			const track = row.querySelector<HTMLElement>('.clients-marquee__track');
			if (!track) return;

			const direction: 1 | -1 = row.dataset.direction === 'ltr' ? 1 : -1;
			const state: MarqueeState = {
				root: row,
				track,
				direction,
				offset: 0,
				velocity: SPEED_PX_PER_SEC * direction,
				targetSpeed: SPEED_PX_PER_SEC,
				loopWidth: 0,
				paused: false,
			};

			measureState(state);
			states.push(state);

			row.addEventListener('mouseenter', () => {
				state.paused = true;
			});
			row.addEventListener('mouseleave', () => {
				state.paused = false;
			});
		});

		const remeasureAll = () => {
			for (const state of states) measureState(state);
		};

		root.querySelectorAll('img').forEach((img) => {
			if (img.complete) return;
			img.addEventListener('load', remeasureAll, { once: true });
			img.addEventListener('error', remeasureAll, { once: true });
		});

		window.addEventListener('resize', remeasureAll, { passive: true });

		let lastTime = performance.now();

		const tick = (now: number) => {
			const dt = Math.min((now - lastTime) / 1000, 0.064);
			lastTime = now;

			for (const state of states) {
				if (!state.loopWidth) continue;

				const desired = state.paused ? 0 : state.targetSpeed * state.direction;
				state.velocity += (desired - state.velocity) * VELOCITY_LERP;

				if (Math.abs(state.velocity) < 0.05 && state.paused) {
					state.velocity = 0;
				}

				state.offset = wrapOffset(state.offset + state.velocity * dt, state.loopWidth);
				state.track.style.transform = `translate3d(${state.offset}px, 0, 0)`;
			}

			requestAnimationFrame(tick);
		};

		requestAnimationFrame(tick);
	}

	function initClientsSection() {
		const heading = document.getElementById('clients-heading');

		if (heading && heading.dataset.revealInit !== 'true') {
			heading.dataset.revealInit = 'true';
			heading.querySelectorAll('[data-reveal-line]').forEach((line) => {
				wrapLetters(line as HTMLElement);
			});

			updateHeadingReveal();
			window.addEventListener('scroll', onScroll, { passive: true });
			window.addEventListener('resize', updateHeadingReveal, { passive: true });
		}

		initLogosReveal();
		initClientMarquees();
	}

	let ticking = false;

	function onScroll() {
		if (ticking) return;
		ticking = true;
		requestAnimationFrame(() => {
			updateHeadingReveal();
			ticking = false;
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initClientsSection, { once: true });
	} else {
		initClientsSection();
	}

	document.addEventListener('astro:page-load', initClientsSection);
</script>
