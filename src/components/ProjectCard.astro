---
import type { CollectionEntry } from 'astro:content';
import { withPublicAssetVersion } from '../utils/withPublicAssetVersion';

interface Props {
	project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, thumbnail, video, comingSoon = false } = project.data;
const titles = {
	en: title,
	pl: project.data.i18n?.pl?.title || title,
	es: project.data.i18n?.es?.title || title,
};
const label = title.toUpperCase();
const thumbnailSrc = withPublicAssetVersion(thumbnail);
const videoSrc = video ? withPublicAssetVersion(video) : '';
const isRiveCover = thumbnail.toLowerCase().endsWith('.riv');
const cardClass = 'project-card project-card__cursor-target group flex h-full flex-col';
const titlesJson = JSON.stringify(titles);
---

{
	comingSoon ? (
		<div
			class={cardClass}
			data-coming-soon="true"
			data-cursor-i18n="projects.soon"
			data-project-titles={titlesJson}
			role="group"
			aria-label={`${title} — coming soon`}
		>
			<div class="project-card__media overflow-hidden bg-[#E8E8E8]">
				{isRiveCover ? (
					<canvas
						class="project-card__rive block h-auto w-full"
						data-rive-cover={thumbnailSrc}
						aria-label={title}
					></canvas>
				) : video ? (
					<video
						src={videoSrc}
						class="block h-auto w-full object-contain"
						autoplay
						muted
						loop
						playsinline
						preload="metadata"
						aria-hidden="true"
					/>
				) : (
					<img
						src={thumbnailSrc}
						alt={title}
						width="960"
						height="600"
						class="block h-auto w-full object-contain transition-transform duration-500 ease-out group-hover:scale-[1.02]"
						loading="lazy"
					/>
				)}
			</div>

			<div class="project-card__meta mt-5 flex items-start justify-between gap-4">
				<h3 class="project-card__title min-w-0 flex-1 text-[1.2rem] font-semibold uppercase tracking-[0.02em] text-black md:text-[1.4rem]">
					<span class="project-card__title-mask">
						<span class="project-card__title-copy" data-project-title-text>{label}</span>
						<span class="project-card__title-copy" data-project-title-text aria-hidden="true">{label}</span>
					</span>
				</h3>
			</div>
		</div>
	) : (
		<a
			href={`/projects/${project.id}`}
			class={cardClass}
			data-cursor-i18n="projects.view"
			data-project-titles={titlesJson}
		>
			<div class="project-card__media overflow-hidden bg-[#E8E8E8]">
				{isRiveCover ? (
					<canvas
						class="project-card__rive block h-auto w-full"
						data-rive-cover={thumbnailSrc}
						aria-label={title}
					></canvas>
				) : video ? (
					<video
						src={videoSrc}
						class="block h-auto w-full object-contain"
						autoplay
						muted
						loop
						playsinline
						preload="metadata"
						aria-hidden="true"
					/>
				) : (
					<img
						src={thumbnailSrc}
						alt={title}
						width="960"
						height="600"
						class="block h-auto w-full object-contain transition-transform duration-500 ease-out group-hover:scale-[1.02]"
						loading="lazy"
					/>
				)}
			</div>

			<div class="project-card__meta mt-5 flex items-start justify-between gap-4">
				<h3 class="project-card__title min-w-0 flex-1 text-[1.2rem] font-semibold uppercase tracking-[0.02em] text-black md:text-[1.4rem]">
					<span class="project-card__title-mask">
						<span class="project-card__title-copy" data-project-title-text>{label}</span>
						<span class="project-card__title-copy" data-project-title-text aria-hidden="true">{label}</span>
					</span>
				</h3>

				<img
					src="/icons/arrow.svg"
					alt=""
					width="20"
					height="16"
					class="project-card__arrow mt-[0.15em] w-[20px] shrink-0 transition-transform duration-300 group-hover:translate-x-1"
					aria-hidden="true"
				/>
			</div>
		</a>
	)
}

<style is:global>
	.project-card__title {
		overflow: hidden;
		font-size: 1.2rem;
		font-weight: 600;
		line-height: 1.15;
	}

	@media (min-width: 768px) {
		.project-card__title {
			font-size: 1.4rem;
		}
	}

	.project-card__title-mask {
		display: grid;
		width: 100%;
		min-width: 0;
		overflow: hidden;
	}

	.project-card__title-copy {
		grid-area: 1 / 1;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		line-height: 1.15;
		transition: transform 300ms ease;
	}

	.project-card__title-copy:last-child {
		transform: translateY(110%);
	}

	.project-card:hover .project-card__title-copy:first-child {
		transform: translateY(-110%);
		transition-duration: 450ms;
		transition-timing-function: ease-out;
	}

	.project-card:hover .project-card__title-copy:last-child {
		transform: translateY(0);
		transition-duration: 450ms;
		transition-timing-function: ease-out;
	}

	.project-card[data-coming-soon='true'] {
		cursor: default;
	}

	.project-card__rive {
		aspect-ratio: 4 / 3;
		width: 100%;
	}
</style>

<script>
	import { Alignment, Fit, Layout, Rive } from '@rive-app/canvas';

	function initRiveCovers() {
		document.querySelectorAll<HTMLCanvasElement>('[data-rive-cover]').forEach((canvas) => {
			if (canvas.dataset.riveInitialized === 'true') return;
			const src = canvas.dataset.riveCover;
			if (!src) return;

			canvas.dataset.riveInitialized = 'true';
			let restarting = false;
			let rive: Rive;

			const loopCover = () => {
				if (restarting || !rive) return;
				restarting = true;

				const animations = rive.animationNames;
				if (animations.length > 0) {
					rive.play(animations);
				} else {
					const stateMachine = rive.stateMachineNames[0];
					rive.reset({
						stateMachine,
						autoplay: true,
					});
				}

				requestAnimationFrame(() => {
					restarting = false;
				});
			};

			rive = new Rive({
				src,
				canvas,
				autoplay: false,
				layout: Layout.new({ fit: Fit.Cover, alignment: Alignment.Center }),
				onLoad: loopCover,
				onStop: loopCover,
			});

			const resizeCanvas = () => {
				const rect = canvas.getBoundingClientRect();
				const pixelRatio = Math.min(window.devicePixelRatio || 1, 2);
				if (!rect.width || !rect.height) return;

				canvas.width = Math.round(rect.width * pixelRatio);
				canvas.height = Math.round(rect.height * pixelRatio);
				rive.resizeDrawingSurfaceToCanvas();
			};

			resizeCanvas();
			new ResizeObserver(resizeCanvas).observe(canvas);
		});
	}

	initRiveCovers();
	document.addEventListener('astro:page-load', initRiveCovers);
</script>
