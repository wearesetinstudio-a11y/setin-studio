---
import type { CollectionEntry } from 'astro:content';
import { resolveProjectFolderName } from '../utils/getProjectGallery';
import { normalizeProjectCategories } from '../utils/projectCategories';
import { resolveCoverPoster } from '../utils/resolveCoverPoster';
import { withPublicAssetVersion } from '../utils/withPublicAssetVersion';

interface Props {
	project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, thumbnail, video, tags = [], comingSoon = false } = project.data;
const titles = {
	en: title,
	pl: project.data.i18n?.pl?.title || title,
	es: project.data.i18n?.es?.title || title,
};
const label = title.toUpperCase();
const categoryTags = normalizeProjectCategories(tags);
const thumbnailSrc = withPublicAssetVersion(thumbnail);
const videoSrc = video ? withPublicAssetVersion(video) : '';
const posterSrc = resolveCoverPoster(resolveProjectFolderName(project));
const isRiveCover = thumbnail.toLowerCase().endsWith('.riv');
const cardClass = 'project-card project-card__cursor-target group flex h-full flex-col';
const titlesJson = JSON.stringify(titles);
---

{
	comingSoon ? (
		<div
			class={cardClass}
			data-coming-soon="true"
			data-cursor-i18n="projects.soon"
			data-project-titles={titlesJson}
			role="group"
			aria-label={`${title} — coming soon`}
		>
			<div class="project-card__media relative overflow-hidden bg-[#E8E8E8]">
				{isRiveCover ? (
					<>
						{posterSrc && (
							<img
								src={posterSrc}
								alt=""
								width="960"
								height="600"
								class="project-card__poster"
								decoding="async"
								loading="lazy"
								aria-hidden="true"
							/>
						)}
						<canvas
							class="project-card__rive relative z-[1] block h-auto w-full"
							data-rive-cover={thumbnailSrc}
							aria-label={title}
						></canvas>
					</>
				) : video ? (
					<video
						src={videoSrc}
						poster={posterSrc || undefined}
						class="block h-auto w-full object-contain"
						muted
						loop
						playsinline
						preload="none"
						aria-hidden="true"
					/>
				) : (
					<img
						src={thumbnailSrc}
						alt={title}
						width="960"
						height="600"
						class="block h-auto w-full object-contain transition-transform duration-500 ease-out group-hover:scale-[1.02]"
						loading="lazy"
					/>
				)}
				<span class="project-card__soon-label" data-i18n="projects.comingSoon">Coming soon</span>
			</div>

			<div class="project-card__meta mt-5 flex items-end justify-between gap-4">
				<div class="project-card__info min-w-0 flex-1">
					<h3 class="project-card__title font-semibold uppercase tracking-[0.02em]">
						<span class="project-card__title-mask">
							<span class="project-card__title-copy" data-project-title-text>{label}</span>
							<span class="project-card__title-copy" data-project-title-text aria-hidden="true">{label}</span>
						</span>
					</h3>
					{categoryTags.length > 0 && (
						<ul class="project-card__tags" aria-label="Categories">
							{categoryTags.map((tag) => (
								<li class="project-card__tag">{tag.toUpperCase()}</li>
							))}
						</ul>
					)}
				</div>

				<img
					src="/icons/arrow-muted.svg"
					alt=""
					width="20"
					height="16"
					class="project-card__arrow mb-[0.2em] w-[20px] shrink-0 transition-transform duration-300 group-hover:translate-x-1"
					aria-hidden="true"
				/>
			</div>
		</div>
	) : (
		<a
			href={`/projects/${project.id}`}
			class={cardClass}
			data-cursor-i18n="projects.view"
			data-project-titles={titlesJson}
		>
			<div class="project-card__media relative overflow-hidden bg-[#E8E8E8]">
				{isRiveCover ? (
					<>
						{posterSrc && (
							<img
								src={posterSrc}
								alt=""
								width="960"
								height="600"
								class="project-card__poster"
								decoding="async"
								loading="lazy"
								aria-hidden="true"
							/>
						)}
						<canvas
							class="project-card__rive relative z-[1] block h-auto w-full"
							data-rive-cover={thumbnailSrc}
							aria-label={title}
						></canvas>
					</>
				) : video ? (
					<video
						src={videoSrc}
						poster={posterSrc || undefined}
						class="block h-auto w-full object-contain"
						muted
						loop
						playsinline
						preload="none"
						aria-hidden="true"
					/>
				) : (
					<img
						src={thumbnailSrc}
						alt={title}
						width="960"
						height="600"
						class="block h-auto w-full object-contain transition-transform duration-500 ease-out group-hover:scale-[1.02]"
						loading="lazy"
					/>
				)}
			</div>

			<div class="project-card__meta mt-5 flex items-end justify-between gap-4">
				<div class="project-card__info min-w-0 flex-1">
					<h3 class="project-card__title font-semibold uppercase tracking-[0.02em] text-black">
						<span class="project-card__title-mask">
							<span class="project-card__title-copy" data-project-title-text>{label}</span>
							<span class="project-card__title-copy" data-project-title-text aria-hidden="true">{label}</span>
						</span>
					</h3>
					{categoryTags.length > 0 && (
						<ul class="project-card__tags" aria-label="Categories">
							{categoryTags.map((tag) => (
								<li class="project-card__tag">{tag.toUpperCase()}</li>
							))}
						</ul>
					)}
				</div>

				<img
					src="/icons/arrow.svg"
					alt=""
					width="20"
					height="16"
					class="project-card__arrow mb-[0.2em] w-[20px] shrink-0 transition-transform duration-300 group-hover:translate-x-1"
					aria-hidden="true"
				/>
			</div>
		</a>
	)
}

<style is:global>
	.project-card__title {
		overflow: hidden;
		font-size: 1rem;
		font-weight: 600;
		line-height: 1.15;
	}

	@media (min-width: 768px) {
		.project-card__title {
			font-size: 1.15rem;
		}
	}

	.project-card__title-mask {
		display: grid;
		width: 100%;
		min-width: 0;
		overflow: hidden;
	}

	.project-card__title-copy {
		grid-area: 1 / 1;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		line-height: 1.15;
		transition: transform 300ms ease;
	}

	.project-card__title-copy:last-child {
		transform: translateY(110%);
	}

	.project-card:hover .project-card__title-copy:first-child {
		transform: translateY(-110%);
		transition-duration: 450ms;
		transition-timing-function: ease-out;
	}

	.project-card:hover .project-card__title-copy:last-child {
		transform: translateY(0);
		transition-duration: 450ms;
		transition-timing-function: ease-out;
	}

	.project-card[data-coming-soon='true'] {
		cursor: default;
	}

	.project-card[data-coming-soon='true'] .project-card__title {
		color: #626873;
	}

	.project-card__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-top: 0.75rem;
		padding: 0;
		list-style: none;
	}

	.project-card__tag {
		padding: 0.28rem 0.55rem;
		background: #efefef;
		color: #000000;
		font-size: 0.7rem;
		font-weight: 600;
		line-height: 1.2;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.project-card[data-coming-soon='true'] .project-card__tag {
		background: #ececec;
		color: #626873;
	}

	.project-card__soon-label {
		position: absolute;
		right: 0;
		bottom: 0;
		z-index: 1;
		padding: 4px 10px;
		background: #ffffff;
		color: #000000;
		font-size: 16px;
		font-weight: 600;
		line-height: normal;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.project-card__rive {
		aspect-ratio: 4 / 3;
		width: 100%;
	}

	.project-card__poster {
		position: absolute;
		inset: 0;
		z-index: 0;
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
		object-position: center;
		pointer-events: none;
	}
</style>

<script>
	import { initRiveCovers } from '../scripts/initRiveCovers';
	import { initProjectMediaVisibility } from '../scripts/initProjectMediaVisibility';

	function initProjectCardMedia() {
		initRiveCovers();
		initProjectMediaVisibility();
	}

	initProjectCardMedia();
	document.addEventListener('astro:page-load', initProjectCardMedia);
</script>
