---
interface Props {
	id?: string;
	num?: string;
	index: number;
	label: string;
	title?: string;
	text: string;
	headingId?: string;
	sectionIndex?: number;
}

const {
	id,
	num,
	index,
	label,
	title = '',
	text,
	headingId = '',
	sectionIndex,
} = Astro.props;

const titleChars = title.split('');
const paragraphs = text.split(/\n\n+/).map((part) => part.trim()).filter(Boolean);
const resolvedHeadingId = headingId || (title ? `project-section-${index}-heading` : '');
const resolvedSectionId =
	id || (sectionIndex != null ? `project-section-${sectionIndex + 1}` : `project-section-${index}`);
const resolvedNum = num || String(sectionIndex != null ? sectionIndex + 2 : index).padStart(2, '0');
---

<section
	id={resolvedSectionId}
	class="project-content-block w-full"
	data-project-section={sectionIndex != null ? sectionIndex : undefined}
>
	<p class="project-content-block__label">
		<span class="project-content-block__num">{resolvedNum}&nbsp;/&nbsp;</span>
		<span class="project-content-block__label-bracket"
			>[<span data-project-section-field="label">{label.toUpperCase()}</span>]</span
		>
	</p>

	{
		title ? (
			<h2 id={resolvedHeadingId} class="project-content-block__heading" data-project-section-field="title">
				<span class="project-content-block__heading-line" data-reveal-line>
					{titleChars.map((char) => (
						<span class="reveal-char">{char === ' ' ? ' ' : char}</span>
					))}
				</span>
			</h2>
		) : null
	}

	{
		paragraphs.length > 0 ? (
			<div
				class:list={['project-content-block__paragraphs', title && 'project-content-block__paragraphs--with-title']}
				data-project-section-field="text"
				data-paragraph-class="body-txt-1 project-content-block__text"
			>
				{paragraphs.map((paragraph) => (
					<p class="body-txt-1 project-content-block__text">{paragraph}</p>
				))}
			</div>
		) : null
	}
</section>

<style>
	.project-content-block {
		scroll-margin-top: 7.5rem;
		background: #ffffff;
		color: #0A0A0B;
	}

	.project-content-block__label {
		margin: 0;
		font-size: 1.25rem;
		font-weight: 600;
		line-height: 1.2;
		letter-spacing: 0;
		text-transform: uppercase;
	}

	.project-content-block__num {
		color: #5e697c;
		font-variant-numeric: tabular-nums;
	}

	.project-content-block__label-bracket {
		color: #0A0A0B;
	}

	@media (max-width: 1023px) {
		.project-content-block__label {
			font-size: 1rem;
		}
	}

	.project-content-block__heading {
		margin-top: 1.75rem;
		font-weight: 600;
		text-transform: uppercase;
		line-height: 1.12;
		letter-spacing: -0.01em;
		color: transparent;
	}

	.project-content-block__heading-line {
		display: inline;
		white-space: normal;
		overflow-wrap: anywhere;
	}

	.project-content-block__heading :global(.reveal-char) {
		color: rgba(0, 0, 0, 0.15);
		transition: color 0.35s ease-out;
	}

	.project-content-block__heading :global(.reveal-char.active) {
		color: #000000;
	}

	.project-content-block__paragraphs {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		margin-top: 1.75rem;
		color: rgba(0, 0, 0, 0.55);
	}

	.project-content-block__paragraphs--with-title {
		margin-top: 1.5rem;
	}

	.project-content-block__text {
		margin: 0;
		line-height: 1.625;
	}
</style>
