---
interface Props {
	label: string;
	value: string;
	/** Visible link text when different from the href value. */
	linkText?: string;
	isLink?: boolean;
	isLast?: boolean;
	theme?: 'dark' | 'light';
	labelKey?: string;
	fieldKey?: string;
}

const {
	label,
	value,
	linkText,
	isLink = false,
	isLast = false,
	theme = 'dark',
	labelKey,
	fieldKey,
} = Astro.props;

const labelClass =
	theme === 'dark'
		? 'text-sm font-semibold uppercase tracking-[0.02em] text-white/40 md:text-base'
		: 'text-sm font-semibold uppercase tracking-[0.02em] text-black/40 md:text-base';

const valueClass =
	theme === 'dark'
		? 'text-right text-sm font-semibold uppercase leading-snug tracking-[0.02em] text-white md:text-base'
		: 'text-right text-sm font-semibold uppercase leading-snug tracking-[0.02em] text-[#131415] md:text-base';
---

<div
	class:list={[
		'grid grid-cols-[120px_1fr] items-start gap-6 py-5 md:grid-cols-[140px_1fr] md:gap-10 md:py-6',
		!isLast && (theme === 'dark' ? 'border-b border-white/10' : 'border-b border-black/10'),
	]}
>
	<dt class={labelClass} data-i18n={labelKey}>{label}</dt>
	<dd class={valueClass}>
		{
			isLink ? (
				<a
					href={value.startsWith('http') ? value : `https://${value}`}
					class:list={[
						'underline underline-offset-4 transition-colors',
						theme === 'dark'
							? 'decoration-white/30 hover:decoration-white'
							: 'decoration-black/30 hover:decoration-black',
					]}
					target="_blank"
					rel="noreferrer"
					data-project-field={fieldKey}
				>
					{(linkText || value).replace(/^https?:\/\//, '').replace(/\/$/, '')}
				</a>
			) : (
				<span data-project-field={fieldKey}>{value}</span>
			)
		}
	</dd>
</div>
