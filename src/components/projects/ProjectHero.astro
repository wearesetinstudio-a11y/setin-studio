---
interface Props {
	heroImage?: string;
	heroLines: string[];
	client: string;
}

const { heroImage = '', heroLines, client } = Astro.props;
const clientLabel = client.toUpperCase();
const heroRawText = heroLines.join('\n').trim();
---

<section id="project-hero" class="project-hero relative h-[100vh] overflow-hidden">
	{
		heroImage ? (
			<div
				id="project-hero-visual"
				class="project-hero-visual pointer-events-none absolute inset-0 isolate z-0 overflow-hidden bg-[#131415]"
				aria-hidden="true"
			>
				<div class="project-hero-photo-shift">
					<img
						src={heroImage}
						alt=""
						width="1920"
						height="1080"
						class="project-hero-background pointer-events-none absolute inset-0"
						loading="eager"
						decoding="async"
						aria-hidden="true"
					/>
				</div>

				<div class="pointer-events-none absolute inset-0 z-[1] bg-black/10"></div>

				<canvas
					id="project-hero-noise-filter"
					class="pointer-events-none absolute inset-0 z-[2] block h-full w-full bg-transparent"
					aria-hidden="true"
				></canvas>
			</div>
		) : (
			<div id="project-hero-visual" class="pointer-events-none absolute inset-0 bg-[#131415]" aria-hidden="true"></div>
		)
	}

	<div class="relative z-10 flex h-full items-end px-[var(--page-gutter)] pb-[calc(6.75rem+env(safe-area-inset-bottom,0px))] pt-28 md:pb-[72px]">
		<div class="project-hero__row flex w-full flex-col gap-[40px] lg:flex-row lg:items-end lg:gap-[56px]">
			<div class="project-hero__title-wrap min-w-0 flex-1">
				<h3
					id="hero-headline"
					class="project-hero__title project-hero-headline text-h3 w-full uppercase text-white"
					data-project-hero-headline
					data-raw-text={heroRawText}
				>
					{heroRawText}
				</h3>
			</div>

			<div class="project-hero__client shrink-0 lg:text-right" data-project-hero-client>
				<p class="project-hero__client-label text-[1.2rem] font-semibold uppercase tracking-[0.14em] text-white">
					[<span data-i18n="project.client">Client</span>]
				</p>
				<p
					class="project-hero__client-name mt-3 font-semibold uppercase leading-[1.08] tracking-tight text-white"
					data-project-field="client"
				>
					{clientLabel}
				</p>
			</div>
		</div>
	</div>
</section>

<style is:global>
	.project-hero-visual {
		overflow: hidden;
		transform: translateZ(0);
	}

	.project-hero-visual.is-hidden {
		opacity: 0;
		visibility: hidden;
	}

	.project-hero-photo-shift {
		position: absolute;
		inset: 0;
		height: 100%;
		width: 100%;
		overflow: hidden;
		transform: translate3d(0, 0, 0);
		backface-visibility: hidden;
	}

	.project-hero-background {
		top: 0;
		left: 0;
		width: 100%;
		min-width: 100%;
		height: 100%;
		min-height: 100%;
		object-fit: cover;
		object-position: center center;
		backface-visibility: hidden;
	}

	/* Desktop: parallax lag. Mobile: fixed bg, no motion. */
	@media (min-width: 768px) {
		.project-hero-photo-shift {
			will-change: transform;
		}

		.project-hero-background {
			transform: scale(1.24) translateZ(0);
			transform-origin: center center;
		}
	}

	@media (max-width: 767px) {
		.project-hero-visual {
			position: fixed !important;
			inset: 0 !important;
			width: 100%;
			height: 100%;
			height: 100svh;
		}

		.project-hero-background {
			transform: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.project-hero-photo-shift {
			transform: translate3d(0, 0, 0) !important;
			will-change: auto;
		}

		.project-hero-background {
			transform: scale(1.05) translateZ(0);
		}

		@media (max-width: 767px) {
			.project-hero-background {
				transform: none;
			}
		}
	}

	.project-hero__client-name {
		font-size: 1.2rem;
	}

	@media (min-width: 768px) {
		.project-hero__client-name {
			font-size: 1.8rem;
		}
	}

	@media (min-width: 1024px) {
		.project-hero__client {
			max-width: 18rem;
		}
	}

	/* Same reveal pattern as home hero headline */
	.project-hero-headline:not([data-prepared]) {
		opacity: 0;
	}

	.project-hero-headline .hero-reveal-mask {
		display: block;
		overflow: hidden;
		padding-top: 0.08em;
	}

	.project-hero-headline .hero-reveal-line {
		display: block;
		transform: translateY(110%);
		opacity: 0;
		transition:
			transform 1200ms cubic-bezier(0.16, 1, 0.3, 1),
			opacity 1200ms cubic-bezier(0.16, 1, 0.3, 1);
		transition-delay: calc(var(--i, 0) * 90ms);
	}

	.project-hero-headline.project-hero-headline--fixed-lines .hero-reveal-line {
		white-space: nowrap;
	}

	.project-hero-headline .hero-reveal-line.is-revealed {
		transform: translateY(0);
		opacity: 1;
	}

	.project-hero__client:not(.is-revealed) {
		pointer-events: none;
	}

	.project-hero__client {
		opacity: 0;
		transform: translateY(0.75rem);
		transition:
			opacity 900ms cubic-bezier(0.16, 1, 0.3, 1),
			transform 900ms cubic-bezier(0.16, 1, 0.3, 1);
		transition-delay: calc(280ms + (var(--client-i, 0) * 90ms));
	}

	.project-hero__client.is-revealed {
		opacity: 1;
		transform: translateY(0);
	}
</style>

<script>
	import { initCinemaPureNoise } from '../../scripts/initCinemaPureNoise.ts';
	import { getLenis } from '../../scripts/initSmoothScroll.ts';
	import { PAGE_TRANSITION_OVERLAY_ID } from '../../scripts/pageTransitionPanel.ts';

	type TransitionPhase = 'idle' | 'covering' | 'covered' | 'revealing';

	type TransitionWindow = Window &
		typeof globalThis & {
			__setinPageTransitionPhase?: TransitionPhase;
		};

	function getTransitionPhase(): TransitionPhase {
		return (window as TransitionWindow).__setinPageTransitionPhase ?? 'idle';
	}

	function isPageTransitionBlocking(): boolean {
		const phase = getTransitionPhase();
		if (phase === 'covering' || phase === 'covered' || phase === 'revealing') return true;

		const overlay = document.getElementById(PAGE_TRANSITION_OVERLAY_ID);
		return Boolean(overlay?.classList.contains('is-active') || overlay?.classList.contains('is-covered'));
	}

	function waitForPageReveal(callback: () => void) {
		let done = false;
		const run = () => {
			if (done) return;
			done = true;
			callback();
		};

		if (!isPageTransitionBlocking()) {
			requestAnimationFrame(() => {
				requestAnimationFrame(run);
			});
			return;
		}

		window.addEventListener('page-transition-reveal-complete', run, { once: true });
		if (!isPageTransitionBlocking()) {
			run();
			return;
		}
		window.setTimeout(run, 2200);
	}

	function normalizeHeroCopy(text: string): string {
		return text.replace(/[^\S\u00a0]+/g, ' ').trim();
	}

	function measureWrappedLines(container: HTMLElement, raw: string): string[] {
		container.textContent = '';
		const words = raw.split(' ').filter(Boolean);
		const wordSpans = words.map((word, index) => {
			const span = document.createElement('span');
			span.textContent = index < words.length - 1 ? `${word} ` : word;
			container.appendChild(span);
			return span;
		});

		const lines: string[][] = [];
		let currentLine: string[] = [];
		let currentTop = wordSpans[0]?.offsetTop ?? 0;

		for (const span of wordSpans) {
			if (span.offsetTop > currentTop + 1) {
				lines.push(currentLine);
				currentLine = [];
				currentTop = span.offsetTop;
			}
			currentLine.push((span.textContent ?? '').replace(/ $/, ''));
		}
		if (currentLine.length) lines.push(currentLine);

		return lines.map((lineWords) => lineWords.join(' '));
	}

	function splitProjectHeroHeadline(container: HTMLElement) {
		const raw = (container.dataset.rawText || container.textContent || '').replace(/\r/g, '').trim();
		if (!raw) return 0;

		container.dataset.rawText = raw;
		const wasRevealed = container.dataset.revealed === 'true';
		const hasFixedLines = raw.includes('\n');

		const lines = hasFixedLines
			? raw
					.split('\n')
					.map((line) => line.trim())
					.filter(Boolean)
			: measureWrappedLines(container, normalizeHeroCopy(raw));

		container.classList.toggle('project-hero-headline--fixed-lines', hasFixedLines);
		container.replaceChildren();

		lines.forEach((lineText, index) => {
			const mask = document.createElement('span');
			mask.className = 'hero-reveal-mask';

			const line = document.createElement('span');
			line.className = 'hero-reveal-line';
			line.style.setProperty('--i', String(index));
			line.textContent = lineText;

			if (wasRevealed) {
				line.style.transition = 'none';
				line.classList.add('is-revealed');
			}

			mask.appendChild(line);
			container.appendChild(mask);
		});

		container.dataset.prepared = 'true';

		if (wasRevealed) {
			requestAnimationFrame(() => {
				container.querySelectorAll<HTMLElement>('.hero-reveal-line').forEach((line) => {
					line.style.removeProperty('transition');
				});
			});
		}

		return lines.length;
	}

	function prepareProjectHeroCopy() {
		const headline = document.querySelector<HTMLElement>('[data-project-hero-headline]');
		const client = document.querySelector<HTMLElement>('[data-project-hero-client]');
		if (!headline) return;

		const wasRevealed = headline.dataset.revealed === 'true';
		const lineCount = splitProjectHeroHeadline(headline);
		if (client) {
			client.style.setProperty('--client-i', String(Math.max(lineCount, 1)));
			if (wasRevealed) {
				client.classList.add('is-revealed');
			}
		}
	}

	function revealProjectHeroText() {
		const headline = document.querySelector<HTMLElement>('[data-project-hero-headline]');
		const client = document.querySelector<HTMLElement>('[data-project-hero-client]');
		if (!headline || headline.dataset.revealed === 'true') return;

		// Ensure split lines exist and are painted hidden before toggling.
		if (headline.dataset.prepared !== 'true') {
			prepareProjectHeroCopy();
		}

		void headline.offsetWidth;

		requestAnimationFrame(() => {
			if (headline.dataset.revealed === 'true') return;
			headline.dataset.revealed = 'true';
			headline.querySelectorAll('.hero-reveal-line').forEach((element) => {
				element.classList.add('is-revealed');
			});
			client?.classList.add('is-revealed');
		});
	}

	function initProjectHeroVisual() {
		const hero = document.getElementById('project-hero');
		const visual = document.getElementById('project-hero-visual');
		if (!hero || !visual || hero.dataset.heroVisualInit === 'true') return;
		hero.dataset.heroVisualInit = 'true';

		initCinemaPureNoise('project-hero-noise-filter', { observeElementId: 'project-hero' });

		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const mobileQuery = window.matchMedia('(max-width: 767px)');
		const shift = visual.querySelector<HTMLElement>('.project-hero-photo-shift');

		let target = 0;
		let current = 0;
		let rafId = 0;
		let parallaxRunning = false;
		const TRAVEL = 0.12;
		const LERP = 0.22;

		const syncFixedVisibility = () => {
			visual.classList.toggle('is-hidden', hero.getBoundingClientRect().bottom <= 0);
		};

		const readTarget = () => {
			const rect = hero.getBoundingClientRect();
			const vh = window.innerHeight;
			const start = vh;
			const end = -rect.height;
			const range = start - end;
			const progress =
				range === 0 ? 0 : Math.min(1, Math.max(0, (start - rect.top) / range));
			const max = rect.height * TRAVEL;
			target = -max + progress * (2 * max);
		};

		const tick = () => {
			if (!parallaxRunning || !shift) return;
			current += (target - current) * LERP;
			if (Math.abs(target - current) < 0.05) current = target;
			shift.style.transform = `translate3d(0, ${current}px, 0)`;
			rafId = requestAnimationFrame(tick);
		};

		const stopParallax = () => {
			parallaxRunning = false;
			cancelAnimationFrame(rafId);
			rafId = 0;
			if (shift) shift.style.transform = 'translate3d(0, 0, 0)';
		};

		const startParallax = () => {
			if (!shift || reduceMotion || parallaxRunning) return;
			parallaxRunning = true;
			readTarget();
			current = target;
			rafId = requestAnimationFrame(tick);
		};

		const onScroll = () => {
			if (mobileQuery.matches) {
				syncFixedVisibility();
				return;
			}
			readTarget();
		};

		const applyMode = () => {
			if (mobileQuery.matches) {
				stopParallax();
				syncFixedVisibility();
				return;
			}
			visual.classList.remove('is-hidden');
			startParallax();
		};

		applyMode();
		window.addEventListener('scroll', onScroll, { passive: true });
		getLenis()?.on('scroll', onScroll);
		mobileQuery.addEventListener('change', applyMode);
		window.addEventListener('resize', applyMode, { passive: true });

		document.addEventListener(
			'astro:before-preparation',
			() => {
				stopParallax();
			},
			{ once: true },
		);
	}

	function initProjectHeroReveal() {
		const hero = document.getElementById('project-hero');
		if (!hero || hero.dataset.heroRevealInit === 'true') return;

		hero.dataset.heroRevealInit = 'true';
		prepareProjectHeroCopy();
		waitForPageReveal(revealProjectHeroText);
	}

	function initProjectHero() {
		if (!document.getElementById('project-hero')) return;
		initProjectHeroVisual();
		initProjectHeroReveal();
	}

	// Single entry point — avoids double reveal from script boot + page-load.
	document.addEventListener('astro:page-load', initProjectHero);

	window.addEventListener('setin:project-copy-applied', () => {
		const headline = document.querySelector<HTMLElement>('[data-project-hero-headline]');
		if (!headline) return;
		prepareProjectHeroCopy();
		if (headline.dataset.revealed === 'true') {
			headline.querySelectorAll('.hero-reveal-line').forEach((element) => {
				element.classList.add('is-revealed');
			});
			document.querySelector<HTMLElement>('[data-project-hero-client]')?.classList.add('is-revealed');
		}
	});

	let resizeTimer = 0;
	let lastResizeWidth = 0;
	window.addEventListener(
		'resize',
		() => {
			const width = window.innerWidth;
			if (width === lastResizeWidth) return;
			lastResizeWidth = width;

			window.clearTimeout(resizeTimer);
			resizeTimer = window.setTimeout(() => {
				const headline = document.querySelector<HTMLElement>('[data-project-hero-headline]');
				if (!headline || headline.dataset.prepared !== 'true') return;
				// Rebuild wrap lines quietly — no second entrance animation.
				prepareProjectHeroCopy();
			}, 150);
		},
		{ passive: true },
	);
</script>
