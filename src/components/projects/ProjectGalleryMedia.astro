---
import type { GalleryMediaItem } from '../../utils/getProjectGallery';
import type { LocalizedAlt } from '../../utils/projectImageAlt';

interface Props {
	item: GalleryMediaItem;
	/** @deprecated Prefer `alts` for SEO-localized descriptions */
	title?: string;
	index: number;
	alts: LocalizedAlt;
}

const { item, index, alts } = Astro.props;
const label = alts.en;
const altsJson = JSON.stringify(alts);
/** Heavy gallery clips with audio (e.g. `1.1.mp4`) — play on click, not muted autoplay. */
const isClickPlayVideo =
	item.type === 'video' && item.filename.toLowerCase().endsWith('.mp4');
const clickPlaySrc = isClickPlayVideo ? `${item.src}#t=0.1` : item.src;
---

{
	item.type === 'image' ? (
		<figure class="project-gallery__item m-0 w-full">
			<img
				src={item.src}
				alt={label}
				width="1600"
				height="1000"
				class="block h-auto w-full"
				loading={index < 1 ? 'eager' : 'lazy'}
				decoding="async"
				sizes="(min-width: 1024px) 70vw, 100vw"
				data-alts={altsJson}
			/>
		</figure>
	) : item.type === 'rive' ? (
		<figure class="project-gallery__item project-gallery__item--rive m-0 w-full">
			<canvas
				class="project-gallery__rive block h-auto w-full bg-white"
				data-rive-cover={item.src}
				data-rive-fit="contain"
				data-alts={altsJson}
				aria-label={label}
			></canvas>
		</figure>
	) : isClickPlayVideo ? (
		<figure
			class="project-gallery__item project-gallery__item--video project-gallery__play project-gallery__video-slot m-0 w-full is-loading"
			data-click-play
			data-gallery-video-slot
			style="aspect-ratio: 16 / 9"
		>
			<video
				class="project-gallery__play-video project-gallery__video block h-auto w-full bg-black object-cover"
				width="1280"
				height="720"
				preload="metadata"
				playsinline
				data-alts={altsJson}
				aria-label={label}
			>
				<source src={clickPlaySrc} type="video/mp4" />
			</video>
			<button
				type="button"
				class="project-gallery__play-button"
				data-click-play-button
				aria-label="Play video with sound"
			>
				<svg width="28" height="32" viewBox="0 0 28 32" fill="none" aria-hidden="true">
					<path d="M27 16L1 31V1L27 16Z" fill="white"></path>
				</svg>
			</button>
		</figure>
	) : (
		<figure
			class="project-gallery__item project-gallery__item--video project-gallery__video-slot m-0 w-full is-loading"
			data-gallery-video-slot
			style="aspect-ratio: 4 / 3"
		>
			<video
				src={item.src}
				class="project-gallery__video block h-auto w-full"
				muted
				loop
				playsinline
				preload="none"
				data-buffered-autoplay
				data-alts={altsJson}
				aria-label={label}
			/>
		</figure>
	)
}

<style>
	.project-gallery__rive {
		aspect-ratio: 1980 / 476;
		width: 100%;
	}

	.project-gallery__video-slot {
		position: relative;
		display: block;
		overflow: hidden;
		width: 100%;
		background: #e4e4e4;
	}

	.project-gallery__video-slot.is-loading::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 1;
		pointer-events: none;
		background: linear-gradient(
			110deg,
			#e4e4e4 25%,
			#ededed 37%,
			#e4e4e4 63%
		);
		background-size: 200% 100%;
		animation: project-gallery-shimmer 1.4s ease-in-out infinite;
	}

	.project-gallery__video-slot > .project-gallery__video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: contain;
		opacity: 0;
		transition: opacity 0.35s ease;
	}

	.project-gallery__play-video {
		opacity: 0;
		transition: opacity 0.35s ease;
	}

	.project-gallery__video-slot.is-ready > .project-gallery__video,
	.project-gallery__video-slot.is-ready .project-gallery__play-video {
		opacity: 1;
	}

	.project-gallery__video-slot.is-ready::after {
		opacity: 0;
		animation: none;
		transition: opacity 0.25s ease;
	}

	@keyframes project-gallery-shimmer {
		0% {
			background-position: 100% 0;
		}
		100% {
			background-position: -100% 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.project-gallery__video-slot.is-loading::after {
			animation: none;
		}

		.project-gallery__video {
			transition: none;
		}
	}

	.project-gallery__play {
		background: #e4e4e4;
	}

	.project-gallery__play-video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.project-gallery__play-button {
		position: absolute;
		top: 50%;
		left: 50%;
		z-index: 2;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 88px;
		height: 88px;
		padding-left: 6px;
		border: 1px solid rgba(255, 255, 255, 0.6);
		border-radius: 9999px;
		background: rgba(13, 14, 15, 0.35);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		transform: translate(-50%, -50%);
		cursor: pointer;
		transition:
			transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
			background-color 0.3s ease,
			opacity 0.3s ease;
	}

	.project-gallery__play-button:hover {
		background: rgba(13, 14, 15, 0.55);
		transform: translate(-50%, -50%) scale(1.06);
	}

	.project-gallery__play.is-playing .project-gallery__play-button {
		opacity: 0;
		pointer-events: none;
	}

	@media (width < 768px) {
		.project-gallery__play-button {
			width: 64px;
			height: 64px;
			padding-left: 4px;
		}

		.project-gallery__play-button svg {
			width: 20px;
			height: 23px;
		}
	}
</style>

<script>
	import { initRiveCovers } from '../../scripts/initRiveCovers';
	import { initBufferedAutoplayVideos } from '../../scripts/initBufferedAutoplayVideos';
	import { initPitchPlayVideo } from '../../scripts/initPitchPlayVideo';
	import { initGalleryVideoSlots } from '../../scripts/initGalleryVideoSlots';

	const boot = () => {
		initRiveCovers();
		initGalleryVideoSlots();
		initBufferedAutoplayVideos();
		initPitchPlayVideo();
	};

	boot();
	document.addEventListener('astro:page-load', boot);
</script>
