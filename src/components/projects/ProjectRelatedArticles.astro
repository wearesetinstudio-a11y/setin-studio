---
interface Props {
	articles: { slug: string; title: string }[];
}

const { articles } = Astro.props;
---

{
	articles.length > 0 ? (
		<div class="project-related-articles">
			<div class="grid grid-cols-[120px_1fr] items-start gap-6 py-5 md:grid-cols-[140px_1fr] md:gap-10 md:py-6">
				<dt class="m-0 whitespace-nowrap text-sm uppercase tracking-[0.12em] text-black/40 md:text-base">
					Related articles
				</dt>
			</div>

			<ul class="project-related-articles__list flex flex-col gap-5 pb-5 md:gap-6 md:pb-6">
				{
					articles.map((article) => (
						<li>
							<a
								href={`/articles/${article.slug}`}
								class="project-related-articles__link text-base font-medium leading-snug text-[#131415] md:text-xl"
							>
								{article.title}
							</a>
						</li>
					))
				}
			</ul>
		</div>
	) : null
}

<style>
	.project-related-articles__list {
		padding-left: 0;
	}

	.project-related-articles__link {
		display: inline;
		text-decoration: underline;
		text-decoration-color: #131415;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.2em;
		transition: opacity 0.2s ease;
	}

	@media (hover: hover) and (pointer: fine) {
		.project-related-articles__link:hover {
			opacity: 0.65;
		}
	}

	@media (hover: none), (pointer: coarse) {
		.project-related-articles__link:active {
			opacity: 0.65;
		}
	}
</style>
