---
import type { CollectionEntry } from 'astro:content';
import ProjectCard from './ProjectCard.astro';
import SeeAllProjectsCard from './SeeAllProjectsCard.astro';

interface Props {
	projects: CollectionEntry<'projects'>[];
	standalone?: boolean;
}

const { projects, standalone = false } = Astro.props;
const displayedProjects = standalone ? projects : projects.slice(0, 3);

const leftProjects: CollectionEntry<'projects'>[] = [];
const rightProjects: CollectionEntry<'projects'>[] = [];

if (standalone) {
	displayedProjects.forEach((project, index) => {
		if (index % 2 === 0) rightProjects.push(project);
		else leftProjects.push(project);
	});
} else {
	// Homepage Figma: left (narrow) = 1 project + more; right = 2 projects
	rightProjects.push(...displayedProjects.slice(0, 2));
	leftProjects.push(...displayedProjects.slice(2, 3));
}

function listOrder(project: CollectionEntry<'projects'>) {
	return displayedProjects.findIndex((entry) => entry.id === project.id) + 1;
}
---

<section
	id="work"
	class:list={[
		'relative z-20 px-[var(--page-gutter)] py-[var(--section-padding-y)]',
		standalone ? 'bg-white pt-[calc(var(--section-padding-y)+5.5rem)]' : 'bg-[#F5F5F5]',
	]}
>
	<div class="projects-layout flex flex-col md:grid md:items-stretch">
		<div class="projects-layout__col projects-layout__col--left contents md:flex md:h-full md:flex-col">
			<div class="projects-intro order-0 flex flex-col gap-6 md:order-none md:gap-8">
				<h2 id="projects-heading" class="projects-heading max-w-md uppercase leading-[1.15]">
					<span data-reveal-line data-i18n="projects.heading">Our finest work</span>
				</h2>
				<p
					class="body-txt-1 projects-description max-w-md leading-relaxed text-black/55"
					data-i18n="projects.description"
				>
					We don't follow trends, we set the tone. These are the collaborations that redefined the
					standard for our partners.
				</p>
			</div>

			{
				leftProjects.map((project) => (
					<div class="projects-layout__item" style={`--mobile-order: ${listOrder(project)}`}>
						<ProjectCard project={project} />
					</div>
				))
			}
			{
				!standalone && (
					<div class="projects-layout__item projects-layout__item--last projects-layout__see-all">
						<SeeAllProjectsCard count={projects.length} />
					</div>
				)
			}
		</div>

		<div class="projects-layout__col projects-layout__col--right contents md:flex md:h-full md:flex-col">
			{
				rightProjects.map((project) => (
					<div class="projects-layout__item" style={`--mobile-order: ${listOrder(project)}`}>
						<ProjectCard project={project} />
					</div>
				))
			}
		</div>
	</div>

	<div id="project-cursor" class="project-cursor pointer-events-none fixed z-[200]" aria-hidden="true">
		<span class="project-cursor__label">
			<span data-i18n="projects.view" data-project-cursor-label>view</span>
			<span class="project-cursor__line"></span>
		</span>
	</div>
</section>

<style is:global>
	.projects-heading {
		color: #000000;
	}

	.projects-layout {
		--projects-gap: 2.5rem;
		gap: var(--projects-gap);
	}

	.projects-layout__col {
		gap: var(--projects-gap);
	}

	.projects-layout__item {
		order: var(--mobile-order, 0);
	}

	.projects-layout__item--last {
		order: 99;
	}

	@media (min-width: 768px) {
		.projects-layout {
			--projects-gap: 3.25rem;
			grid-template-columns: minmax(0, 0.88fr) minmax(0, 1fr);
			column-gap: var(--projects-gap);
			row-gap: var(--projects-gap);
		}

		.projects-layout__item,
		.projects-layout__item--last {
			order: unset;
		}

		.projects-layout__see-all {
			display: flex;
			flex: 1 1 auto;
			min-height: 12rem;
		}

		.projects-layout__see-all .see-all-projects {
			flex: 1 1 auto;
			min-height: 100%;
		}
	}

	#projects-heading .reveal-char {
		color: rgba(0, 0, 0, 0.15);
		transition: color 0.35s ease-out;
	}

	#projects-heading .reveal-char.active {
		color: rgba(0, 0, 0, 1);
	}

	.project-cursor {
		left: 0;
		top: 0;
		display: flex;
		width: 7.5rem;
		height: 7.5rem;
		align-items: center;
		justify-content: center;
		border-radius: 9999px;
		background-color: #ffffff;
		opacity: 0;
		visibility: hidden;
		transform: translate3d(-9999px, -9999px, 0) translate(-50%, -50%) scale(0.92);
		transition: opacity 0.22s ease-out, visibility 0s linear 0.22s;
		backface-visibility: hidden;
	}

	.project-cursor.is-active {
		opacity: 1;
		visibility: visible;
		transition: opacity 0.22s ease-out, visibility 0s linear 0s;
	}

	.project-cursor__label {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.125rem;
		font-size: 1.2rem;
		font-weight: 800;
		line-height: 1;
		text-transform: uppercase;
		color: #18191b;
	}

	.project-cursor__line {
		width: 100%;
		height: 1.5px;
		background-color: #18191b;
	}

	body[data-project-cursor-init='true'] .project-card__cursor-target {
		cursor: none;
	}

	@media (max-width: 767px) {
		.project-cursor {
			display: none !important;
		}

		body[data-project-cursor-init='true'] .project-card__cursor-target {
			cursor: auto;
		}
	}
</style>

<script>
	function initProjectCursor() {
		const workSection = document.getElementById('work');
		if (!workSection) {
			delete document.body.dataset.projectCursorInit;
			document.getElementById('site-cursor')?.classList.remove('is-suppressed');
			document.getElementById('site-cursor-sparks')?.classList.remove('is-suppressed');
			return;
		}

		if (window.matchMedia('(max-width: 767px)').matches) {
			delete document.body.dataset.projectCursorInit;
			document.getElementById('site-cursor')?.classList.remove('is-suppressed');
			document.getElementById('site-cursor-sparks')?.classList.remove('is-suppressed');
			workSection.dataset.projectCursorReady = 'true';
			return;
		}

		if (workSection.dataset.projectCursorReady === 'true') return;

		const cursor = document.getElementById('project-cursor');
		const siteCursor = document.getElementById('site-cursor');
		const siteSparks = document.getElementById('site-cursor-sparks');
		if (!cursor) return;

		const cursorLabel = cursor.querySelector<HTMLElement>('[data-project-cursor-label]');
		const cards = workSection.querySelectorAll('.project-card__cursor-target');
		if (!cards.length) return;

		workSection.dataset.projectCursorReady = 'true';
		document.body.dataset.projectCursorInit = 'true';

		let hovering = false;
		let activeCard: Element | null = null;
		let rafId = 0;
		let targetX = window.innerWidth / 2;
		let targetY = window.innerHeight / 2;
		let currentX = targetX;
		let currentY = targetY;
		let currentScale = 0.92;
		const lag = 0.32;
		const scaleLag = 0.42;

		function getCursorLocale(): 'en' | 'pl' | 'es' {
			const lang = document.documentElement.lang?.toLowerCase() ?? 'en';
			if (lang.startsWith('pl')) return 'pl';
			if (lang.startsWith('es')) return 'es';
			return 'en';
		}

		function setCursorLabel(i18nKey: string) {
			if (!cursorLabel) return;
			cursorLabel.dataset.i18n = i18nKey;
			const locale = getCursorLocale();
			const fallback: Record<string, Record<string, string>> = {
				en: { 'projects.view': 'view', 'projects.soon': 'soon' },
				pl: { 'projects.view': 'zobacz', 'projects.soon': 'wkrótce' },
				es: { 'projects.view': 'ver', 'projects.soon': 'pronto' },
			};
			cursorLabel.textContent = fallback[locale]?.[i18nKey] ?? fallback.en[i18nKey] ?? 'view';
		}

		function animateCursor() {
			currentX += (targetX - currentX) * lag;
			currentY += (targetY - currentY) * lag;

			const targetScale = hovering ? 1 : 0.92;
			currentScale += (targetScale - currentScale) * scaleLag;

			cursor.style.transform = `translate3d(${currentX}px, ${currentY}px, 0) translate(-50%, -50%) scale(${currentScale})`;

			const positionSettled =
				Math.abs(targetX - currentX) < 0.4 && Math.abs(targetY - currentY) < 0.4;
			const scaleSettled = Math.abs(targetScale - currentScale) < 0.002;

			if (hovering || !positionSettled || !scaleSettled) {
				rafId = requestAnimationFrame(animateCursor);
			} else {
				rafId = 0;
			}
		}

		function startCursorAnimation() {
			if (!rafId) {
				rafId = requestAnimationFrame(animateCursor);
			}
		}

		function showCursor(clientX: number, clientY: number) {
			targetX = clientX;
			targetY = clientY;
			if (!hovering) {
				currentX = clientX;
				currentY = clientY;
				currentScale = 0.97;
			}
			hovering = true;
			cursor.classList.add('is-active');
			siteCursor?.classList.add('is-suppressed');
			siteSparks?.classList.add('is-suppressed');
			startCursorAnimation();
		}

		function hideCursor() {
			hovering = false;
			cursor.classList.remove('is-active');
			siteCursor?.classList.remove('is-suppressed');
			siteSparks?.classList.remove('is-suppressed');
			startCursorAnimation();
		}

		cards.forEach((card) => {
			card.addEventListener(
				'mouseenter',
				(event) => {
					const mouseEvent = event as MouseEvent;
					activeCard = card;
					const key =
						(card as HTMLElement).dataset.cursorI18n ||
						((card as HTMLElement).dataset.comingSoon === 'true'
							? 'projects.soon'
							: 'projects.view');
					setCursorLabel(key);
					showCursor(mouseEvent.clientX, mouseEvent.clientY);
				},
				{ passive: true },
			);

			card.addEventListener(
				'mouseleave',
				() => {
					if (activeCard === card) {
						activeCard = null;
						hideCursor();
					}
				},
				{ passive: true },
			);
		});

		workSection.addEventListener(
			'mousemove',
			(event) => {
				if (!hovering || !activeCard) return;

				targetX = event.clientX;
				targetY = event.clientY;
				startCursorAnimation();
			},
			{ passive: true },
		);
	}

	function wrapLetters(element: HTMLElement) {
		const text = element.textContent ?? '';
		element.textContent = '';

		for (const char of text) {
			const span = document.createElement('span');
			span.className = 'reveal-char';
			span.textContent = char === ' ' ? ' ' : char;
			element.appendChild(span);
		}
	}

	function updateProjectsHeadingReveal() {
		const heading = document.getElementById('projects-heading');
		if (!heading) return;

		const chars = heading.querySelectorAll('.reveal-char');
		if (!chars.length) return;

		const rect = heading.getBoundingClientRect();
		const viewportHeight = window.innerHeight;
		const startLine = viewportHeight * 0.88;
		const endLine = viewportHeight * 0.45;
		const range = startLine - endLine;
		const progress = Math.min(1, Math.max(0, (startLine - rect.top) / range));
		const activeCount = Math.ceil(progress * chars.length);

		chars.forEach((char, index) => {
			char.classList.toggle('active', index < activeCount);
		});
	}

	let scrollTicking = false;

	function onProjectsScroll() {
		if (scrollTicking) return;
		scrollTicking = true;
		requestAnimationFrame(() => {
			updateProjectsHeadingReveal();
			scrollTicking = false;
		});
	}

	function initProjectsHeadingReveal() {
		const heading = document.getElementById('projects-heading');
		if (!heading || heading.dataset.revealInit === 'true') return;

		heading.dataset.revealInit = 'true';

		heading.querySelectorAll('[data-reveal-line]').forEach((line) => {
			wrapLetters(line as HTMLElement);
		});

		updateProjectsHeadingReveal();

		const scrollWindow = window as Window & { __setinProjectsScrollReady?: boolean };
		if (scrollWindow.__setinProjectsScrollReady) return;

		scrollWindow.__setinProjectsScrollReady = true;
		window.addEventListener('scroll', onProjectsScroll, { passive: true });
		window.addEventListener('resize', updateProjectsHeadingReveal, { passive: true });
	}

	function initProjectsSection() {
		initProjectCursor();
		initProjectsHeadingReveal();
	}

	document.addEventListener('astro:page-load', initProjectsSection);

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initProjectsSection, { once: true });
	} else {
		initProjectsSection();
	}
</script>
