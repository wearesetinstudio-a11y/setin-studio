---
interface Props {
	href?: string;
	label?: string;
	variant?: 'light' | 'dark';
	size?: 'default' | 'large';
	i18nKey?: string;
	count?: number;
}

const {
	href = '/#contact',
	label = 'Work with us',
	variant = 'light',
	size = 'default',
	i18nKey = 'nav.workWithUs',
	count,
} = Astro.props;

const isDark = variant === 'dark';
const textColor = isDark ? 'text-black' : 'text-setin-fg';
const underlineColor = isDark ? 'bg-black' : 'bg-white';
const textSize = size === 'large' ? 'text-[2rem]' : 'text-[1.2rem]';
const lineClass = `flex h-[1.5em] items-center leading-[1.15] ${textSize} font-semibold uppercase ${textColor}`;
const isStatic = size === 'large';
const displayLabel = count !== undefined ? `${label} [${count}]` : label;
const useCount = count !== undefined;
---

<div class:list={['work-with-us-button group relative inline-block', size !== 'large' && 'work-with-us-button--padded']}>
	<a href={href} class={`work-with-us-button__link relative block ${textColor}`}>
		{
			isStatic ? (
				<span
					class={lineClass}
					data-i18n-count={useCount ? i18nKey : undefined}
					data-count={useCount ? String(count) : undefined}
					data-i18n={useCount ? undefined : i18nKey}
				>
					{displayLabel}
				</span>
			) : (
				<div class="flex h-[1.5em] flex-col overflow-hidden">
					<div
						class="flex flex-col transition-transform duration-300 ease-in group-hover:-translate-y-1/2 group-hover:duration-[450ms] group-hover:ease-out"
					>
						<span
							class={lineClass}
							data-i18n-count={useCount ? i18nKey : undefined}
							data-count={useCount ? String(count) : undefined}
							data-i18n={useCount ? undefined : i18nKey}
						>
							{displayLabel}
						</span>
						<span
							class={lineClass}
							data-i18n-count={useCount ? i18nKey : undefined}
							data-count={useCount ? String(count) : undefined}
							data-i18n={useCount ? undefined : i18nKey}
						>
							{displayLabel}
						</span>
					</div>
				</div>
			)
		}
	</a>

	<div
		class={`work-with-us-button__underline absolute -bottom-1 left-0 h-[1.5px] w-full origin-left scale-x-100 transition-transform duration-300 ease-out group-hover:origin-right group-hover:scale-x-0 ${underlineColor}`}
		aria-hidden="true"
	></div>
</div>

<style>
	/* Expand hit area without moving the underline under the label */
	.work-with-us-button--padded .work-with-us-button__link::before {
		content: '';
		position: absolute;
		inset: -0.85rem -0.75rem;
	}
</style>
