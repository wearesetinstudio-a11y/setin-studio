---
interface Props {
	category: string;
	projectHref?: string;
	title: string;
	author: string;
	publishedLabel: string;
}

const { category, projectHref = '', title, author, publishedLabel } = Astro.props;
const categoryLabel = category.toUpperCase();
---

<header class="article-hero px-[var(--article-gutter)] pt-[calc(var(--section-padding-y)+5.5rem)]">
	<div class="article-hero__inner border-b border-black/10 pb-12 md:pb-16">
		{
			projectHref ? (
				<a
					href={projectHref}
					class="article-hero__category inline-block font-semibold uppercase text-black transition-opacity hover:opacity-60"
				>
					[{categoryLabel}]
				</a>
			) : (
				<p class="article-hero__category font-semibold uppercase text-black">[{categoryLabel}]</p>
			)
		}

		<h1 class="article-hero__title mt-8 text-black">{title}</h1>

		<div class="article-hero__meta mt-10 flex flex-col gap-3 font-semibold uppercase tracking-[0.02em] text-black/55 sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-10 sm:gap-y-2">
			<p>
				<span data-i18n="articles.writtenBy">Written by</span> <span class="text-black">{author}</span>
			</p>
			<p><span data-i18n="articles.published">Published:</span> {publishedLabel}</p>
		</div>
	</div>
</header>

<style is:global>
	.article-hero__category,
	.article-hero__meta {
		font-size: 1.15rem;
	}

	.article-hero__title {
		font-size: 2rem;
		font-weight: 600;
		line-height: 1.18;
		letter-spacing: -0.01em;
	}

	@media (min-width: 768px) {
		.article-hero__title {
			font-size: 2.75rem;
		}
	}
</style>
