---
interface Props {
	class?: string;
	embedded?: boolean;
}

const { class: className = '', embedded = false } = Astro.props;
---

<div
	class:list={[
		'article-prose',
		!embedded && 'px-[var(--article-gutter)] py-16 md:py-24',
		className,
	]}
>
	<slot />
</div>

<style is:global>
	.article-prose {
		color: rgba(0, 0, 0, 0.72);
	}

	.article-prose h2 {
		margin-top: 3.5rem;
		font-size: 1.5rem;
		font-weight: 600;
		line-height: 1.12;
		letter-spacing: -0.01em;
		text-transform: uppercase;
		color: #000000;
	}

	@media (min-width: 768px) {
		.article-prose h2 {
			font-size: 1.95rem;
		}
	}

	.article-prose h2:first-child {
		margin-top: 0;
	}

	.article-prose p {
		margin-top: 1.5rem;
		line-height: 1.625;
		font-size: var(--body-txt-1-size);
	}

	.article-prose p strong {
		font-weight: 600;
		color: #000000;
	}
</style>
