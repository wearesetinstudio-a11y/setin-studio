---
import { t, type Locale } from '../i18n/dictionaries.ts';

interface Props {
	/** When set, render chrome copy in this locale (pitch pages). */
	locale?: Locale;
}

const { locale = 'en' } = Astro.props;

const emailHref =
	'mailto:wearesetinstudio@gmail.com?subject=Hello%20Setin!%20:)';

const socialLinks = [
	{
		label: 'WhatsApp',
		href: 'https://api.whatsapp.com/message/IDQVMTROBPOXM1?autoload=1&app_absent=0',
	},
	{
		label: 'Instagram',
		href: 'https://www.instagram.com/weare_setin_studio/',
	},
	{
		label: 'Facebook',
		href: 'https://www.facebook.com/wearesetinstudio?locale=pl_PL',
	},
	{
		label: 'LinkedIn',
		href: 'https://www.linkedin.com/company/wearesetin',
	},
	{
		label: 'YouTube',
		href: 'https://www.youtube.com/channel/UCqJVj469YiK-Lg51OJ7FVoQ',
	},
];

const contactHeading = t(locale, 'contact.heading');
const contactDescription = t(locale, 'contact.description');
const contactEmail = t(locale, 'contact.email');
---

<section
	id="contact"
	class="relative z-20 overflow-x-clip bg-[#131415] px-[var(--page-gutter)] py-[var(--band-padding-y)]"
>
	<div class="grid min-w-0 gap-20 lg:grid-cols-2 lg:items-start lg:gap-24">
		<div class="flex min-w-0 flex-col">
			<h2
				id="contact-heading"
				class="contact-heading w-full max-w-full uppercase leading-[1.15] text-setin-fg md:max-w-md"
			>
				<span data-reveal-line data-i18n="contact.heading">{contactHeading}</span>
			</h2>

			<p
				class="body-txt-1 contact-description mt-6 w-full max-w-full leading-relaxed text-setin-fg/55"
				data-i18n="contact.description"
			>
				{contactDescription}
			</p>

			<div id="contact-email-wrap" class="contact-email-cta-wrap mt-10 w-full min-w-0 max-w-full">
				<a
					href={emailHref}
					id="contact-email-cta"
					class="contact-email-cta group relative box-border block w-full max-w-full px-5 py-5 md:px-10 md:py-7"
				>
					<span class="contact-email-cta__inner relative z-10 flex w-full items-center justify-between">
						<span class="contact-email-cta__label-wrap flex h-[1.5em] flex-col overflow-hidden">
							<span class="contact-email-cta__roll-inner flex flex-col">
								<span
									class="contact-email-cta__label-line contact-email-cta__label-line--default flex h-[1.5em] items-center text-[1rem] font-semibold uppercase leading-none md:text-[1.05rem]"
									data-i18n="contact.email"
								>
									{contactEmail}
								</span>
								<span
									class="contact-email-cta__label-line contact-email-cta__label-line--hover flex h-[1.5em] items-center text-[1rem] font-semibold uppercase leading-none md:text-[1.05rem]"
									data-i18n="contact.email"
								>
									{contactEmail}
								</span>
							</span>
						</span>
						<img
							src="/icons/arrow.svg"
							alt=""
							width="20"
							height="16"
							class="contact-email-cta__arrow w-[20px] shrink-0"
						/>
					</span>
				</a>
			</div>
		</div>

		<div class="contact-social lg:ml-auto lg:w-full lg:max-w-md">
			{
				socialLinks.map((link) => (
					<a
						href={link.href}
						class="contact-social__link group block border-b border-white/15 py-6 transition-colors duration-300 hover:border-white md:py-7"
						target="_blank"
						rel="noopener noreferrer"
					>
						<span class="contact-social__inner flex items-center justify-between gap-8">
							<span class="contact-social__label-wrap flex h-[1.5em] flex-col overflow-hidden">
								<span
									class="flex flex-col transition-transform duration-300 ease-in group-hover:-translate-y-1/2 group-hover:duration-[450ms] group-hover:ease-out"
								>
									<span
										class="contact-social__label-line flex h-[1.5em] items-center text-[1rem] font-semibold uppercase leading-none text-setin-fg"
									>
										{link.label}
									</span>
									<span
										class="contact-social__label-line flex h-[1.5em] items-center text-[1rem] font-semibold uppercase leading-none text-setin-fg"
									>
										{link.label}
									</span>
								</span>
							</span>
							<img
								src="/icons/simple-arrow.svg"
								alt=""
								width="22"
								height="18"
								class="contact-social__arrow h-4 w-auto"
							/>
						</span>
					</a>
				))
			}
		</div>
	</div>
</section>

<style is:global>
	.contact-heading {
		color: #f5f5f5;
		overflow-wrap: anywhere;
		word-break: break-word;
	}

	#contact-heading [data-reveal-line] {
		white-space: normal;
	}

	#contact-heading .reveal-char {
		color: rgba(255, 255, 255, 0.15);
		transition: color 0.35s ease-out;
	}

	#contact-heading .reveal-char.active {
		color: rgba(255, 255, 255, 1);
	}

	.contact-description {
		overflow-wrap: anywhere;
		word-break: break-word;
	}

	.contact-email-cta-wrap {
		max-width: 100%;
	}

	.contact-email-cta {
		background-color: #252628;
		max-width: 100%;
		transition:
			transform 0.4s cubic-bezier(0.25, 1, 0.5, 1),
			background-color 0.35s ease;
	}

	.contact-email-cta__inner {
		padding-inline: 0;
		transition: padding-inline 0.45s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.contact-email-cta:focus-visible .contact-email-cta__inner,
	.contact-email-cta.is-hovering .contact-email-cta__inner {
		padding-inline: 8px;
	}

	@media (hover: hover) and (pointer: fine) {
		.contact-email-cta:hover .contact-email-cta__inner {
			padding-inline: 8px;
		}
	}

	@media (hover: none), (pointer: coarse) {
		.contact-email-cta:active .contact-email-cta__inner {
			padding-inline: 8px;
		}
	}

	.contact-email-cta__label-line,
	.contact-email-cta__arrow {
		transition:
			color 0.35s ease,
			filter 0.35s ease;
	}

	.contact-email-cta__label-line--default {
		color: #f5f5f5;
	}

	.contact-email-cta__label-line--hover {
		color: #18191b !important;
	}

	.contact-email-cta__roll-inner {
		transition: transform 0.45s cubic-bezier(0.25, 1, 0.5, 1);
	}

	.contact-email-cta:focus-visible .contact-email-cta__roll-inner,
	.contact-email-cta.is-hovering .contact-email-cta__roll-inner {
		transform: translateY(-50%);
	}

	@media (hover: hover) and (pointer: fine) {
		.contact-email-cta:hover .contact-email-cta__roll-inner {
			transform: translateY(-50%);
		}
	}

	@media (hover: none), (pointer: coarse) {
		.contact-email-cta:active .contact-email-cta__roll-inner {
			transform: translateY(-50%);
		}
	}

	.contact-email-cta:focus-visible .contact-email-cta__label-line--default,
	.contact-email-cta.is-hovering .contact-email-cta__label-line--default {
		color: #18191b;
	}

	@media (hover: hover) and (pointer: fine) {
		.contact-email-cta:hover .contact-email-cta__label-line--default {
			color: #18191b;
		}
	}

	@media (hover: none), (pointer: coarse) {
		.contact-email-cta:active .contact-email-cta__label-line--default {
			color: #18191b;
		}
	}

	.contact-email-cta__arrow {
		filter: brightness(0) invert(1);
	}

	.contact-email-cta:focus-visible,
	.contact-email-cta.is-hovering {
		background-color: #ffffff;
	}

	@media (hover: hover) and (pointer: fine) {
		.contact-email-cta:hover {
			background-color: #ffffff;
		}
	}

	@media (hover: none), (pointer: coarse) {
		.contact-email-cta:active {
			background-color: #ffffff;
		}
	}

	.contact-email-cta:focus-visible .contact-email-cta__arrow,
	.contact-email-cta.is-hovering .contact-email-cta__arrow {
		filter: none;
	}

	@media (hover: hover) and (pointer: fine) {
		.contact-email-cta:hover .contact-email-cta__arrow {
			filter: none;
		}
	}

	@media (hover: none), (pointer: coarse) {
		.contact-email-cta:active .contact-email-cta__arrow {
			filter: none;
		}
	}

	.contact-social__inner {
		padding-inline: 0;
		transition: padding-inline 0.45s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.contact-social__link:focus-visible .contact-social__inner {
		padding-inline: 8px;
	}

	@media (hover: hover) and (pointer: fine) {
		.contact-social__link:hover .contact-social__inner {
			padding-inline: 8px;
		}
	}

	@media (hover: none), (pointer: coarse) {
		.contact-social__link:active .contact-social__inner {
			padding-inline: 8px;
		}
	}

	.contact-social__arrow {
		transition: transform 0.35s cubic-bezier(0.25, 1, 0.5, 1);
	}

	.contact-social__link:focus-visible .contact-social__arrow {
		transform: translateX(-6px) rotate(45deg);
	}

	@media (hover: hover) and (pointer: fine) {
		.contact-social__link:hover .contact-social__arrow {
			transform: translateX(-6px) rotate(45deg);
		}
	}

	@media (hover: none), (pointer: coarse) {
		.contact-social__link:active .contact-social__arrow {
			transform: translateX(-6px) rotate(45deg);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.contact-email-cta:focus-visible,
		.contact-email-cta.is-hovering {
			background-color: #ffffff;
		}

		.contact-email-cta:focus-visible .contact-email-cta__label-line--default,
		.contact-email-cta.is-hovering .contact-email-cta__label-line--default {
			color: #18191b;
		}

		.contact-email-cta:focus-visible .contact-email-cta__roll-inner,
		.contact-email-cta.is-hovering .contact-email-cta__roll-inner {
			transform: none;
		}

		.contact-email-cta:focus-visible .contact-email-cta__arrow,
		.contact-email-cta.is-hovering .contact-email-cta__arrow {
			filter: none;
		}

		@media (hover: hover) and (pointer: fine) {
			.contact-email-cta:hover {
				background-color: #ffffff;
			}

			.contact-email-cta:hover .contact-email-cta__label-line--default {
				color: #18191b;
			}

			.contact-email-cta:hover .contact-email-cta__roll-inner {
				transform: none;
			}

			.contact-email-cta:hover .contact-email-cta__arrow {
				filter: none;
			}
		}

		@media (hover: none), (pointer: coarse) {
			.contact-email-cta:active {
				background-color: #ffffff;
			}

			.contact-email-cta:active .contact-email-cta__label-line--default {
				color: #18191b;
			}

			.contact-email-cta:active .contact-email-cta__roll-inner {
				transform: none;
			}

			.contact-email-cta:active .contact-email-cta__arrow {
				filter: none;
			}
		}
	}
</style>

<script>
	function wrapLetters(element: HTMLElement) {
		const text = element.textContent ?? '';
		element.textContent = '';

		for (const char of text) {
			const span = document.createElement('span');
			span.className = 'reveal-char';
			span.textContent = char === ' ' ? ' ' : char;
			element.appendChild(span);
		}
	}

	function updateContactHeadingReveal() {
		const heading = document.getElementById('contact-heading');
		if (!heading) return;

		const chars = heading.querySelectorAll('.reveal-char');
		if (!chars.length) return;

		const rect = heading.getBoundingClientRect();
		const viewportHeight = window.innerHeight;
		const startLine = viewportHeight * 0.88;
		const endLine = viewportHeight * 0.45;
		const range = startLine - endLine;
		const progress = Math.min(1, Math.max(0, (startLine - rect.top) / range));
		const activeCount = Math.ceil(progress * chars.length);

		chars.forEach((char, index) => {
			char.classList.toggle('active', index < activeCount);
		});
	}

	let scrollTicking = false;

	function onContactScroll() {
		if (scrollTicking) return;
		scrollTicking = true;
		requestAnimationFrame(() => {
			updateContactHeadingReveal();
			scrollTicking = false;
		});
	}

	function initContactHeadingReveal() {
		const heading = document.getElementById('contact-heading');
		if (!heading) return;

		if (heading.dataset.revealInit !== 'true') {
			heading.dataset.revealInit = 'true';

			heading.querySelectorAll('[data-reveal-line]').forEach((line) => {
				wrapLetters(line as HTMLElement);
			});

			window.addEventListener('scroll', onContactScroll, { passive: true });
			window.addEventListener('resize', updateContactHeadingReveal, { passive: true });
		}

		updateContactHeadingReveal();
	}

	function initContactEmailButton() {
		const section = document.getElementById('contact');
		const button = document.getElementById('contact-email-cta');

		if (!section || !button || button.dataset.emailInit === 'true') return;

		button.dataset.emailInit = 'true';

		const MAX_MOVE = 10;

		function onSectionMove(event: MouseEvent) {
			if (window.matchMedia('(hover: none), (pointer: coarse)').matches) {
				return;
			}

			const rect = button.getBoundingClientRect();
			const centerX = rect.left + rect.width / 2;
			const centerY = rect.top + rect.height / 2;
			const deltaX = event.clientX - centerX;
			const deltaY = event.clientY - centerY;
			const moveX = Math.max(-MAX_MOVE, Math.min(MAX_MOVE, deltaX * 0.075));
			const moveY = Math.max(-MAX_MOVE, Math.min(MAX_MOVE, deltaY * 0.075));

			const isHovering =
				event.clientX >= rect.left &&
				event.clientX <= rect.right &&
				event.clientY >= rect.top &&
				event.clientY <= rect.bottom;

			button.classList.toggle('is-hovering', isHovering);

			const scale = isHovering ? 1.02 : 1;
			button.style.transform = `translate3d(${moveX}px, ${moveY}px, 0) scale(${scale})`;
		}

		function onSectionLeave() {
			button.classList.remove('is-hovering');
			button.style.transform = 'translate3d(0, 0, 0) scale(1)';
		}

		function onPressStart() {
			if (!window.matchMedia('(hover: none), (pointer: coarse)').matches) return;
			button.classList.add('is-hovering');
		}

		function onPressEnd() {
			if (!window.matchMedia('(hover: none), (pointer: coarse)').matches) return;
			button.classList.remove('is-hovering');
		}

		section.addEventListener('mousemove', onSectionMove, { passive: true });
		section.addEventListener('mouseleave', onSectionLeave, { passive: true });
		button.addEventListener('pointerdown', onPressStart);
		button.addEventListener('pointerup', onPressEnd);
		button.addEventListener('pointercancel', onPressEnd);
		button.addEventListener('pointerleave', onPressEnd);
	}

	function bootContactSection() {
		initContactHeadingReveal();
		initContactEmailButton();

		const section = document.getElementById('contact');
		if (!section || section.dataset.revealObserved === 'true') return;

		section.dataset.revealObserved = 'true';

		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) updateContactHeadingReveal();
				}
			},
			{ threshold: [0, 0.25, 0.5, 0.75, 1] },
		);

		observer.observe(section);
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', bootContactSection, { once: true });
	} else {
		bootContactSection();
	}

	document.addEventListener('astro:page-load', bootContactSection);
</script>
