---
import WorkWithUsButton from './WorkWithUsButton.astro';
import { FOUNDERS_PHOTO_ALTS } from '../utils/projectImageAlt';
---

<section id="about" class="about-section relative z-20 bg-[#131415]">
	<div id="about-visual" class="about-visual relative overflow-hidden">
		<div id="about-parallax-layer" class="about-parallax__layer pointer-events-none">
			<div class="about-parallax__shift">
				<img
					src="/images/brothers-intro.webp"
					alt={FOUNDERS_PHOTO_ALTS.en}
					width="2400"
					height="1604"
					class="about-parallax__image h-full w-full object-cover grayscale"
					loading="lazy"
					decoding="async"
					fetchpriority="low"
					data-alts={JSON.stringify(FOUNDERS_PHOTO_ALTS)}
				/>
			</div>
		</div>

		<canvas
			id="about-noise-filter"
			class="pointer-events-none absolute inset-0 z-[2] block h-full w-full bg-transparent"
			aria-hidden="true"
		></canvas>

		<div
			class="about-visual__overlay pointer-events-none absolute inset-0 z-[1] bg-[#131415]/10"
			aria-hidden="true"
		></div>

		<div
			class="about-visual__content relative z-10 flex h-[420px] flex-col justify-end gap-6 px-[var(--page-gutter)] pb-10 pt-20 md:grid md:h-[600px] md:grid-cols-2 md:items-end md:gap-16 md:pb-16 md:pt-24"
		>
			<p class="about-visual__eyebrow text-subtitle-1" data-i18n="about.eyebrow">Our story</p>
			<p
				class="body-txt-1 about-visual__intro max-w-md leading-relaxed text-white md:ml-auto"
				data-i18n="about.intro"
			>
				We are two brothers who turned a shared passion into a studio dedicated to quality. We
				combine years of global experience to build digital products that truly last.
			</p>
		</div>
	</div>

	<div
		id="about-content"
		class="about-content relative z-10 grid min-w-0 gap-6 bg-[#131415] px-[var(--page-gutter)] py-[var(--section-padding-y)] md:grid-cols-2 md:gap-20"
	>
		<h2 id="about-heading" class="about-content__heading min-w-0 w-full max-w-full uppercase leading-[1.15] md:max-w-lg">
			<span data-reveal-line data-i18n="about.heading">
				We believe that a great brand is built on two things – a clear vision and a solid foundation.
			</span>
		</h2>

		<div class="body-txt-1 about-content__body min-w-0 md:pt-2">
			<div class="space-y-6 leading-relaxed text-setin-muted">
				<p data-i18n="about.body1">
					In our studio, we create digital spaces that tell your story. With 15 years of combined
					experience, we've worked with brands from Poland to the LatAm, helping them stand out.
				</p>
				<p data-i18n="about.body2">
					Our work is a mix of two worlds. We look at the human side of your business to understand
					your goals, and then we use high-end technology to make them real. Because we are
					brothers, we work as one. This means your project is always consistent, from the first
					sketch to the final line of code. We are here to help you grow and leave a mark on the
					digital world.
				</p>
			</div>

			<div class="mt-12">
				<WorkWithUsButton href="/about" label="Read more about us" i18nKey="about.readMore" />
			</div>
		</div>
	</div>
</section>

<style is:global>
	.about-visual {
		height: 420px;
	}

	@media (min-width: 768px) {
		.about-visual {
			height: 600px;
		}
	}

	.about-parallax__layer {
		position: absolute;
		inset: 0;
		overflow: hidden;
		transform: translateZ(0);
	}

	.about-parallax__layer.is-hidden {
		opacity: 0;
		visibility: hidden;
	}

	/* Mobile fixed stage: full viewport, clipped to the about-visual window. */
	.about-parallax__layer.is-fixed {
		position: fixed;
		inset: auto;
		top: 0;
		left: 0;
		z-index: 0;
		width: 100%;
		height: 100%;
		height: 100svh;
	}

	.about-parallax__shift {
		position: absolute;
		inset: 0;
		height: 100%;
		width: 100%;
		overflow: hidden;
		transform: translate3d(0, 0, 0);
		backface-visibility: hidden;
	}

	.about-parallax__image {
		height: 100%;
		width: 100%;
		object-fit: cover;
		object-position: center 42%;
		backface-visibility: hidden;
	}

	/* Desktop: parallax lag. Mobile: fixed bg, no motion. */
	@media (min-width: 768px) {
		.about-parallax__shift {
			will-change: transform;
		}

		.about-parallax__image {
			transform: scale(1.24) translateZ(0);
			transform-origin: center 42%;
		}
	}

	@media (max-width: 767px) {
		.about-parallax__image {
			object-position: center 36%;
			transform: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.about-parallax__layer.is-fixed {
			position: absolute;
			inset: 0;
			width: auto;
			height: auto;
			clip-path: none;
		}

		.about-parallax__shift {
			transform: translate3d(0, 0, 0) !important;
			will-change: auto;
		}

		.about-parallax__image {
			transform: scale(1.05) translateZ(0);
		}

		@media (max-width: 767px) {
			.about-parallax__image {
				transform: none;
			}
		}
	}

	.about-visual__eyebrow {
		font-family: "Fustat", ui-sans-serif, system-ui, sans-serif;
		font-weight: 600;
		line-height: 1.2;
		text-transform: uppercase;
		color: #ffffff;
	}

	.about-visual__intro {
		color: #ffffff;
	}

	.about-content__heading {
		overflow-wrap: break-word;
		line-height: 1.15;
		max-width: 100%;
	}

	@media (max-width: 767px) {
		#about-heading [data-reveal-line] {
			white-space: normal;
		}
	}

	.about-content__body {
		max-width: 100%;
		overflow-wrap: break-word;
	}

	#about-heading .reveal-char {
		color: rgba(255, 255, 255, 0.15);
		transition: color 0.35s ease-out;
	}

	#about-heading .reveal-char.active {
		color: rgba(255, 255, 255, 1);
	}
</style>

<script>
	import { initCinemaPureNoise } from '../scripts/initCinemaPureNoise.ts';
	import { getLenis } from '../scripts/initSmoothScroll.ts';
	import { initScrollLetterReveal } from '../scripts/initScrollLetterReveal.ts';

	function initAboutParallax() {
		const visual = document.getElementById('about-visual');
		const layer = document.getElementById('about-parallax-layer');
		if (!visual || !layer || visual.dataset.parallaxInit === 'true') return;

		visual.dataset.parallaxInit = 'true';

		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const mobileQuery = window.matchMedia('(max-width: 767px)');
		const shift = layer.querySelector<HTMLElement>('.about-parallax__shift');
		if (!shift) return;

		const TRAVEL = 0.12;
		const LERP = 0.22;

		let target = 0;
		let current = 0;
		let rafId = 0;
		let parallaxRunning = false;

		const clearFixedStage = () => {
			layer.classList.remove('is-fixed', 'is-hidden');
			layer.style.clipPath = '';
			shift.style.transform = 'translate3d(0, 0, 0)';
		};

		const syncFixedStage = () => {
			const rect = visual.getBoundingClientRect();
			const vh = window.innerHeight;
			const vw = window.innerWidth;
			const visible = rect.bottom > 0 && rect.top < vh;

			if (!visible) {
				layer.classList.add('is-hidden');
				layer.classList.remove('is-fixed');
				layer.style.clipPath = '';
				return;
			}

			layer.classList.add('is-fixed');
			layer.classList.remove('is-hidden');
			const top = Math.max(0, rect.top);
			const bottom = Math.min(vh, rect.bottom);
			layer.style.clipPath = `inset(${top}px ${Math.max(0, vw - rect.right)}px ${Math.max(0, vh - bottom)}px ${Math.max(0, rect.left)}px)`;
			shift.style.transform = 'translate3d(0, 0, 0)';
		};

		const readTarget = () => {
			const rect = visual.getBoundingClientRect();
			const vh = window.innerHeight;
			const start = vh;
			const end = -rect.height;
			const range = start - end;
			const progress =
				range === 0 ? 0 : Math.min(1, Math.max(0, (start - rect.top) / range));
			const max = rect.height * TRAVEL;
			target = -max + progress * (2 * max);
		};

		const tick = () => {
			if (!parallaxRunning) return;
			current += (target - current) * LERP;
			if (Math.abs(target - current) < 0.05) current = target;
			shift.style.transform = `translate3d(0, ${current}px, 0)`;
			rafId = requestAnimationFrame(tick);
		};

		const stopParallax = () => {
			parallaxRunning = false;
			cancelAnimationFrame(rafId);
			rafId = 0;
		};

		const startParallax = () => {
			if (reduceMotion || parallaxRunning) return;
			parallaxRunning = true;
			readTarget();
			current = target;
			rafId = requestAnimationFrame(tick);
		};

		const onScroll = () => {
			if (mobileQuery.matches) {
				if (!reduceMotion) syncFixedStage();
				return;
			}
			readTarget();
		};

		const applyMode = () => {
			stopParallax();
			if (mobileQuery.matches) {
				if (reduceMotion) {
					clearFixedStage();
				} else {
					syncFixedStage();
				}
				return;
			}
			clearFixedStage();
			startParallax();
		};

		applyMode();
		window.addEventListener('scroll', onScroll, { passive: true });
		getLenis()?.on('scroll', onScroll);
		mobileQuery.addEventListener('change', applyMode);
		window.addEventListener('resize', applyMode, { passive: true });

		document.addEventListener(
			'astro:before-preparation',
			() => {
				stopParallax();
				clearFixedStage();
			},
			{ once: true },
		);
	}

	function initAboutSection() {
		initScrollLetterReveal('about-heading');
		initAboutParallax();
		initCinemaPureNoise('about-noise-filter', { observeElementId: 'about-visual' });
	}

	document.addEventListener('astro:page-load', initAboutSection);
</script>
