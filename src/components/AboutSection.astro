---
import WorkWithUsButton from './WorkWithUsButton.astro';
import { FOUNDERS_PHOTO_ALTS } from '../utils/projectImageAlt';
import { withPublicAssetVersion } from '../utils/withPublicAssetVersion.ts';

const foundersSrc = withPublicAssetVersion('/images/brothers-intro.webp');
const foundersSrc1280 = withPublicAssetVersion('/images/brothers-intro-1280.webp');
---

<section id="about" class="about-section relative z-20 bg-[#131415]">
	<div id="about-visual" class="about-visual bg-parallax relative overflow-hidden bg-[#131415]">
		<div id="about-parallax-layer" class="about-parallax__layer pointer-events-none">
			{/*
			  Mobile Safari often defers off-screen <img> decode. CSS background on the
			  shift layer starts fetching at parse time and avoids the black pop-in.
			*/}
			<div
				class="about-parallax__shift bg-parallax__shift about-parallax__shift--photo"
				style={`--founders-photo-mobile: url('${foundersSrc1280}'); --founders-photo-desktop: url('${foundersSrc}');`}
				data-founders-bg
			>
				<picture>
					<source media="(min-width: 768px)" srcset={foundersSrc} width="1920" height="1284" />
					<img
						src={foundersSrc1280}
						alt={FOUNDERS_PHOTO_ALTS.en}
						width="1280"
						height="856"
						class="about-parallax__image bg-parallax__media"
						loading="eager"
						decoding="async"
						fetchpriority="auto"
						data-founders-photo
						data-alts={JSON.stringify(FOUNDERS_PHOTO_ALTS)}
					/>
				</picture>
			</div>
		</div>

		<canvas
			id="about-noise-filter"
			class="pointer-events-none absolute inset-0 z-[2] block h-full w-full bg-transparent"
			aria-hidden="true"
		></canvas>

		<div
			class="about-visual__overlay pointer-events-none absolute inset-0 z-[1] bg-[#131415]/10"
			aria-hidden="true"
		></div>

		<div
			class="about-visual__content relative z-10 flex h-[420px] flex-col justify-end gap-6 px-[var(--page-gutter)] pb-10 pt-20 md:grid md:h-[600px] md:grid-cols-2 md:items-end md:gap-16 md:pb-16 md:pt-24"
		>
			<p class="about-visual__eyebrow text-subtitle-1" data-i18n="about.eyebrow">Our story</p>
			<p
				class="body-txt-1 about-visual__intro max-w-md leading-relaxed text-white md:ml-auto"
				data-i18n="about.intro"
			>
				We are two brothers who turned a shared passion into a studio dedicated to quality. We
				combine years of global experience to build digital products that truly last.
			</p>
		</div>
	</div>

	<div
		id="about-content"
		class="about-content relative z-10 grid min-w-0 gap-6 bg-[#131415] px-[var(--page-gutter)] py-[var(--section-padding-y)] md:grid-cols-2 md:gap-20"
	>
		<h2 id="about-heading" class="about-content__heading min-w-0 w-full max-w-full uppercase leading-[1.15] md:max-w-lg">
			<span data-reveal-line data-i18n="about.heading">
				We believe that a great brand is built on two things – a clear vision and a solid foundation.
			</span>
		</h2>

		<div class="body-txt-1 about-content__body min-w-0 md:pt-2">
			<div class="space-y-6 leading-relaxed text-setin-muted">
				<p data-i18n="about.body1">
					In our studio, we create digital spaces that tell your story. With 15 years of combined
					experience, we've worked with brands from Poland to the LatAm, helping them stand out.
				</p>
				<p data-i18n="about.body2">
					Our work is a mix of two worlds. We look at the human side of your business to understand
					your goals, and then we use high-end technology to make them real. Because we are
					brothers, we work as one. This means your project is always consistent, from the first
					sketch to the final line of code. We are here to help you grow and leave a mark on the
					digital world.
				</p>
			</div>

			<div class="mt-12">
				<WorkWithUsButton href="/about" label="Read more about us" i18nKey="about.readMore" />
			</div>
		</div>
	</div>
</section>

<style is:global>
	.about-visual {
		height: 420px;
	}

	@media (min-width: 768px) {
		.about-visual {
			height: 600px;
		}
	}

	.about-parallax__layer {
		position: absolute;
		inset: 0;
		overflow: hidden;
		transform: translateZ(0);
	}

	.about-parallax__shift--photo {
		background-color: #131415;
		background-repeat: no-repeat;
		background-size: cover;
		filter: grayscale(1);
	}

	.about-parallax__shift--photo picture,
	.about-parallax__image {
		display: block;
		height: 100%;
		width: 100%;
	}

	.about-parallax__image {
		object-fit: cover;
		object-position: center 42%;
		backface-visibility: hidden;
		transform: translateZ(0);
	}

	/* Mobile: paint via CSS background (preloaded 1280). Keep <img> for alt text only. */
	@media (max-width: 767px) {
		.about-parallax__shift--photo {
			background-image: var(--founders-photo-mobile);
			background-position: center 36%;
		}

		.about-parallax__image {
			opacity: 0;
			object-position: center 36%;
		}
	}

	/* Desktop: scale bleed; crop toward faces. */
	@media (min-width: 768px) {
		.about-parallax__shift--photo {
			background-image: var(--founders-photo-desktop);
			background-position: center 28%;
			background-size: 124%;
		}

		.about-parallax__image {
			object-position: center 28%;
			transform: scale(1.24) translateZ(0);
			transform-origin: center 28%;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.about-parallax__image {
			transform: scale(1.05) translateZ(0);
		}

		@media (max-width: 767px) {
			.about-parallax__image {
				transform: translateZ(0);
			}
		}

		@media (min-width: 768px) {
			.about-parallax__shift--photo {
				background-size: cover;
			}
		}
	}

	.about-visual__eyebrow {
		font-family: "Fustat", ui-sans-serif, system-ui, sans-serif;
		font-weight: 600;
		line-height: 1.2;
		text-transform: uppercase;
		color: #ffffff;
	}

	.about-visual__intro {
		color: #ffffff;
	}

	.about-content__heading {
		overflow-wrap: break-word;
		line-height: 1.15;
		max-width: 100%;
	}

	@media (max-width: 767px) {
		#about-heading [data-reveal-line] {
			white-space: normal;
		}
	}

	.about-content__body {
		max-width: 100%;
		overflow-wrap: break-word;
	}

	#about-heading .reveal-char {
		color: rgba(255, 255, 255, 0.15);
		transition: color 0.35s ease-out;
	}

	#about-heading .reveal-char.active {
		color: rgba(255, 255, 255, 1);
	}
</style>

<script>
	import { initBgParallax } from '../scripts/initBgParallax.ts';
	import { initCinemaPureNoise } from '../scripts/initCinemaPureNoise.ts';
	import { initScrollLetterReveal } from '../scripts/initScrollLetterReveal.ts';

	function foundersPhotoUrl(): string {
		const img = document.querySelector<HTMLImageElement>('[data-founders-photo]');
		const shift = document.querySelector<HTMLElement>('[data-founders-bg]');
		const mobile = window.matchMedia('(max-width: 767px)').matches;
		if (mobile) {
			const fromCss = shift
				? getComputedStyle(shift).getPropertyValue('--founders-photo-mobile')
				: '';
			const match = fromCss.match(/url\(['"]?(.+?)['"]?\)/);
			if (match?.[1]) return match[1];
		}
		return img?.currentSrc || img?.src || '';
	}

	/** Force-decode the exact mobile/desktop URL before the section is reached. */
	function warmFoundersPhoto() {
		const url = foundersPhotoUrl();
		if (!url) return;

		const probe = new Image();
		probe.decoding = 'async';
		probe.src = url;
		const finish = () => {
			if (typeof probe.decode === 'function') {
				void probe.decode().catch(() => undefined);
			}
		};
		if (probe.complete) finish();
		else probe.addEventListener('load', finish, { once: true });
	}

	function initAboutParallax() {
		const visual = document.getElementById('about-visual');
		const shift = visual?.querySelector<HTMLElement>('.about-parallax__shift');
		if (!visual || !shift) return;

		initBgParallax({ root: visual, visual, shift });
	}

	function initAboutSection() {
		warmFoundersPhoto();
		initScrollLetterReveal('about-heading');
		initAboutParallax();
		initCinemaPureNoise('about-noise-filter', { observeElementId: 'about-visual' });
	}

	initAboutSection();
	window.addEventListener('intro-complete', warmFoundersPhoto, { once: true });
	document.addEventListener('astro:page-load', initAboutSection);
</script>
