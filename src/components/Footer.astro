---
import { getCollection } from 'astro:content';
import RollingLink from './RollingLink.astro';
import { t, type Locale } from '../i18n/dictionaries.ts';
import { buildLocalePath, stripLocalePrefix } from '../i18n/seo.ts';
import { isActiveNavHref, normalizeNavPath } from '../utils/isActiveNavHref.ts';

interface Props {
	/** When set, render chrome copy + links in this locale (pitch pages). */
	locale?: Locale;
}

const { locale = 'en' } = Astro.props;

const emailHref = 'mailto:wearesetinstudio@gmail.com?subject=Hello%20Setin!%20:)';
const whatsappHref =
	'https://api.whatsapp.com/message/IDQVMTROBPOXM1?autoload=1&app_absent=0';
const whatsappDisplay = '+507 6628 65 24';

const originPathname =
	typeof Astro.originPathname === 'string' && Astro.originPathname
		? Astro.originPathname
		: Astro.url.pathname;
const barePath = normalizeNavPath(stripLocalePrefix(originPathname));

const localeHref = (href: string) => {
	if (locale === 'en') return href;
	if (href.startsWith('#') || href.startsWith('mailto:') || /^https?:/i.test(href)) return href;
	const url = new URL(href, 'https://wearesetin.com');
	return `${buildLocalePath(locale, url.pathname)}${url.search}${url.hash}`;
};

const sitemapLinks = [
	{ href: '/projects', label: t(locale, 'nav.projects'), i18nKey: 'nav.projects' },
	{ href: '/services', label: t(locale, 'nav.services'), i18nKey: 'nav.services' },
	{ href: '/about', label: t(locale, 'nav.about'), i18nKey: 'nav.about' },
	{ href: '/articles', label: t(locale, 'nav.articles'), i18nKey: 'nav.articles' },
	{ href: '#contact', label: t(locale, 'footer.contact'), i18nKey: 'footer.contact' },
];

const serviceLinks = [
	{
		href: '/services#service-01',
		label: t(locale, 'services.item.branding.label'),
		i18nKey: 'services.item.branding.label',
	},
	{
		href: '/services#service-02',
		label: t(locale, 'services.item.product.label'),
		i18nKey: 'services.item.product.label',
	},
	{
		href: '/services#service-03',
		label: t(locale, 'services.item.automation.label'),
		i18nKey: 'services.item.automation.label',
	},
	{
		href: '/services#service-04',
		label: t(locale, 'services.item.development.label'),
		i18nKey: 'services.item.development.label',
	},
];

const locations = [
	{ label: 'Szczecin, PL', timezone: 'Europe/Warsaw' },
	{ label: 'Valencia, ES', timezone: 'Europe/Madrid' },
	{ label: 'Panama, PA', timezone: 'America/Panama' },
];

const allProjects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const projects = allProjects.filter((project) => !project.data.comingSoon).slice(0, 4);
const projectCount = allProjects.length;

function formatLocationTime(timeZone: string, date = new Date()) {
	return new Intl.DateTimeFormat('en-US', {
		hour: 'numeric',
		minute: '2-digit',
		second: '2-digit',
		hour12: true,
		timeZone,
	})
		.format(date)
		.toUpperCase();
}
---

<footer class="site-footer relative z-20 bg-[#0f1011]">
	<div class="relative z-[1] px-[var(--page-gutter)] py-[var(--band-padding-y)]">
		<div class="site-footer__nav grid grid-cols-2 gap-x-6 gap-y-10 pb-14 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8 lg:pb-16">
			<div class="site-footer__col">
				<p class="site-footer__col-label" data-i18n="footer.sitemap">{t(locale, 'footer.sitemap')}</p>
				<ul class="site-footer__list">
					{
						sitemapLinks.map((link) => (
							<li>
								<RollingLink
									href={localeHref(link.href)}
									label={link.label}
									i18nKey={link.i18nKey}
									variant="footer"
									current={isActiveNavHref(link.href, barePath)}
								/>
							</li>
						))
					}
				</ul>
			</div>

			<div class="site-footer__col">
				<p class="site-footer__col-label" data-i18n="footer.services">{t(locale, 'footer.services')}</p>
				<ul class="site-footer__list">
					{
						serviceLinks.map((link) => (
							<li>
								<RollingLink
									href={localeHref(link.href)}
									label={link.label}
									i18nKey={link.i18nKey}
									variant="footer"
									markCurrent={false}
								/>
							</li>
						))
					}
				</ul>
			</div>

			<div class="site-footer__col">
				<p class="site-footer__col-label" data-i18n="footer.projects">{t(locale, 'footer.projects')}</p>
				<ul class="site-footer__list">
					{
						projects.map((project) => (
							<li>
								<RollingLink
									href={localeHref(`/projects/${project.id}`)}
									label={project.data.title}
									variant="footer"
									current={isActiveNavHref(`/projects/${project.id}`, barePath)}
								/>
							</li>
						))
					}
					<li>
						<RollingLink
							href={localeHref('/projects')}
							label={t(locale, 'footer.all')}
							i18nKey="footer.all"
							variant="footer"
							underlined
							count={projectCount}
							current={barePath === '/projects'}
							exact
						/>
					</li>
				</ul>
			</div>

			<div class="site-footer__col col-span-2 sm:col-span-1">
				<div class="site-footer__contact-block">
					<p class="site-footer__col-label" data-i18n="footer.email">{t(locale, 'footer.email')}</p>
					<RollingLink
						href={emailHref}
						label="wearesetinstudio@gmail.com"
						variant="footer"
						underlined
					/>
				</div>
				<div class="site-footer__contact-block mt-8">
					<p class="site-footer__col-label" data-i18n="footer.whatsapp">{t(locale, 'footer.whatsapp')}</p>
					<RollingLink
						href={whatsappHref}
						label={whatsappDisplay}
						variant="footer"
						underlined
						external
					/>
				</div>
			</div>
		</div>

		<div class="site-footer__bottom flex flex-col gap-6 border-t border-white/10 pt-8 md:flex-row md:items-end md:justify-between md:gap-10">
			<div class="flex items-center gap-3">
				<img
					src="/logo-sygnet.svg"
					alt=""
					width="28"
					height="26"
					class="footer-brand h-auto w-7"
					aria-hidden="true"
				/>
				<span class="footer-copyright text-[0.75rem] uppercase tracking-[0.04em] text-setin-muted md:text-[0.8rem]">
					&copy; {new Date().getFullYear()}{' '}
					<span data-i18n="footer.rights">{t(locale, 'footer.rights')}</span>
				</span>
			</div>

			<div class="footer-locations flex flex-wrap items-start gap-x-0 gap-y-4">
				{
					locations.map((location, index) => (
						<div class="footer-location flex items-stretch">
							{index > 0 ? <span class="footer-location__rule" aria-hidden="true" /> : null}
							<div class="footer-location__content flex min-w-0 flex-col gap-1">
								<span class="footer-location__label text-[0.75rem] uppercase tracking-[0.04em] text-setin-muted md:text-[0.8rem]">
									{location.label}
								</span>
								<time
									class="footer-location__time text-[0.75rem] uppercase tracking-[0.04em] text-setin-muted tabular-nums md:text-[0.8rem]"
									datetime={new Date().toISOString()}
									data-timezone={location.timezone}
								>
									{formatLocationTime(location.timezone)}
								</time>
							</div>
						</div>
					))
				}
			</div>
		</div>
	</div>
</footer>

<style is:global>
	.site-footer {
		background-color: #0f1011;
	}

	.site-footer__col-label,
	.site-footer__link,
	.site-footer__link-line,
	.footer-copyright,
	.footer-location__label,
	.footer-location__time {
		letter-spacing: var(--letter-spacing-ui);
	}

	.site-footer__col-label {
		margin: 0 0 1rem;
		font-size: 0.8rem;
		font-weight: 500;
		line-height: 1.2;
		text-transform: uppercase;
		color: rgba(245, 245, 245, 0.45);
	}

	.site-footer__list {
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.site-footer__link {
		display: inline-flex;
		max-width: 100%;
		color: #f5f5f5;
		text-decoration: none;
		padding-bottom: 0.2em;
	}

	.site-footer__link--underlined {
		text-decoration: none;
	}

	.site-footer__link-line {
		max-width: 100%;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		letter-spacing: var(--letter-spacing-ui);
	}

	.footer-location__rule {
		display: block;
		width: 1px;
		align-self: stretch;
		margin-inline: 1.25rem;
		background: rgba(245, 245, 245, 0.2);
	}

	@media (max-width: 767px) {
		.site-footer__link-line {
			font-size: 0.85rem;
		}

		.footer-location__rule {
			margin-inline: 0.85rem;
		}
	}
</style>

<script>
	let footerClockInterval: ReturnType<typeof window.setInterval> | null = null;

	function initFooterLocationTimes() {
		if (footerClockInterval !== null) {
			window.clearInterval(footerClockInterval);
			footerClockInterval = null;
		}

		const clocks = document.querySelectorAll<HTMLTimeElement>('.footer-location__time');
		if (!clocks.length) return;

		const formatterCache = new Map<string, Intl.DateTimeFormat>();

		function getFormatter(timeZone: string) {
			let formatter = formatterCache.get(timeZone);
			if (!formatter) {
				formatter = new Intl.DateTimeFormat('en-US', {
					hour: 'numeric',
					minute: '2-digit',
					second: '2-digit',
					hour12: true,
					timeZone,
				});
				formatterCache.set(timeZone, formatter);
			}
			return formatter;
		}

		function updateClocks() {
			const now = new Date();

			clocks.forEach((clock) => {
				const timeZone = clock.dataset.timezone;
				if (!timeZone) return;

				clock.textContent = getFormatter(timeZone).format(now).toUpperCase();
				clock.dateTime = now.toISOString();
			});
		}

		updateClocks();
		footerClockInterval = window.setInterval(updateClocks, 1000);
	}

	initFooterLocationTimes();
	document.addEventListener('astro:page-load', initFooterLocationTimes);
</script>
